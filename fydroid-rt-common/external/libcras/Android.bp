// CRAS client library built from Chrome OS source (protocol v7).
// Replaces AOSP external/adhd/cras/src libcras (protocol v5) which is
// incompatible with the CRAS server running on our target devices.
cc_library_static {
    name: "libcras_fydroid",

    srcs: [
        "common/cras_audio_format.c",
        "common/cras_config.c",
        "common/cras_string.c",
        "common/cras_file_wait.c",
        "common/cras_shm.c",
        "common/cras_util.c",
        "common/edid_utils.c",
        "libcras/cras_client.c",
        "libcras/cras_helpers.c",
    ],

    // Include search paths (order matters):
    // 1. "include" — public CRAS headers (cras_client.h, cras_types.h, etc.)
    // 2. "common" — internal common headers (cras_file_wait.h, cras_string.h, etc.)
    // 3. "." — for "cras/common/check.h", "cras/src/common/*", "third_party/strlcpy/*"
    local_include_dirs: [
        "include",
        "common",
        ".",
    ],

    export_include_dirs: [
        "include",
        "common",
    ],

    shared_libs: [
        "libcutils",
        "libtinyalsa",
    ],

    cflags: [
        "-DCRAS_SOCKET_FILE_DIR=\"/var/run/cras\"",
        "-Wall",
        "-Wno-error=missing-field-initializers",
        "-Wno-sign-compare",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-missing-braces",
    ],

    vendor: true,
}
