+static int vmwgfx_bo_release(struct bo *bo)
+{
+	struct vmwgfx_bo *priv = bo->priv;
+
+	if (!priv)
+		return 0;
+	for (uint32_t i = 0; i < priv->surface_refs; i++)
+		unref_surface(bo->drv, bo->handle.u32);
+	if (priv->buffer_handle)
+		drv_gem_close(bo->drv, priv->buffer_handle);
+	free(priv);
+	bo->priv = NULL;
+	return 0;
+}
+
 /*
- * Release a bo by closing its GEM handle. This works for both locally
- * created GB surfaces (DRM_VMW_GB_SURFACE_CREATE registers the handle via
- * drm_gem_handle_create — see vmwgfx_surface.c:1751) and PRIME-imported
- * buffers (drv_prime_bo_import uses DRM_IOCTL_PRIME_FD_TO_HANDLE which
- * yields a GEM handle). DRM_VMW_UNREF_DMABUF — which the original code
- * called for every bo — fails with -EINVAL on surface IDs and on
- * PRIME-imported handles, leaving kernel-side bo references leaked and
- * triggering BufferQueueProducer "slot is not owned by the producer
- * (state = FREE)" errors when MediaCodec releases decoded frames into
- * SurfaceFlinger.
+ * Called once per handle. A surface is paid back per bo in
+ * vmwgfx_bo_release(); GEM_CLOSE would fail on it with -EINVAL. Only a plain
+ * GEM buffer is closed here.
  */
+static int vmwgfx_bo_destroy(struct bo *bo)
+{
+	if (is_surface_handle(bo->handle.u32))
+		return 0;
+	return drv_gem_bo_destroy(bo);
+}
 
