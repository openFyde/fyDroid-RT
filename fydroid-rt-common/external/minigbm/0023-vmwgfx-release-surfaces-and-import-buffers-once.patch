+static void unref_surface(struct driver *drv, uint32_t handle)
+{
+	struct drm_vmw_surface_arg arg = { .sid = (int32_t)handle };
+
+	if (drmCommandWrite(drv->fd, DRM_VMW_UNREF_SURFACE, &arg, sizeof(arg)))
+		drv_loge("DRM_VMW_UNREF_SURFACE failed (handle=%u)\n", handle);
 }
 
