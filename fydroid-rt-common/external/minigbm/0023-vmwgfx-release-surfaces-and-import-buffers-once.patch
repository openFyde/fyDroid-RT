+static int vmwgfx_bo_import(struct bo *bo, struct drv_import_fd_data *data)
+{
+	union drm_vmw_gb_surface_reference_arg s_arg;
+	struct vmwgfx_bo *priv;
+	uint32_t imported = 0;
+	int ret;
+
+	for (size_t plane = 0; plane < bo->meta.num_planes; plane++) {
+		struct drm_prime_handle prime = { .fd = data->fds[plane] };
+
+		if (drmIoctl(bo->drv->fd, DRM_IOCTL_PRIME_FD_TO_HANDLE, &prime)) {
+			drv_loge("DRM_IOCTL_PRIME_FD_TO_HANDLE failed (fd=%d)\n", data->fds[plane]);
+			ret = -errno;
+			goto fail;
+		}
+		/* Every plane of a vmwgfx bo is the same object. */
+		if (imported && prime.handle != bo->handle.u32) {
+			if (is_surface_handle(prime.handle))
+				unref_surface(bo->drv, prime.handle);
+			else
+				drv_gem_close(bo->drv, prime.handle);
+			ret = -EINVAL;
+			goto fail;
+		}
+		bo->handle.u32 = prime.handle;
+		imported++;
+	}
+	bo->meta.tiling = data->tiling;
+
+	if (!is_surface_handle(bo->handle.u32))
+		return 0;	/* plain GEM: closed in bo_destroy, mapped via MAP_DUMB */
+
+	priv = calloc(1, sizeof(*priv));
+	if (!priv) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	priv->surface_refs = imported;
+	bo->priv = priv;
+
+	/* Look the backing buffer up once, for maps and CPU sync. */
+	memset(&s_arg, 0, sizeof(s_arg));
+	s_arg.req.sid = bo->handle.u32;
+	s_arg.req.handle_type = DRM_VMW_HANDLE_LEGACY;
+	if (drmCommandWriteRead(bo->drv->fd, DRM_VMW_GB_SURFACE_REF, &s_arg, sizeof(s_arg))) {
+		drv_loge("DRM_VMW_GB_SURFACE_REF failed (handle=%u); bo cannot be mapped\n",
+			 bo->handle.u32);
+		return 0;
+	}
+	priv->surface_refs++;
+	priv->buffer_handle = s_arg.rep.crep.buffer_handle;
+	priv->map_handle = s_arg.rep.crep.buffer_map_handle;
+	return 0;
+
+fail:
+	if (imported && is_surface_handle(bo->handle.u32)) {
+		for (uint32_t i = 0; i < imported; i++)
+			unref_surface(bo->drv, bo->handle.u32);
+	} else if (imported) {
+		drv_gem_close(bo->drv, bo->handle.u32);
+	}
+	return ret;
+}
