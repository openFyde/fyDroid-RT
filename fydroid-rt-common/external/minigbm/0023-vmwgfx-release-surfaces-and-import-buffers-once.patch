-static uint64_t get_map_handle(struct bo_metadata *meta) {
-  uint64_t map_handle = meta->map_info;
-  /*
-   * Recombine the halves stashed by store_map_handle(). This was '&', which
-   * is 0 for every possible input: the shifted high half has no low bits and
-   * blob_id is a uint32_t with no high bits. Every CPU map therefore mmap'd
-   * offset 0 instead of buffer_map_handle, so everything the CPU wrote - i.e.
-   * every frame out of a software video decoder - landed outside the SVGA
-   * surface. The GPU then sampled an untouched surface and composited the
-   * video as black, while the decoder, SurfaceFlinger and Chrome all reported
-   * perfectly healthy frames.
-   */
-  return (map_handle << 32) | meta->blob_id;
+/*
+ * What one bo owes the kernel. A surface reference is counted per drm_file,
+ * not per handle: each PRIME_FD_TO_HANDLE of a surface (one per plane) and each
+ * DRM_VMW_GB_SURFACE_REF adds one, and only DRM_VMW_UNREF_SURFACE drops one.
+ * GEM_CLOSE fails with -EINVAL on a surface handle, which is how every surface
+ * this backend created or imported used to leak, along with the GEM handle of
+ * its backing buffer. minigbm calls bo_destroy once per handle but bo_release
+ * once per bo, so all of this is paid back per bo in vmwgfx_bo_release().
+ * Ported from the host backend.
+ */
+struct vmwgfx_bo {
+	uint32_t surface_refs;	/* DRM_VMW_UNREF_SURFACE calls owed on bo->handle */
+	uint32_t buffer_handle;	/* GEM handle of the backing buffer, or 0 */
+	uint64_t map_handle;	/* mmap offset of the backing buffer, or 0 */
+};
