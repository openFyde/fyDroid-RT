+/*
+ * The kernel numbers TTM base objects -- every surface -- from
+ * VMWGFX_NUM_MOB + 1 and GEM objects -- plain buffers -- below that
+ * (ttm_object.c, idr_init_base), and vmw_prime_handle_to_fd() tells the two
