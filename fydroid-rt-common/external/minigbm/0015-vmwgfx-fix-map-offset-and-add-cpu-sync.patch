 /*
+ * CPU access synchronisation for guest-backed surfaces.
+ *
+ * A GB surface lives host-side and is backed by a guest MOB. Mapping the MOB
+ * and touching it is not enough on its own: the host has to be told when the
+ * CPU takes the buffer and when it gives it back, otherwise it never re-reads
+ * the MOB. Without this, everything a software video decoder writes stays
+ * invisible to the GPU, which keeps sampling stale contents and composites the
+ * video black — while the decoder, SurfaceFlinger and the compositor all report
+ * perfectly healthy frames. In the other direction, a CPU read of a
+ * GPU-rendered surface returns stale data.
+ *
+ * DRM_VMW_SYNCCPU operates on the *buffer* handle backing the surface, not the
+ * surface id, so resolve it with DRM_VMW_GB_SURFACE_REF first.
+ */
+static int vmwgfx_sync_cpu(struct bo *bo, struct mapping *mapping, bool grab)
+{
+	union drm_vmw_gb_surface_reference_arg s_arg;
+	struct drm_vmw_surface_arg *ref_req = &s_arg.req;
+	struct drm_vmw_gb_surface_ref_rep *ref_rep = &s_arg.rep;
+	struct drm_vmw_synccpu_arg arg;
+	uint32_t map_flags = mapping->vma->map_flags;
+	int ret;
+
+	memset(&s_arg, 0, sizeof(s_arg));
+	ref_req->sid = bo->handle.u32;
+	ref_req->handle_type = DRM_VMW_HANDLE_LEGACY;
+	ret = drmCommandWriteRead(bo->drv->fd, DRM_VMW_GB_SURFACE_REF, &s_arg, sizeof(s_arg));
+	if (ret) {
+		drv_loge("synccpu: GB_SURFACE_REF failed for sid %u: %d\n", bo->handle.u32, ret);
+		return ret;
+	}
+
+	memset(&arg, 0, sizeof(arg));
+	arg.op = grab ? drm_vmw_synccpu_grab : drm_vmw_synccpu_release;
+	arg.handle = ref_rep->crep.buffer_handle;
+	/* Mirror the mapping's access mode; default to read if unset. */
+	arg.flags = 0;
+	if (map_flags & BO_MAP_READ)
+		arg.flags |= drm_vmw_synccpu_read;
+	if (map_flags & BO_MAP_WRITE)
+		arg.flags |= drm_vmw_synccpu_write;
+	if (!arg.flags)
+		arg.flags = drm_vmw_synccpu_read;
+
+	ret = drmCommandWrite(bo->drv->fd, DRM_VMW_SYNCCPU, &arg, sizeof(arg));
+	if (ret)
+		drv_loge("DRM_VMW_SYNCCPU %s failed (buf %u, flags 0x%x): %d\n",
+			 grab ? "grab" : "release", arg.handle, (uint32_t)arg.flags, ret);
+	return ret;
+}
+
+/*
+ * Move surface contents between the host and the guest MOB.
+ *
+ * SYNCCPU only arbitrates access; it does not transfer anything. A guest-backed
+ * surface lives host-side and the MOB is just its backing store, so the host has
+ * to be told explicitly to pull contents up (UPDATE) or push them down
+ * (READBACK). Without the UPDATE the host keeps serving whatever it last
+ * realised, and a software decoder writing new frames into a rotating pool of
+ * buffers simply replays the first frame that landed in each one — playback
+ * circles through the opening frames forever, with a period equal to the pool
+ * depth (measured on device: 16 buffers, and SurfaceFlinger's composed output
+ * repeated with a period of exactly 16).
+ *
+ * These commands are only accepted for a surface the host actually has. They
+ * were rejected for every YUV buffer until drm_format_to_svga_format() stopped
+ * asking for a packed video format for what is really an 8-bit byte plane; the
+ * host refused DEFINE_GB_SURFACE, and every command naming that sid failed
+ * after it. Rejections are invisible from user space — the ioctl succeeds and
+ * the device fails the command buffer later — and each one costs a full
+ * command-buffer context preempt-and-restart in vmw_cmdbuf_work_func(), which
+ * stalls the entire guest's graphics command stream. So if this path ever
+ * regresses it is expensive as well as useless, and silent. To check:
+ *
+ *     echo 0x02 > /sys/module/drm/parameters/debug   # DRM_UT_DRIVER
+ *     dmesg | grep "causing device error"            # names the command
+ *
+ * Ordering is load-bearing: a write grab blocks all command submissions
+ * referencing the buffer, so bo_flush releases *before* submitting the update;
+ * bo_invalidate submits the readback *before* grabbing, since the grab idles the
+ * GPU on the buffer and so also waits for the readback to land.
+ *
+ * The command stream is a bare SVGA3dCmdHeader + body; no DX context is
+ * involved, hence context_handle = SVGA3D_INVALID_ID. The kernel treats the
+ * body's sid as a *user-space* surface handle and converts it during command
+ * validation (vmw_cmd_update_gb_surface -> user_surface_converter), so
+ * bo->handle.u32 is exactly what goes in.
+ */
+#define SVGA_3D_CMD_UPDATE_GB_SURFACE 1102
+#define SVGA_3D_CMD_READBACK_GB_SURFACE 1104
+
+static int vmwgfx_surface_transfer(struct bo *bo, uint32_t cmd_id)
+{
+	struct {
+		uint32_t id;
+		uint32_t size;
+		uint32_t sid;
+	} cmd;
+	struct drm_vmw_execbuf_arg arg;
+	int ret;
+
+	cmd.id = cmd_id;
+	cmd.size = sizeof(cmd.sid);
+	cmd.sid = bo->handle.u32;
+
+	memset(&arg, 0, sizeof(arg));
+	arg.commands = (uint64_t)(uintptr_t)&cmd;
+	arg.command_size = sizeof(cmd);
+	arg.version = DRM_VMW_EXECBUF_VERSION;
+	arg.context_handle = SVGA3D_INVALID_ID;
+	arg.imported_fence_fd = -1;
+
+	ret = drmCommandWrite(bo->drv->fd, DRM_VMW_EXECBUF, &arg, sizeof(arg));
+	if (ret)
+		drv_loge("execbuf %s failed for sid %u: %d\n",
+			 cmd_id == SVGA_3D_CMD_UPDATE_GB_SURFACE ? "UPDATE_GB_SURFACE"
+								 : "READBACK_GB_SURFACE",
+			 bo->handle.u32, ret);
+	return ret;
+}
+
+/*
+ * Called before CPU access. Pull the host's contents down into the MOB first,
+ * then grab — the grab idles the GPU on this buffer, so it also waits for the
+ * readback to land.
+ */
+static int vmwgfx_bo_invalidate(struct bo *bo, struct mapping *mapping)
+{
+	/*
+	 * Deliberately NO readback.
+	 *
+	 * READBACK_GB_SURFACE copies host -> MOB. For the buffers this backend
+	 * hands out that is the wrong direction, and actively destructive: the
+	 * guest MOB is the authoritative copy, because these buffers are written
+	 * by the CPU (a software video decoder) and only read by the GPU. Pulling
+	 * the host's copy down on a read lock overwrites the frame the decoder
+	 * just wrote with whatever the host happened to hold.
+	 *
+	 * That is not hypothetical for video. SurfaceFlinger's YV12 path on this
+	 * driver is bindYv12ViaCpuUpload(): Mesa SVGA rejects EGL dmabuf import for
+	 * YUV formats, so RenderEngine lockYCbCr()s the decoder's buffer with
+	 * GRALLOC_USAGE_SW_READ_OFTEN once per frame and uploads it by hand. With a
+	 * readback on that lock, every decoded frame was replaced by the host's
+	 * stale copy before it was ever read, so each buffer froze at whatever the
+	 * host first held and the picture circled the pool forever — measured on
+	 * device as a composed output with a period of exactly 16 against a 16-deep
+	 * BufferQueue.
+	 *
+	 * A readback is only right for a GPU-rendered surface the CPU wants to read
+	 * back. Nothing allocated here is that, and making every read lock pay for
+	 * it is what broke the one case that matters.
+	 */
+	return vmwgfx_sync_cpu(bo, mapping, true);
+}
+
+/*
+ * Called after CPU access. Release before submitting: a write grab blocks all
+ * command submissions referencing the buffer, so the UPDATE has to come after
+ * the buffer is handed back.
+ */
+static int vmwgfx_bo_flush(struct bo *bo, struct mapping *mapping)
+{
+	int ret = vmwgfx_sync_cpu(bo, mapping, false);
+
+	if (mapping->vma->map_flags & BO_MAP_WRITE)
+		vmwgfx_surface_transfer(bo, SVGA_3D_CMD_UPDATE_GB_SURFACE);
+	return ret;
+}
+
+/*
  * Release a bo by closing its GEM handle. This works for both locally
  * created GB surfaces (DRM_VMW_GB_SURFACE_CREATE registers the handle via
  * drm_gem_handle_create — see vmwgfx_surface.c:1751) and PRIME-imported
@@ -259,6 +549,8 @@
 	.bo_destroy = drv_gem_bo_destroy,
 	.bo_map = vmwgfx_bo_map,
 	.bo_unmap = drv_bo_munmap,
+	.bo_invalidate = vmwgfx_bo_invalidate,
+	.bo_flush = vmwgfx_bo_flush,
 	.resolve_format_and_use_flags = drv_resolve_format_and_use_flags_helper,
 };
 
