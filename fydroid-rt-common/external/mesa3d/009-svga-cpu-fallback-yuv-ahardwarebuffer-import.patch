diff --git a/src/gallium/drivers/svga/svga_yuv_import.c b/src/gallium/drivers/svga/svga_yuv_import.c
new file mode 100644
index 00000000000..e3f4bf3a14b
--- /dev/null
+++ b/src/gallium/drivers/svga/svga_yuv_import.c
@@ -0,0 +1,147 @@
+/*
+ * Copyright 2026 Fyde Innovations
+ * SPDX-License-Identifier: MIT
+ *
+ * Scalar BT.601 limited-range YUV → BGRA conversion + RGBA texture
+ * upload, used as a CPU fallback when SVGA / vmwgfx can't import a YUV
+ * AHardwareBuffer via EGL. The caller has already used
+ * AHardwareBuffer_lockPlanes() to get CPU-accessible per-plane pointers,
+ * row strides, and pixel strides. We rely on the lockPlanes contract:
+ * plane 0 is Y, plane 1 is U, plane 2 is V — regardless of underlying
+ * NV12/NV21/YV12/I420 storage. The plane_pixel_stride tells us whether
+ * chroma is planar (1) or interleaved (2), which is the only thing we
+ * need to walk the U/V planes correctly across all 4:2:0 formats.
+ *
+ * See svga_yuv_import.h for the rationale.
+ */
+
+#include "svga_yuv_import.h"
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "drm-uapi/drm_fourcc.h"
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "util/box.h"
+#include "util/u_inlines.h"
+
+bool
+svga_yuv_import_supports_fourcc(int fourcc)
+{
+    switch (fourcc) {
+    case DRM_FORMAT_NV12:
+    case DRM_FORMAT_NV21:
+    case DRM_FORMAT_YUV420:  /* I420 */
+    case DRM_FORMAT_YVU420:  /* YV12 */
+        return true;
+    default:
+        return false;
+    }
+}
+
+/* Scalar BT.601 limited-range:
+ *   R = ((298 * (Y - 16) + 409 * (V - 128) + 128) >> 8)
+ *   G = ((298 * (Y - 16) - 100 * (U - 128) - 208 * (V - 128) + 128) >> 8)
+ *   B = ((298 * (Y - 16) + 516 * (U - 128) + 128) >> 8) */
+static inline uint8_t
+clamp_u8(int v)
+{
+    if (v < 0) return 0;
+    if (v > 255) return 255;
+    return (uint8_t)v;
+}
+
+static void
+convert_yuv420_to_bgra(const uint8_t *y, int y_row_stride,
+                       const uint8_t *u, int u_row_stride, int u_pix_stride,
+                       const uint8_t *v, int v_row_stride, int v_pix_stride,
+                       uint8_t *dst, int dst_stride,
+                       int width, int height)
+{
+    for (int row = 0; row < height; row++) {
+        const uint8_t *y_row = y + row * y_row_stride;
+        const uint8_t *u_row = u + (row >> 1) * u_row_stride;
+        const uint8_t *v_row = v + (row >> 1) * v_row_stride;
+        uint8_t *out = dst + row * dst_stride;
+        for (int col = 0; col < width; col++) {
+            const int yi = (int)y_row[col] - 16;
+            const int ui = (int)u_row[(col >> 1) * u_pix_stride] - 128;
+            const int vi = (int)v_row[(col >> 1) * v_pix_stride] - 128;
+            const int y298 = 298 * yi;
+            int b = (y298 + 516 * ui + 128) >> 8;
+            int g = (y298 - 100 * ui - 208 * vi + 128) >> 8;
+            int r = (y298 + 409 * vi + 128) >> 8;
+            out[col * 4 + 0] = clamp_u8(b);
+            out[col * 4 + 1] = clamp_u8(g);
+            out[col * 4 + 2] = clamp_u8(r);
+            out[col * 4 + 3] = 0xFF;
+        }
+    }
+}
+
+struct pipe_resource *
+svga_yuv_import_from_planes(struct pipe_screen *pscreen,
+                             int width, int height,
+                             const void *plane_data[3],
+                             const int plane_row_stride[3],
+                             const int plane_pixel_stride[3])
+{
+    if (width <= 0 || height <= 0 || (width & 1) || (height & 1))
+        return NULL;
+    for (int i = 0; i < 3; i++) {
+        if (!plane_data[i] || plane_row_stride[i] <= 0 ||
+            plane_pixel_stride[i] <= 0)
+            return NULL;
+    }
+
+    struct pipe_resource templ = {0};
+    templ.target = PIPE_TEXTURE_2D;
+    templ.format = PIPE_FORMAT_B8G8R8A8_UNORM;
+    templ.width0 = (uint32_t)width;
+    templ.height0 = (uint32_t)height;
+    templ.depth0 = 1;
+    templ.array_size = 1;
+    templ.last_level = 0;
+    templ.nr_samples = 0;
+    templ.usage = PIPE_USAGE_DEFAULT;
+    templ.bind = PIPE_BIND_SAMPLER_VIEW;
+    struct pipe_resource *res = pscreen->resource_create(pscreen, &templ);
+    if (!res)
+        return NULL;
+
+    const int dst_stride = width * 4;
+    uint8_t *scratch = (uint8_t *)malloc((size_t)dst_stride * (size_t)height);
+    if (!scratch) {
+        pipe_resource_reference(&res, NULL);
+        return NULL;
+    }
+
+    convert_yuv420_to_bgra(plane_data[0], plane_row_stride[0],
+                           plane_data[1], plane_row_stride[1],
+                           plane_pixel_stride[1],
+                           plane_data[2], plane_row_stride[2],
+                           plane_pixel_stride[2],
+                           scratch, dst_stride, width, height);
+
+    struct pipe_context *ctx =
+        pscreen->context_create(pscreen, NULL, PIPE_CONTEXT_PRIORITY_MEDIUM);
+    if (!ctx) {
+        free(scratch);
+        pipe_resource_reference(&res, NULL);
+        return NULL;
+    }
+
+    struct pipe_box box;
+    u_box_2d(0, 0, width, height, &box);
+    ctx->texture_subdata(ctx, res, 0 /* level */, 0 /* usage */,
+                         &box, scratch, dst_stride, 0 /* layer stride */);
+    ctx->flush(ctx, NULL, 0);
+    ctx->destroy(ctx);
+    free(scratch);
+
+    return res;
+}
diff --git a/src/gallium/drivers/svga/svga_yuv_import.h b/src/gallium/drivers/svga/svga_yuv_import.h
new file mode 100644
index 00000000000..6944c9ba2db
--- /dev/null
+++ b/src/gallium/drivers/svga/svga_yuv_import.h
@@ -0,0 +1,80 @@
+/*
+ * Copyright 2026 Fyde Innovations
+ * SPDX-License-Identifier: MIT
+ *
+ * SVGA YUV-via-CPU dma-buf import.
+ *
+ * On Mesa SVGA running over vmwgfx (e.g. Apple Silicon under VMware Fusion)
+ * the kernel rejects every EGL dma-buf import path with EGL_BAD_PARAMETER,
+ * so eglCreateImageKHR(EGL_NATIVE_BUFFER_ANDROID) returns NULL for any YUV
+ * AHardwareBuffer. WebView's video pipeline (gl_image_egl.cc /
+ * android_image_reader_utils.cc) treats that as a fatal black frame.
+ *
+ * This module is the user-space fallback: mmap() the YUV dma-bufs, run
+ * a scalar BT.601 conversion to BGRA8, and upload through the SVGA
+ * pipe_screen as a plain RGBA texture. The returned pipe_resource carries
+ * no dma-buf backing — sampling is a normal 2D RGBA texture fetch, so
+ * shader EGLImage lowering becomes a no-op.
+ *
+ * Caller responsibilities: the dma-buf fds must outlive the call; the
+ * function does not take ownership (it dup()s nothing and does not close).
+ */
+
+#ifndef SVGA_YUV_IMPORT_H
+#define SVGA_YUV_IMPORT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pipe_screen;
+struct pipe_resource;
+
+/*
+ * Both entry points have visibility("default") so they survive being
+ * link_whole'd into libgallium_dri.so (whose default symbol visibility
+ * is hidden + filtered by dri.dyn). libEGL_mesa.so reaches them as
+ * weak externs.
+ */
+#define SVGA_YUV_PUBLIC __attribute__((visibility("default")))
+
+/*
+ * Return true if `fourcc` is a planar YUV format that
+ * svga_yuv_import_from_dmabufs() knows how to convert. Lets the caller
+ * decide cheaply, before paying the mmap/convert/upload cost, whether
+ * this fallback applies.
+ */
+SVGA_YUV_PUBLIC bool svga_yuv_import_supports_fourcc(int fourcc);
+
+/*
+ * Convert a YUV image whose planes have already been CPU-mapped by the
+ * caller (typically via AHardwareBuffer_lockPlanes) into a freshly-
+ * allocated RGBA8 pipe_resource on `pscreen`. Returns NULL on any
+ * unrecoverable error.
+ *
+ * Plane layout follows the AHardwareBuffer_lockPlanes contract: index
+ * 0 is always Y, 1 is always U (Cb), 2 is always V (Cr) regardless of
+ * the underlying storage. `plane_pixel_stride[1..2]` distinguishes
+ * planar (1) from interleaved (2) chroma — i.e. YV12/I420 vs NV12/NV21
+ * — without the caller having to plumb the original fourcc through.
+ *
+ * On success the returned resource has format PIPE_FORMAT_B8G8R8A8_UNORM
+ * with PIPE_BIND_SAMPLER_VIEW. The caller retains ownership of the
+ * mapped pages (this function only reads from them) and is responsible
+ * for AHardwareBuffer_unlock() after this call returns.
+ */
+SVGA_YUV_PUBLIC struct pipe_resource *
+svga_yuv_import_from_planes(struct pipe_screen *pscreen,
+                             int width, int height,
+                             const void *plane_data[3],
+                             const int plane_row_stride[3],
+                             const int plane_pixel_stride[3]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SVGA_YUV_IMPORT_H */
