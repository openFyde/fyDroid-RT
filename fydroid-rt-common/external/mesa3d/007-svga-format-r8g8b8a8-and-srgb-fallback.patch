diff --git a/src/egl/drivers/dri2/egl_dri2.c b/src/egl/drivers/dri2/egl_dri2.c
index edee4ffc3ff..78ca67a7c2f 100644
--- a/src/egl/drivers/dri2/egl_dri2.c
+++ b/src/egl/drivers/dri2/egl_dri2.c
@@ -239,7 +239,16 @@ dri2_get_dri_config(struct dri2_egl_config *conf, EGLint surface_type,
    const bool double_buffer = surface_type == EGL_WINDOW_BIT;
    const bool srgb = colorspace == EGL_GL_COLORSPACE_SRGB_KHR;
 
+#ifdef HAVE_SVGA
+   /* SVGA gallium doesn't always populate dri_config for both srgb states.
+    * Fall back to the non-srgb config when the requested one is missing,
+    * preserving stock behavior on other gallium drivers. */
+   return conf->dri_config[double_buffer][srgb]
+              ? conf->dri_config[double_buffer][srgb]
+              : conf->dri_config[double_buffer][!srgb];
+#else
    return conf->dri_config[double_buffer][srgb];
+#endif
 }
 
 static EGLBoolean
