diff --git a/src/intel/vulkan/anv_image.c b/src/intel/vulkan/anv_image.c
index 270f885274b..e5e63477c9a 100644
--- a/src/intel/vulkan/anv_image.c
+++ b/src/intel/vulkan/anv_image.c
@@ -2556,9 +2556,19 @@ resolve_anb_image(struct anv_device *device,
    /* Query DRM modifier. */
    VkImageDrmFormatModifierExplicitCreateInfoEXT mod_info;
    VkSubresourceLayout layouts[ISL_MODIFIER_MAX_PLANES];
-   result = vk_android_get_ahb_layout(gralloc_info->ahb,
-                                      &mod_info, layouts,
-                                      ISL_MODIFIER_MAX_PLANES);
+   /* fydroid: NOT vk_android_get_ahb_layout(gralloc_info->ahb, ...). The `ahb`
+    * field of VkNativeBufferANDROID is spec v11 and AOSP-13's Vulkan loader
+    * never fills it in, so it arrives as garbage and dereferencing it through
+    * AHardwareBuffer_getNativeHandle() took down vkCreateSwapchainKHR. Take the
+    * layout from the native buffer handle instead -- what upstream's own
+    * vk_android_get_anb_layout() does for the create-info path, which 26.1.4
+    * fixed; this is the bind-time path, which still reads ->ahb upstream.
+    */
+   result = vk_android_get_anb_handle_layout(gralloc_info->handle,
+                                             gralloc_info->stride,
+                                             gralloc_info->format,
+                                             &mod_info, layouts,
+                                             ISL_MODIFIER_MAX_PLANES);
    if (result != VK_SUCCESS)
       return result;
 
diff --git a/src/vulkan/runtime/vk_android.c b/src/vulkan/runtime/vk_android.c
index 7f8ac1e0115..b3dedc8b0ef 100644
--- a/src/vulkan/runtime/vk_android.c
+++ b/src/vulkan/runtime/vk_android.c
@@ -278,24 +278,36 @@ vk_android_import_anb(struct vk_device *device,
 }
 
 VkResult
-vk_android_get_anb_layout(
-   const VkImageCreateInfo *pCreateInfo,
+vk_android_get_anb_handle_layout(
+   const struct native_handle *handle, int pixel_stride, int hal_format,
    VkImageDrmFormatModifierExplicitCreateInfoEXT *out,
    VkSubresourceLayout *out_layouts, int max_planes)
 {
-   const VkNativeBufferANDROID *native_buffer =
-      vk_find_struct_const(pCreateInfo->pNext, NATIVE_BUFFER_ANDROID);
-
    struct u_gralloc_buffer_handle gr_handle = {
-      .handle = native_buffer->handle,
-      .hal_format = native_buffer->format,
-      .pixel_stride = native_buffer->stride,
+      .handle = handle,
+      .hal_format = hal_format,
+      .pixel_stride = pixel_stride,
    };
 
    return vk_gralloc_to_drm_explicit_layout(&gr_handle, out,
                                             out_layouts, max_planes);
 }
 
+VkResult
+vk_android_get_anb_layout(
+   const VkImageCreateInfo *pCreateInfo,
+   VkImageDrmFormatModifierExplicitCreateInfoEXT *out,
+   VkSubresourceLayout *out_layouts, int max_planes)
+{
+   const VkNativeBufferANDROID *native_buffer =
+      vk_find_struct_const(pCreateInfo->pNext, NATIVE_BUFFER_ANDROID);
+
+   return vk_android_get_anb_handle_layout(native_buffer->handle,
+                                           native_buffer->stride,
+                                           native_buffer->format,
+                                           out, out_layouts, max_planes);
+}
+
 VkResult
 vk_android_init_deferred_image(struct vk_device *device,
                                struct vk_image *image,
diff --git a/src/vulkan/runtime/vk_android.h b/src/vulkan/runtime/vk_android.h
index 8dc990a0e53..75883717f9f 100644
--- a/src/vulkan/runtime/vk_android.h
+++ b/src/vulkan/runtime/vk_android.h
@@ -37,6 +37,7 @@ extern "C" {
 struct u_gralloc;
 struct vk_device;
 struct vk_image;
+struct native_handle; /* native_handle_t, from <cutils/native_handle.h> */
 
 #ifdef VK_USE_PLATFORM_ANDROID_KHR
 
@@ -57,6 +58,17 @@ VkResult vk_android_get_anb_layout(
    VkImageDrmFormatModifierExplicitCreateInfoEXT *out,
    VkSubresourceLayout *out_layouts, int max_planes);
 
+/* Same, but from the gralloc handle/stride/format directly, for a caller that
+ * has only the VkNativeBufferANDROID and no VkImageCreateInfo -- the
+ * vkBindImageMemory2 path, where the loader injects the ANB into the bind
+ * info's pNext chain. Takes primitives rather than the ANB itself because this
+ * header only includes vulkan_core.h, so VkNativeBufferANDROID is not a
+ * complete type here (and must not be, for the non-Android build below). */
+VkResult vk_android_get_anb_handle_layout(
+   const struct native_handle *handle, int pixel_stride, int hal_format,
+   VkImageDrmFormatModifierExplicitCreateInfoEXT *out,
+   VkSubresourceLayout *out_layouts, int max_planes);
+
 VkResult vk_android_init_deferred_image(struct vk_device *device,
                                         struct vk_image *image,
                                         const VkImageCreateInfo *pCreateInfo,
@@ -88,6 +100,15 @@ vk_android_get_anb_layout(
    return VK_ERROR_FEATURE_NOT_PRESENT;
 }
 
+static inline VkResult
+vk_android_get_anb_handle_layout(
+   const struct native_handle *handle, int pixel_stride, int hal_format,
+   VkImageDrmFormatModifierExplicitCreateInfoEXT *out,
+   VkSubresourceLayout *out_layouts, int max_planes)
+{
+   return VK_ERROR_FEATURE_NOT_PRESENT;
+}
