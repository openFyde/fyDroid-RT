// Chrome OS Exo Wayland protocol extensions not present in AOSP 11.
// These are needed by fydroid-rt's SurfaceFlinger Wayland client.
//
// XML sources come from Chromium (chromium.org/unstable/ and chromium.org/exo/).
// Generated at build time using AOSP's wayland_scanner via wayland_protocol_codegen.

filegroup {
    name: "fydroid_wayland_extension_protocols",
    srcs: [
        "chromium.org/**/*.xml",
        "freedesktop.org/**/*.xml",
    ],
}

// Generate protocol source files (marshalling code)
wayland_protocol_codegen {
    name: "fydroid_wayland_extension_protocol_sources",
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    suffix: ".c",
    srcs: [":fydroid_wayland_extension_protocols"],
    tools: ["wayland_scanner"],
}

// Generate client-side protocol headers
wayland_protocol_codegen {
    name: "fydroid_wayland_extension_client_protocol_headers",
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    suffix: "-client-protocol.h",
    srcs: [":fydroid_wayland_extension_protocols"],
    tools: ["wayland_scanner"],
}

// Generate server-side protocol headers
wayland_protocol_codegen {
    name: "fydroid_wayland_extension_server_protocol_headers",
    cmd: "$(location wayland_scanner) server-header < $(in) > $(out)",
    suffix: "-server-protocol.h",
    srcs: [":fydroid_wayland_extension_protocols"],
    tools: ["wayland_scanner"],
}

// Static library exporting client-side headers and protocol sources
cc_library_static {
    name: "libfydroid_wayland_extension_client_protocols",
    vendor_available: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-g",
        "-fvisibility=hidden",
    ],
    static_libs: ["libwayland_client_static"],
    generated_sources: ["fydroid_wayland_extension_protocol_sources"],
    generated_headers: ["fydroid_wayland_extension_client_protocol_headers"],
    export_generated_headers: ["fydroid_wayland_extension_client_protocol_headers"],
}

// Static library exporting server-side headers and protocol sources
cc_library_static {
    name: "libfydroid_wayland_extension_server_protocols",
    vendor_available: true,
    host_supported: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-g",
        "-fvisibility=hidden",
    ],
    static_libs: ["libwayland_server"],
    generated_sources: ["fydroid_wayland_extension_protocol_sources"],
    generated_headers: ["fydroid_wayland_extension_server_protocol_headers"],
    export_generated_headers: ["fydroid_wayland_extension_server_protocol_headers"],
}
