// Open-source replacement for proprietary camera.bertha_v3.so.
//
// Bridges the Android Camera HAL v3 API (camera_module_t) to the Chrome OS
// camera service via Mojo IPC (cros::mojom::CameraModule) over the ARC bridge.
//
// Entry point: HMI (camera_module_t) — loaded by
// android.hardware.camera.provider@2.4-impl via hw_get_module("camera").

cc_library_shared {
    name: "camera.bertha_v3",
    stem: "camera.bertha_v3",
    relative_install_path: "hw",
    // Install to /system/lib{,64}/hw/ (not vendor)

    srcs: [
        "CameraHal.cpp",
        "CameraHalClient.cpp",
        "CameraInstanceImpl.cpp",
        "CameraModuleDelegate.cpp",
        "CameraModuleCallbacksImpl.cpp",
        "Camera3DeviceOpsDelegate.cpp",
        "Camera3CallbackOpsImpl.cpp",
        "VendorTagOpsDelegate.cpp",
        "BufferAdapter.cpp",
    ],

    local_include_dirs: ["."],

    shared_libs: [
        "libarcbridge",
        "libarcbridgeservice",
        "vendor.google_arc.arcbridge@1.0",
        "libchrome",
        "libmojo",
        "libhidlbase",
        "libhardware",
        "libcamera_metadata",
        "libcutils",
        "liblog",
        "libsync",
        "libutils",
    ],

    cflags: [
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
    ],

    compile_multilib: "both",
}
