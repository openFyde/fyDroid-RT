cc_library_shared {
    name: "audio.primary.cheets",
    relative_install_path: "hw",
    vendor: true,

    srcs: ["audio_hw.c"],

    static_libs: ["libcras_fydroid"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libtinyalsa",
    ],

    header_libs: [
        "libhardware_headers",
        "libaudio_system_headers",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
    ],
}
