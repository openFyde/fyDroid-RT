cc_binary {
    name: "fydroid_arcvideobridge",
    defaults: ["fydroid_perf_defaults"],
    stem: "vendor.google_arc.arcvideobridge@1.0-service",

    srcs: [
        "main.cpp",
        "VideoService.cpp",
    ],

    shared_libs: [
        "libarcbridge",
        "libarcbridgeservice",
        "libbase",
        "libbinder",
        "libchrome",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libmojo",
        "libnativewindow",
        "libutils",
        "vendor.google_arc.arcvideobridge@1.0",
    ],

    init_rc: ["fydroid_arcvideobridge.rc"],

    vendor: true,
    relative_install_path: "hw",

    cflags: [
        "-Wno-unused-parameter",
    ],
}
