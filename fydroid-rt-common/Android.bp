// Shared build defaults for fydroid-rt.

// Performance build flags, opt-in via a module's `defaults`. Scoped to the
// x86 arches with arch{} blocks, so adding this to a module is a no-op on the
// arm64 / apple boards — they keep building byte-for-byte unchanged. -O3 and
// ThinLTO are safe with AOSP 11's clang 11 and run on every Intel/AMD CPU: we
// keep the generic x86-64 baseline (no AVX2), so nothing here raises the ISA
// floor below the older Atom-class Chromebooks the project targets.
cc_defaults {
    name: "fydroid_perf_defaults",
    arch: {
        x86_64: {
            cflags: ["-O3"],
            lto: {
                thin: true,
            },
        },
        x86: {
            cflags: ["-O3"],
            lto: {
                thin: true,
            },
        },
    },
}
