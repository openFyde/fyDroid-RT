<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="com.fydeos.inputmethod">
        <permission name="android.permission.MANAGE_ACTIVITY_STACKS" />
    </privapp-permissions>

    <privapp-permissions package="com.android.documentsui">
        <permission name="android.permission.CHANGE_OVERLAY_PACKAGES" />
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <permission name="android.permission.LOG_COMPAT_CHANGE" />
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE" />
        <permission name="android.permission.MODIFY_QUIET_MODE" />
        <permission name="android.permission.READ_COMPAT_CHANGE_CONFIG" />
        <permission name="org.chromium.arc.data_device.NOTIFY_CONTENT_PROVIDER_ACCESS" />
    </privapp-permissions>
    <privapp-permissions package="io.fydeos.arc.gateway">
        <permission name="android.permission.INSTALL_PACKAGES" />
    </privapp-permissions>
    <privapp-permissions package="io.fydeos.arc.policymanager">
        <permission name="android.permission.INSTALL_PACKAGES" />
        <permission name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    </privapp-permissions>

    <!--
        ArcAccessibilityHelperService: the ChromeVox bridge toggles secure
        settings (accessibility_enabled / enabled_accessibility_services) as
        ChromeVox is turned on and off.

        This entry is what makes ro.control_privapp_permissions=enforce safe.
        WRITE_SECURE_SETTINGS is signature|privileged and the app is
        PRIVILEGED in /system/priv-app, but it was allowlisted nowhere — under
        `log` that only produced a Slog.w and the permission was granted
        anyway, which is why nothing ever surfaced. Under `enforce` the same
        pair lands in mPrivappPermissionsViolations and PackageManagerService
        throws, i.e. a system_server boot loop. It was the only such gap on any
        of the four products.
    -->
    <privapp-permissions package="org.chromium.arc.accessibility">
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
</permissions>
