// Combined AIDL service that registers IPower and IPowerStats as
// binderized stubs. Without this, servicemanager spends ~1s per query
// trying ctl.interface_start as a "lazy HAL", which delays BatteryStats
// lookups (e.g. blocking Settings launch by ~4s).
//
// Was HIDL @1.0 originally. compatibility_matrix.6.xml lists power
// and power.stats ONLY as AIDL, so serving the HIDL interfaces failed
// checkvintf: "android.hardware.power@1.0::IPower/default is deprecated in
// compatibility matrix at FCM Version 6; it should not be served".
cc_binary {
    name: "fydroid_arcpower",
    stem: "arcpower",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["arcpower.rc"],
    // VINTF enforcement (FCM 6) requires these services to be declared in the
    // device manifest, else AServiceManager_addService is rejected and
    // LOG_ALWAYS_FATAL_IF crash-loops arcpower. These are extra device HALs
    // (the framework matrix lists power/power.stats as AIDL-optional).
    // IPower is pinned to V2 because matrix 6 accepts android.hardware.power
    // 1-2; V3 would fail the compatibility check.
    vintf_fragments: ["arcpower.xml"],

    srcs: [
        "main.cpp",
        "Power.cpp",
        "PowerStats.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libbinder_ndk",
        "android.hardware.power-V2-ndk",
        "android.hardware.power.stats-V1-ndk",
    ],
}
