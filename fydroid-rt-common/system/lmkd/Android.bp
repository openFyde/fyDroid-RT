cc_binary {
    name: "fydroid_lmkd",
    overrides: ["lmkd"],
    srcs: ["main.cpp"],
    shared_libs: [
        "liblog",
        "libcutils",
    ],
    static_libs: [
        "liblmkd_utils",
        // Statically linked so the daemon stays a single self-contained binary:
        // stock lmkd is overridden out of the image, so nothing else would pull
        // libpsi.so in.
        "libpsi",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    init_rc: ["fydroid_lmkd.rc"],
}
