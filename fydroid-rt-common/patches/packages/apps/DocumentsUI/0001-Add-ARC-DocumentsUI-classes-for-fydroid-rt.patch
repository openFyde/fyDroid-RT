@@ -0,0 +1,472 @@
+package org.chromium.arc.file_system;
+
+import android.content.Context;
+import android.content.res.AssetFileDescriptor;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.graphics.Point;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.ParcelFileDescriptor;
+import android.provider.DocumentsContract;
+import android.provider.MediaStore;
+import android.util.Log;
+import java.io.Closeable;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import org.chromium.arc.mojom.Document;
+import org.chromium.arc.mojom.FileSystemHost;
+import org.chromium.arc.mojom.Root;
+import org.chromium.arc.mojom.RootSize;
+
+class DocumentsProviderHandler {
+    private static final int FILE_SYSTEM_HOST_DOCUMENT_WATCHER_VERSION = 3;
+    private static final int FILE_SYSTEM_HOST_ON_ROOTS_CHANGED_VERSION = 10;
+    private static final String MEDIA_DOCUMENTS_PROVIDER_AUTHORITY =
+            "com.android.providers.media.documents";
+    private static final int SLEEP_INTERVAL_FOR_CLOUD_SYNC = 1500;
+    private static final String TAG = "DocumentsProviderHandler";
+
+    private final Context mContext;
+    final FileSystemHostHolder mHostHolder;
+    private final DocumentsProviderRoots mProviderRoots;
+    private final WatcherSet mWatcherSet = new WatcherSet();
+    private final RootsObserver mRootsObserver = new RootsObserver();
+
+    public DocumentsProviderHandler(Context context, FileSystemHostHolder hostHolder) {
+        mContext = context;
+        mHostHolder = hostHolder;
+        mProviderRoots = new DocumentsProviderRoots(context);
+        mProviderRoots.registerObserver(mRootsObserver);
+        mProviderRoots.startMonitoring();
+    }
+
+    public Document getDocument(String authority, String documentId) {
+        Document[] docs = queryDocuments(
+                DocumentsContract.buildDocumentUri(authority, documentId),
+                isMediaDocumentsProvider(authority), -1);
+        if (docs == null || docs.length < 1) {
+            return null;
+        }
+        if (docs.length >= 2) {
+            Log.e(TAG, "queryDocument query returned multiple documents; ignoring rest");
+        }
+        return docs[0];
+    }
+
+    public Document[] getChildDocuments(String authority, String documentId) {
+        if (!isDirectory(getDocument(authority, documentId))) {
+            return null;
+        }
+        return queryDocuments(
+                DocumentsContract.buildChildDocumentsUri(authority, documentId),
+                isMediaDocumentsProvider(authority), -1);
+    }
+
+    public Document[] getRecentDocuments(String authority, String rootId) {
+        return queryDocuments(
+                DocumentsContract.buildRecentDocumentsUri(authority, rootId),
+                isMediaDocumentsProvider(authority), 1000);
+    }
+
+    public Root[] getRoots() {
+        return mProviderRoots.getRoots();
+    }
+
+    public RootSize getRootSize(String authority, String rootId) {
+        return mProviderRoots.getRootSize(authority, rootId);
+    }
+
+    public boolean deleteDocument(String authority, String documentId) {
+        try {
+            return DocumentsContract.deleteDocument(mContext.getContentResolver(),
+                    DocumentsContract.buildDocumentUri(authority, documentId));
+        } catch (FileNotFoundException e) {
+            Log.e(TAG, "Document not found: ", e);
+            return false;
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+
+    public Document renameDocument(String authority, String documentId,
+            String displayName) {
+        try {
+            return queryDocument(DocumentsContract.renameDocument(
+                    mContext.getContentResolver(),
+                    DocumentsContract.buildDocumentUri(authority, documentId),
+                    displayName));
+        } catch (FileNotFoundException e) {
+            Log.e(TAG, "Document not found: ", e);
+            return null;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    public Document createDocument(String authority, String parentDocumentId,
+            String mimeType, String displayName) {
+        Document result = null;
+        try {
+            result = queryDocument(DocumentsContract.createDocument(
+                    mContext.getContentResolver(),
+                    DocumentsContract.buildDocumentUri(authority, parentDocumentId),
+                    mimeType, displayName));
+            Thread.sleep(SLEEP_INTERVAL_FOR_CLOUD_SYNC);
+        } catch (FileNotFoundException e) {
+            Log.e(TAG, "Document not found: ", e);
+        } catch (IllegalArgumentException | InterruptedException e) {
+            Log.e(TAG, "Failed to sleep during sync: ", e);
+        } catch (Throwable t) {
+            // fall through
+        }
+        return result;
+    }
+
+    public Document copyDocument(String authority, String documentId,
+            String targetParentDocumentId) {
+        try {
+            return queryDocument(DocumentsContract.copyDocument(
+                    mContext.getContentResolver(),
+                    DocumentsContract.buildDocumentUri(authority, documentId),
+                    DocumentsContract.buildDocumentUri(authority, targetParentDocumentId)));
+        } catch (FileNotFoundException e) {
+            Log.e(TAG, "Document not found: ", e);
+            return null;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    public Document moveDocument(String authority, String documentId,
+            String sourceParentDocumentId, String targetParentDocumentId) {
+        try {
+            return queryDocument(DocumentsContract.moveDocument(
+                    mContext.getContentResolver(),
+                    DocumentsContract.buildDocumentUri(authority, documentId),
+                    DocumentsContract.buildDocumentUri(authority, sourceParentDocumentId),
+                    DocumentsContract.buildDocumentUri(authority, targetParentDocumentId)));
+        } catch (FileNotFoundException e) {
+            Log.e(TAG, "Document not found: ", e);
+            return null;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    public ParcelFileDescriptor openThumbnail(Uri uri, Point size) {
+        try {
+            Bundle opts = new Bundle();
+            opts.putParcelable("android.content.extra.SIZE", size);
+            AssetFileDescriptor afd = mContext.getContentResolver()
+                    .openTypedAssetFileDescriptor(uri, "*/*", opts, null);
+            if (afd == null) {
+                return null;
+            }
+            if (afd.getDeclaredLength() == -1) {
+                return afd.getParcelFileDescriptor();
+            }
+            Log.w(TAG, "Not a whole file: " + uri);
+            try {
+                afd.close();
+            } catch (IOException e) {
+                Log.e(TAG, "Failed to close AssetFileDescriptor", e);
+            }
+            return null;
+        } catch (FileNotFoundException | RuntimeException e) {
+            Log.e(TAG, "Failed to open: " + uri, e);
+            return null;
+        }
+    }
+
+    public long addWatcher(String authority, String documentId) {
+        if (!isDirectory(getDocument(authority, documentId))) {
+            return -1;
+        }
+        Uri childUri = DocumentsContract.buildChildDocumentsUri(authority, documentId);
+        try {
+            Cursor cursor = mContext.getContentResolver().query(childUri,
+                    new String[]{"document_id"}, null, null, null);
+            if (cursor == null) {
+                return -1;
+            }
+            return mWatcherSet.add(authority, documentId, cursor);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Failed to query: " + childUri, e);
+            return -1;
+        }
+    }
+
+    public boolean removeWatcher(long watcherId) {
+        return mWatcherSet.remove(watcherId);
+    }
+
+    void updateRootsForTesting(String authority) {
+        mProviderRoots.updateRootsForAuthorityForTesting(authority);
+    }
+
+    void cleanupForTesting() {
+        mProviderRoots.stopMonitoring();
+        mProviderRoots.unregisterObserver(mRootsObserver);
+    }
+
+    static boolean isDirectory(Document doc) {
+        return doc != null && "vnd.android.document/directory".equals(doc.mimeType);
+    }
+
+    private static boolean isMediaDocumentsProvider(String authority) {
+        return MEDIA_DOCUMENTS_PROVIDER_AUTHORITY.equals(authority);
+    }
+
+    private Document[] queryDocuments(Uri uri, boolean isMedia, int limit) {
+        ArrayList<Document> docs = new ArrayList<>();
+        String[] projection = {"document_id", "_display_name", "mime_type",
+                "_size", "last_modified", "flags"};
+        Bundle queryArgs = new Bundle();
+        final String limitKey = "android:query-arg-limit";
+        if (limit >= 0) {
+            queryArgs.putInt(limitKey, limit);
+        }
+        try {
+            Cursor cursor = mContext.getContentResolver().query(uri, projection,
+                    queryArgs, null);
+            if (cursor == null) {
+                return null;
+            }
+            try {
+                Bundle extras = cursor.getExtras();
+                if (extras == null) extras = Bundle.EMPTY;
+                String[] honoredArgs = extras.getStringArray(
+                        "android.content.extra.HONORED_ARGS");
+                if (limit >= 0 && (honoredArgs == null
+                        || !Arrays.stream(honoredArgs).anyMatch(limitKey::equals))) {
+                    Log.e(TAG, "Trying to set limit, but QUERY_ARG_LIMIT is ignored.");
+                }
+                int idCol = cursor.getColumnIndexOrThrow("document_id");
+                int nameCol = cursor.getColumnIndexOrThrow("_display_name");
+                int mimeCol = cursor.getColumnIndexOrThrow("mime_type");
+                int sizeCol = cursor.getColumnIndexOrThrow("_size");
+                int modifiedCol = cursor.getColumnIndexOrThrow("last_modified");
+                int flagsCol = cursor.getColumnIndexOrThrow("flags");
+                cursor.moveToFirst();
+                while (!cursor.isAfterLast()) {
+                    if (cursor.isNull(idCol) || cursor.isNull(mimeCol)) {
+                        Log.e(TAG, "Received a document missing required fields.");
+                    } else {
+                        String docId = cursor.getString(idCol);
+                        String name = cursor.isNull(nameCol) ? "" : cursor.getString(nameCol);
+                        String mime = cursor.getString(mimeCol);
+                        long size = cursor.isNull(sizeCol) ? -1L : cursor.getLong(sizeCol);
+                        long modified = cursor.isNull(modifiedCol) ? 0L
+                                : cursor.getLong(modifiedCol);
+                        int flags = cursor.getInt(flagsCol);
+                        Document doc = new Document();
+                        doc.documentId = docId;
+                        doc.displayName = name;
+                        doc.mimeType = mime;
+                        doc.size = size;
+                        doc.lastModified = modified;
+                        doc.supportsDelete = (flags & 4) != 0;
+                        doc.supportsRename = (flags & 64) != 0;
+                        doc.supportsWrite = (flags & 2) != 0;
+                        doc.dirSupportsCreate = (flags & 8) != 0;
+                        doc.supportsCopy = (flags & 128) != 0;
+                        doc.supportsMove = (flags & 256) != 0;
+                        doc.supportsThumbnail = (flags & 1) != 0;
+                        docs.add(doc);
+                    }
+                    cursor.moveToNext();
+                }
+            } catch (IllegalArgumentException e) {
+                Log.e(TAG, "Required column(s) are missing.");
+                return null;
+            } finally {
+                cursor.close();
+            }
+            if (isMedia) {
+                queryMediaStoreDocumentLocations(docs);
+            }
+            return docs.toArray(new Document[0]);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Failed to query: " + uri, e);
+            return null;
+        }
+    }
+
+    private Document queryDocument(Uri uri) {
+        Document[] docs = queryDocuments(uri, false, 1);
+        if (docs == null || docs.length != 1) {
+            Log.e(TAG, "Failed to query a single document: " + uri);
+            return null;
+        }
+        return docs[0];
+    }
+
+    private void queryMediaStoreDocumentLocations(List<Document> docs) {
+        Map<Long, Document> imageMap = new HashMap<>();
+        Map<Long, Document> videoMap = new HashMap<>();
+        Map<Long, Document> audioMap = new HashMap<>();
+        Map<Long, Document> otherMap = new HashMap<>();
+        for (Document doc : docs) {
+            if (isDirectory(doc)) continue;
+            int colonIdx = doc.documentId.indexOf(':');
+            if (colonIdx < 0) {
+                Log.w(TAG, "Failed to parse a media document ID: " + doc.documentId);
+                continue;
+            }
+            String type = doc.documentId.substring(0, colonIdx);
+            try {
+                long id = Long.parseLong(doc.documentId.substring(colonIdx + 1));
+                switch (type) {
+                    case "image": imageMap.put(id, doc); break;
+                    case "video": videoMap.put(id, doc); break;
+                    case "audio": audioMap.put(id, doc); break;
+                    default: otherMap.put(id, doc); break;
+                }
+            } catch (NumberFormatException e) {
+                Log.w(TAG, "Failed to parse a media document ID: " + doc.documentId);
+            }
+        }
+        queryMediaStoreDocumentLocations(
+                MediaStore.Images.Media.EXTERNAL_CONTENT_URI, imageMap);
+        queryMediaStoreDocumentLocations(
+                MediaStore.Video.Media.EXTERNAL_CONTENT_URI, videoMap);
+        queryMediaStoreDocumentLocations(
+                MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, audioMap);
+        queryMediaStoreDocumentLocations(
+                MediaStore.Files.getContentUri("external"), otherMap);
+    }
+
+    private void queryMediaStoreDocumentLocations(Uri collection,
+            Map<Long, Document> docMap) {
+        if (docMap.isEmpty()) return;
+        StringBuilder selection = new StringBuilder("_id IN (");
+        boolean first = true;
+        for (Long id : docMap.keySet()) {
+            if (!first) selection.append(", ");
+            first = false;
+            selection.append(id);
+        }
+        selection.append(")");
+        try {
+            Cursor cursor = mContext.getContentResolver().query(collection,
+                    new String[]{"_id", "_data"}, selection.toString(), null, null);
+            if (cursor == null) return;
+            try {
+                int idCol = cursor.getColumnIndex("_id");
+                int dataCol = cursor.getColumnIndex("_data");
+                if (idCol < 0 || dataCol < 0) {
+                    Log.e(TAG, "Required columns are missing.");
+                    return;
+                }
+                cursor.moveToFirst();
+                while (!cursor.isAfterLast()) {
+                    if (!cursor.isNull(idCol) && !cursor.isNull(dataCol)) {
+                        long id = cursor.getLong(idCol);
+                        String path = cursor.getString(dataCol);
+                        Document doc = docMap.get(id);
+                        if (doc != null) {
+                            doc.androidFileSystemPath = path;
+                        }
+                    }
+                    cursor.moveToNext();
+                }
+            } finally {
+                cursor.close();
+            }
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Failed to query: " + collection, e);
+        }
+    }
+
+    private class Watcher extends ContentObserver implements Closeable {
+        private final String mAuthority;
+        private final String mDocumentId;
+        private final Cursor mCursor;
+        private final long mWatcherId;
+        private boolean mClosed = false;
+
+        public Watcher(long watcherId, String authority, String documentId,
+                Cursor cursor) {
+            super(null);
+            mWatcherId = watcherId;
+            mAuthority = authority;
+            mDocumentId = documentId;
+            mCursor = cursor;
+            cursor.registerContentObserver(this);
+        }
+
+        @Override
+        public void close() {
+            synchronized (this) {
+                if (!mClosed) {
+                    mCursor.unregisterContentObserver(this);
+                    mCursor.close();
+                    mClosed = true;
+                }
+            }
+        }
+
+        @Override
+        public void onChange(boolean selfChange) {
+            boolean deleted = !DocumentsProviderHandler.isDirectory(
+                    DocumentsProviderHandler.this.getDocument(mAuthority, mDocumentId));
+            synchronized (this) {
+                if (mClosed) return;
+                synchronized (mHostHolder) {
+                    FileSystemHost host = mHostHolder.getLocked(
+                            FILE_SYSTEM_HOST_DOCUMENT_WATCHER_VERSION);
+                    if (host != null) {
+                        host.onDocumentChanged(mWatcherId, deleted ? 1 : 0);
+                    }
+                }
+            }
+        }
+    }
+
+    private class WatcherSet {
+        private long mNextWatcherId = 1;
+        private final Map<Long, Watcher> mWatcherMap = new HashMap<>();
+
+        public long add(String authority, String documentId, Cursor cursor) {
+            long id;
+            synchronized (this) {
+                id = mNextWatcherId++;
+            }
+            Watcher watcher = new Watcher(id, authority, documentId, cursor);
+            synchronized (this) {
+                mWatcherMap.put(id, watcher);
+            }
+            return id;
+        }
+
+        public boolean remove(long watcherId) {
+            Watcher watcher;
+            synchronized (this) {
+                watcher = mWatcherMap.remove(watcherId);
+            }
+            if (watcher == null) return false;
+            watcher.close();
+            return true;
+        }
+    }
+
+    private class RootsObserver implements DocumentsProviderRoots.Observer {
+        @Override
+        public void onRootsChanged() {
+            synchronized (mHostHolder) {
+                FileSystemHost host = mHostHolder.getLocked(
+                        FILE_SYSTEM_HOST_ON_ROOTS_CHANGED_VERSION);
+                if (host != null) {
+                    host.onRootsChanged();
+                }
+            }
+        }
+    }
+}
diff --git a/src/org/chromium/arc/file_system/DocumentsProviderRoots.java b/src/org/chromium/arc/file_system/DocumentsProviderRoots.java
