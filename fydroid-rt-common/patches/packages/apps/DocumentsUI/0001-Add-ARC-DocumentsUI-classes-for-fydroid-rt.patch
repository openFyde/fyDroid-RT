+    @Override
+    public void reindexDirectory(String directory) {
+        requestMediaScan(new String[]{directory});
+        try {
+            Cursor cursor = mContext.getContentResolver().query(
+                    MediaStore.Files.getContentUri("external"),
+                    new String[]{"_data"}, "_data LIKE ?",
+                    new String[]{directory + "/%"}, null);
+            if (cursor != null) {
+                try {
+                    while (cursor.moveToNext()) {
+                        requestMediaScan(new String[]{
+                                cursor.getString(cursor.getColumnIndex("_data"))});
+                    }
+                } finally {
+                    cursor.close();
+                }
