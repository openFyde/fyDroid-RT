new file mode 100644
index 000000000..1347e8d1f
--- /dev/null
+++ b/src/org/chromium/arc/file_system/ArcContentUriUtils.java
@@ -0,0 +1,194 @@
+package org.chromium.arc.file_system;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.DocumentsContract;
+import android.provider.MediaStore;
+import android.util.Log;
+import java.util.regex.Pattern;
+
+class ArcContentUriUtils {
+    private static final String TAG = "ArcContentUriUtils";
+    private static final Pattern PATTERN_UUID_PATH =
+            Pattern.compile("^/(?:[0-9A-Fa-f]+(?:-[0-9A-Fa-f]+)*)/(?:.*)$");
+    private static final int[] MEDIA_TYPES = {2, 1, 3}; // audio, image, video
+
+    ArcContentUriUtils() {
+    }
+
+    static String convertArcContentUriToPath(Uri uri) {
+        String authority = uri.getAuthority();
+        if (authority == null) {
+            Log.e(TAG, "No authority is found for content URI: " + uri);
+            return null;
+        }
+        String path = uri.getPath();
+        if (path == null) {
+            Log.e(TAG, "No path is found for content URI: " + uri);
+            return null;
+        }
+        if ("org.chromium.arc.file_system.fileprovider".equals(authority)) {
+            if (path.startsWith("/download/")) {
+                return path.replaceFirst("/download/", "/storage/emulated/0/Download/");
+            }
+            if (path.startsWith("/external_files/")) {
+                return path.replaceFirst("/external_files/", "/storage/emulated/0/");
+            }
+            Log.e(TAG, "Invalid ArcFileProvider URI: " + uri);
+            return null;
+        }
+        if ("org.chromium.arc.volumeprovider".equals(authority)) {
+            if (path.startsWith("/download/")) {
+                return path.replaceFirst("/download/", "/storage/emulated/0/Download/");
+            }
+            if (path.startsWith("/external_files/")) {
+                return path.replaceFirst("/external_files/", "/storage/emulated/0/");
+            }
+            if (path.startsWith("/myfiles/")) {
+                return path.replaceFirst("/myfiles/",
+                        "/storage/0000000000000000000000000000CAFEF00D2019/");
+            }
+            if (path.startsWith("/MyDrive/root/")) {
+                return path.replaceFirst("/MyDrive/root/",
+                        "/var/run/arc/mount/GoogleDrive/MyDrive/");
+            }
+            if (path.startsWith("/MyDrive/team_drives/")) {
+                return path.replaceFirst("/MyDrive/team_drives/",
+                        "/var/run/arc/mount/GoogleDrive/SharedDrives/");
+            }
+            if (path.startsWith("/MyDrive/Computers/")) {
+                return path.replaceFirst("/MyDrive/Computers/",
+                        "/var/run/arc/mount/GoogleDrive/Computers/");
+            }
+            if (path.startsWith("/MyDrive/.files-by-id/")) {
+                return path.replaceFirst("/MyDrive/.files-by-id/",
+                        "/var/run/arc/mount/GoogleDrive/SharedWithMe/");
+            }
+            if (path.startsWith("/MyDrive/.shortcut-targets-by-id/")) {
+                return path.replaceFirst("/MyDrive/.shortcut-targets-by-id/",
+                        "/var/run/arc/mount/GoogleDrive/ShortcutsSharedWithMe/");
+            }
+            if (path.startsWith("/archive/")) {
+                return path.replaceFirst("/archive/", "/var/run/arc/mount/archive/");
+            }
+            if (path.startsWith("/smb/")) {
+                return path.replaceFirst("/smb/", "/var/run/arc/mount/smb/");
+            }
+            if (!PATTERN_UUID_PATH.matcher(path).find()) {
+                Log.e(TAG, "Invalid ArcVolumeProvider URI: " + uri);
+                return null;
+            }
+            return "/storage" + path;
+        }
+        if ("org.chromium.arc.chromecontentprovider".equals(authority)) {
+            return null;
+        }
+        Log.e(TAG, "Unknown authority: " + authority);
+        return null;
+    }
+
+    private static Uri queryMediaStoreUri(Context context, String filePath, int mediaType) {
+        Uri collection;
+        if (mediaType == 1) {
+            collection = MediaStore.Images.Media.EXTERNAL_CONTENT_URI;
+        } else if (mediaType == 2) {
+            collection = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI;
+        } else if (mediaType == 3) {
+            collection = MediaStore.Video.Media.EXTERNAL_CONTENT_URI;
+        } else {
+            Log.e(TAG, "Unexpected media type: " + mediaType);
+            return null;
+        }
+        try {
+            Cursor cursor = context.getContentResolver().query(collection,
+                    new String[]{"_data", "volume_name", "_id"},
+                    "_data LIKE ?", new String[]{filePath}, null);
+            if (cursor != null) {
+                try {
+                    if (cursor.moveToFirst()) {
+                        String volumeName = cursor.getString(
+                                cursor.getColumnIndexOrThrow("volume_name"));
+                        long id = cursor.getLong(cursor.getColumnIndexOrThrow("_id"));
+                        if (mediaType == 1) {
+                            return MediaStore.Images.Media.getContentUri(volumeName, id);
+                        } else if (mediaType == 2) {
+                            return MediaStore.Audio.Media.getContentUri(volumeName, id);
+                        } else {
+                            return MediaStore.Video.Media.getContentUri(volumeName, id);
+                        }
+                    }
+                } finally {
+                    cursor.close();
+                }
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to query from MediaStore: ", e);
+        }
+        Log.w(TAG, "No MediaStore URI is found for path: " + filePath);
+        return null;
+    }
+
+    static Uri convertArcContentUriToMediaStoreUri(Context context, Uri uri) {
+        String path = convertArcContentUriToPath(uri);
+        if (path == null) {
+            return null;
+        }
+        for (int mediaType : MEDIA_TYPES) {
+            Uri result = queryMediaStoreUri(context, path, mediaType);
+            if (result != null) {
+                return result;
+            }
+        }
+        return null;
+    }
+
+    private static String getMediaDocumentsProviderType(int mediaType) {
+        switch (mediaType) {
+            case 1: return "image";
+            case 2: return "audio";
+            case 3: return "video";
+            case 6: return "document";
+            default:
+                Log.w(TAG, "Unsupported media type: " + mediaType);
+                return null;
+        }
+    }
+
+    private static Uri getMediaDocumentsProviderUri(int mediaType, long id) {
+        String type = getMediaDocumentsProviderType(mediaType);
+        if (type == null) {
+            return null;
+        }
+        return DocumentsContract.buildDocumentUri(
+                "com.android.providers.media.documents", type + ":" + id);
+    }
+
+    static Uri convertArcContentUriToMediaDocumentsProviderUri(Context context, Uri uri) {
+        String path = convertArcContentUriToPath(uri);
+        if (path == null) {
+            return null;
+        }
+        try {
+            Cursor cursor = context.getContentResolver().query(
+                    MediaStore.Files.getContentUri("external"),
+                    new String[]{"_data", "media_type", "_id"},
+                    "_data LIKE ?", new String[]{path}, null);
+            if (cursor != null) {
+                try {
+                    if (cursor.moveToFirst()) {
+                        return getMediaDocumentsProviderUri(
+                                cursor.getInt(cursor.getColumnIndexOrThrow("media_type")),
+                                cursor.getLong(cursor.getColumnIndexOrThrow("_id")));
+                    }
+                } finally {
+                    cursor.close();
+                }
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to query from MediaStore: ", e);
+        }
+        Log.w(TAG, "No MediaDocumentsProvider URI is found for path: " + path);
+        return null;
+    }
+}
