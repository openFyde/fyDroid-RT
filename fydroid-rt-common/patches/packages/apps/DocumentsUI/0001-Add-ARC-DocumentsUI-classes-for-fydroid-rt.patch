@@ -0,0 +1,168 @@
+package org.chromium.arc.file_system;
+
+import android.app.Activity;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import com.android.documentsui.R;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.ExecutionException;
+import org.chromium.arc.FutureCallback;
+import org.chromium.arc.mojom.FileSelectorElement;
+import org.chromium.arc.mojom.FileSelectorElements;
+import org.chromium.arc.mojom.FileSelectorEvent;
+import org.chromium.arc.mojom.FileSystemHost;
+import org.chromium.arc.mojom.GetFileSelectorElementsRequest;
+
+public class ArcSelectFilesEventHandlerActivity extends Activity {
+    private static final String TAG = "ArcSelectFilesEventHandlerActivity";
+    private BroadcastReceiver mBroadcastReceiver;
+    private int mSelectFilesActivityTaskId = -1;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Intent intent = getIntent();
+        if (intent != null) {
+            mSelectFilesActivityTaskId = intent.getIntExtra(
+                    "org.chromium.arc.file_system.SELECT_FILES_ACTIVITY_TASK_ID", -1);
+        }
+        mBroadcastReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                if ("org.chromium.arc.file_system.SELECT_FILES_ACTIVITY_DESTROYED"
+                        .equals(intent.getAction())
+                        && intent.getIntExtra(
+                                "org.chromium.arc.file_system.SELECT_FILES_ACTIVITY_TASK_ID",
+                                -1) == mSelectFilesActivityTaskId) {
+                    finish();
+                }
+            }
+        };
+        registerReceiver(mBroadcastReceiver, new IntentFilter(
+                "org.chromium.arc.file_system.SELECT_FILES_ACTIVITY_DESTROYED"));
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        setContentView(R.layout.arc_select_files_event_handler_activity);
+        WindowManager.LayoutParams lp = getWindow().getAttributes();
+        lp.flags = WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL;
+        lp.format = -2; // TRANSLUCENT
+        lp.alpha = 0.0f;
+        getWindow().setAttributes(lp);
+        updateViewSynchronously();
+    }
+
+    @Override
+    public void onDestroy() {
+        unregisterReceiver(mBroadcastReceiver);
+        super.onDestroy();
+    }
+
+    private boolean updateViewSynchronously() {
+        if (isDestroyed()) return false;
+        GetFileSelectorElementsRequest request = new GetFileSelectorElementsRequest();
+        request.creatorTaskId = mSelectFilesActivityTaskId;
+        FileSystemHostHolder holder = FileSystemHostHolder.getInstance();
+        FutureCallback<FileSelectorElements> future =
+                new FutureCallback<>(holder.getCancellationRelay());
+        synchronized (holder) {
+            FileSystemHost host = holder.getLocked(11);
+            if (host == null) {
+                Log.e(TAG, "FileSystemHost is not ready.");
+                return false;
+            }
+            host.getFileSelectorElements(request, result -> future.set(result));
+            try {
+                handleFileSelectorElements(future.get());
+                return true;
+            } catch (InterruptedException | CancellationException | ExecutionException e) {
+                Log.e(TAG, "Method call failed ", e);
+                return false;
+            }
+        }
+    }
+
+    private void handleFileSelectorElements(FileSelectorElements elements) {
+        if (elements.directoryElements.length == 0
+                && elements.fileElements.length == 0) {
+            Log.e(TAG, "Finishing the activity because file selector doesn't exist.");
+            finish();
+            return;
+        }
+        TextView searchText = (TextView) findViewById(R.id.search_src_text);
+        searchText.setText(elements.searchQuery);
+
+        LinearLayout rootsList = (LinearLayout) findViewById(R.id.roots_list);
+        rootsList.removeAllViews();
+        for (FileSelectorElement dirElement : elements.directoryElements) {
+            Button button = new Button(this);
+            button.setText(dirElement.name);
+            button.setAllCaps(false);
+            button.setOnClickListener(v ->
+                    sendFileSelectorEventSynchronously(1, dirElement.name));
+            rootsList.addView(button, -1, -2);
+        }
+
+        LinearLayout dirList = (LinearLayout) findViewById(R.id.dir_list);
+        dirList.removeAllViews();
+        for (FileSelectorElement fileElement : elements.fileElements) {
+            Button button = new Button(this);
+            button.setText(fileElement.name);
+            button.setAllCaps(false);
+            button.setOnClickListener(v ->
+                    sendFileSelectorEventSynchronously(2, fileElement.name));
+            dirList.addView(button, -1, -2);
+            if (elements.searchQuery == null) {
+                searchText.setText(fileElement.name);
+            }
+        }
+    }
+
+    private boolean sendFileSelectorEventSynchronously(int type, String name) {
+        if (isDestroyed()) return false;
+        FileSelectorEvent event = new FileSelectorEvent();
+        event.type = type;
+        FileSelectorElement target = new FileSelectorElement();
+        event.clickTarget = target;
+        target.name = name;
+        event.creatorTaskId = mSelectFilesActivityTaskId;
+        FileSystemHostHolder holder = FileSystemHostHolder.getInstance();
+        synchronized (holder) {
+            FileSystemHost host = holder.getLocked(11);
+            if (host == null) {
+                Log.e(TAG, "FileSystemHost is not ready.");
+                return false;
+            }
+            Log.i(TAG, "Routing a click event to Files app: eventType=" + type
+                    + ", clickTarget=" + name);
+            host.onFileSelectorEvent(event, () -> onFileSelectorEventExecuted(type));
+            return true;
+        }
+    }
+
+    private void onFileSelectorEventExecuted(int type) {
+        if (isDestroyed()) return;
+        if (type == 1) { // directory click
+            new Handler(Looper.getMainLooper()).postDelayed(
+                    this::updateViewSynchronously, 2000);
+        } else if (type == 2) { // file click
+            new Handler(Looper.getMainLooper()).postDelayed(
+                    () -> sendFileSelectorEventSynchronously(0, ""), 16000);
+        } else if (type == 0) { // done
+            finish();
+        }
+    }
+}
