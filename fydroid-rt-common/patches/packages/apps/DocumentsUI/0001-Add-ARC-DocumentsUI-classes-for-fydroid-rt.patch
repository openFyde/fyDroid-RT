@@ -0,0 +1,97 @@
+package org.chromium.arc.file_system;
+
+import android.content.Context;
+import android.net.Uri;
+import android.provider.MediaStore;
+import android.util.Log;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import org.chromium.arc.mojom.FileSystemHost;
+import org.chromium.arc.mojom.MediaStoreDownloadMetadata;
+import org.chromium.arc.mojom.MediaStoreMetadata;
+import org.chromium.mojo_base.mojom.FilePath;
+import org.chromium.url.mojom.Url;
+
+class MediaStoreDelegate {
+    private static final String TAG = "MediaStoreDelegate";
+    private MediaStoreObserver mDownloadAddedObserver;
+
+    MediaStoreDelegate(Context context) {
+        mDownloadAddedObserver = new MediaStoreObserver(
+                MediaStore.Downloads.EXTERNAL_CONTENT_URI) {
+            private final long mCreationTimeMillis = System.currentTimeMillis();
+            private final Set<Integer> mNotifiedUris = new HashSet<>();
+
+            @Override
+            public String[] getProjection() {
+                return new String[]{"_display_name", "owner_package_name", "relative_path"};
+            }
+
+            @Override
+            public String getSelection() {
+                return String.format("(%s >= %d) AND (%s = 0) AND (%s IS NOT NULL)",
+                        "date_added",
+                        TimeUnit.MILLISECONDS.toSeconds(mCreationTimeMillis),
+                        "is_pending",
+                        "owner_package_name");
+            }
+
+            @Override
+            public void onChange(Uri uri, Map<String, String> values) {
+                if (!mNotifiedUris.add(uri.hashCode())) {
+                    return;
+                }
+                FileSystemHostHolder holder = FileSystemHostHolder.getInstance();
+                synchronized (holder) {
+                    FileSystemHost host = holder.getLocked(23);
+                    if (host == null) {
+                        Log.e(TAG, "Failed to obtain host for 'onMediaStoreUriAdded()' event.");
+                    } else {
+                        host.onMediaStoreUriAdded(toUrl(uri), toMojo(values));
+                    }
+                }
+            }
+
+            private MediaStoreMetadata toMojo(Map<String, String> values) {
+                MediaStoreMetadata metadata = new MediaStoreMetadata();
+                metadata.setDownload(new MediaStoreDownloadMetadata());
+                for (Map.Entry<String, String> entry : values.entrySet()) {
+                    switch (entry.getKey()) {
+                        case "_display_name":
+                            metadata.getDownload().displayName = entry.getValue();
+                            break;
+                        case "owner_package_name":
+                            metadata.getDownload().ownerPackageName = entry.getValue();
+                            break;
+                        case "relative_path":
+                            metadata.getDownload().relativePath = toFilePath(entry.getValue());
+                            break;
+                    }
+                }
+                return metadata;
+            }
+
+            private FilePath toFilePath(String path) {
+                FilePath filePath = new FilePath();
+                filePath.path = path;
+                return filePath;
+            }
+
+            private Url toUrl(Uri uri) {
+                Url url = new Url();
+                url.url = uri.toString();
+                return url;
+            }
+        };
+        mDownloadAddedObserver.registerWith(context.getContentResolver());
+    }
+
+    void onDestroy() {
+        if (mDownloadAddedObserver != null) {
+            mDownloadAddedObserver.unregister();
+            mDownloadAddedObserver = null;
+        }
+    }
+}
diff --git a/src/org/chromium/arc/file_system/MediaStoreObserver.java b/src/org/chromium/arc/file_system/MediaStoreObserver.java
new file mode 100644
index 000000000..df4e02460
--- /dev/null
+++ b/src/org/chromium/arc/file_system/MediaStoreObserver.java
@@ -0,0 +1,72 @@
+package org.chromium.arc.file_system;
+
+import android.content.ContentResolver;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.net.Uri;
+import android.util.Log;
+import java.util.HashMap;
+import java.util.Map;
+
+class MediaStoreObserver extends ContentObserver {
+    private static final String TAG = MediaStoreObserver.class.getSimpleName();
+    private ContentResolver mContentResolver;
+    private final Uri mRootUri;
+
+    protected String[] getProjection() {
+        return null;
+    }
+
+    protected String getSelection() {
+        return null;
+    }
+
+    protected void onChange(Uri uri, Map<String, String> values) {
+    }
+
+    MediaStoreObserver(Uri rootUri) {
+        super(null);
+        mRootUri = rootUri;
+    }
+
+    void registerWith(ContentResolver contentResolver) {
+        if (mContentResolver != null) {
+            unregister();
+        }
+        mContentResolver = contentResolver;
+        contentResolver.registerContentObserver(mRootUri, true, this);
+    }
+
+    void unregister() {
+        if (mContentResolver != null) {
+            mContentResolver.unregisterContentObserver(this);
+            mContentResolver = null;
+        }
+    }
+
+    @Override
+    public void onChange(boolean selfChange, Uri uri) {
+        super.onChange(selfChange, uri);
+        if (uri.toString().startsWith(mRootUri.toString())) {
+            try {
+                Cursor cursor = mContentResolver.query(uri, getProjection(),
+                        getSelection(), null, null);
+                if (cursor != null) {
+                    try {
+                        if (cursor.moveToFirst()) {
+                            HashMap<String, String> values = new HashMap<>();
+                            for (int i = 0; i < cursor.getColumnCount(); i++) {
+                                values.put(cursor.getColumnName(i), cursor.getString(i));
+                            }
+                            onChange(uri, values);
+                        }
+                    } finally {
+                        cursor.close();
+                    }
+                }
+            } catch (IllegalArgumentException e) {
+                Log.e(TAG, e.getMessage());
+            }
+        }
+    }
+}
diff --git a/src/org/chromium/arc/file_system/MojoAsyncTask.java b/src/org/chromium/arc/file_system/MojoAsyncTask.java
new file mode 100644
index 000000000..8f4af502d
--- /dev/null
+++ b/src/org/chromium/arc/file_system/MojoAsyncTask.java
@@ -0,0 +1,28 @@
+package org.chromium.arc.file_system;
+
+import android.util.Log;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import org.chromium.arc.bridge.ArcBridgeSupport;
+
+public abstract class MojoAsyncTask<Result> {
+    private static final String TAG = "MojoAsyncTask";
+    private static final ThreadPoolExecutor sExecutor = new ThreadPoolExecutor(
+            0, 10, 3, TimeUnit.SECONDS, new LinkedBlockingQueue<>());
+
+    protected abstract Result doInBackground();
+
+    protected abstract void onPostExecute(Result result);
+
+    public void execute() {
+        sExecutor.execute(() -> {
+            try {
+                Result result = doInBackground();
+                ArcBridgeSupport.runOnMojoThread(() -> onPostExecute(result));
+            } catch (Exception e) {
+                Log.e(TAG, "Error in MojoAsyncTask", e);
+            }
+        });
+    }
+}
diff --git a/src/org/chromium/arc/file_system/OpenUrlsHandler.java b/src/org/chromium/arc/file_system/OpenUrlsHandler.java
new file mode 100644
index 000000000..0e7612190
--- /dev/null
+++ b/src/org/chromium/arc/file_system/OpenUrlsHandler.java
@@ -0,0 +1,164 @@
+package org.chromium.arc.file_system;
+
+import android.content.ActivityNotFoundException;
+import android.content.ClipData;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Parcelable;
+import android.util.Log;
+import java.util.ArrayList;
+import java.util.Map;
+import org.chromium.arc.applauncher.IntentLauncher;
+import org.chromium.arc.mojom.ActivityName;
+import org.chromium.arc.mojom.ContentUrlWithMimeType;
+import org.chromium.arc.mojom.OpenUrlsRequest;
+import org.chromium.arc.mojom.WindowInfo;
+
+class OpenUrlsHandler {
+    private static final String TAG = "OpenUrlsHandler";
+    private static final int ACTION_VIEW = 0;
+    private static final int ACTION_SEND = 1;
+    private static final int ACTION_SEND_MULTIPLE = 2;
+    private static final int ACTION_CREATE_NOTE = 3;
+    private static final int ACTION_EDIT = 4;
+
+    private final Context mContext;
+    private final IntentLauncher mIntentLauncher;
+
+    public OpenUrlsHandler(Context context) {
+        this(context, new IntentLauncher(context));
+    }
+
+    OpenUrlsHandler(Context context, IntentLauncher intentLauncher) {
+        mContext = context;
+        mIntentLauncher = intentLauncher;
+    }
+
+    public void openUrlsWithPermission(OpenUrlsRequest request, WindowInfo windowInfo) {
+        Intent[] intents = constructIntents(request.actionType, request.urls, mContext);
+        ActivityName activityName = request.activityName;
+        for (Intent intent : intents) {
+            String activity = activityName.activityName;
+            if (activity != null && !activity.isEmpty()) {
+                intent.setComponent(new ComponentName(
+                        activityName.packageName, activityName.activityName));
+            } else {
+                intent.setPackage(activityName.packageName);
+            }
+            intent.addFlags(268435459); // FLAG_ACTIVITY_NEW_TASK | FLAG_ACTIVITY_CLEAR_TOP | FLAG_GRANT_READ_URI_PERMISSION | FLAG_GRANT_WRITE_URI_PERMISSION
+            intent.putExtra("com.android.browser.application_id", mContext.getPackageName());
+            Map<String, String> extras = request.extras;
+            if (extras != null) {
+                for (String key : extras.keySet()) {
+                    Object value = request.extras.get(key);
+                    if (value instanceof String) {
+                        intent.putExtra(key, (String) value);
+                    }
+                }
+            }
+            if (request.actionType == ACTION_EDIT
+                    && activityName.packageName.equals("com.google.android.apps.photos")) {
+                intent.putExtra("output", intent.getData());
+            }
+            try {
+                mIntentLauncher.startActivityWithWindowInfo(intent, windowInfo);
+            } catch (ActivityNotFoundException e) {
+                Log.e(TAG, "Failed to start "
+                        + (activityName.activityName != null
+                            ? activityName.packageName + "/" + activityName.activityName
+                            : activityName.packageName));
+            } catch (SecurityException e) {
+                Log.e(TAG, "Lacking permissions for intent: " + intent);
+            }
+        }
+    }
+
+    private static Intent[] constructIntents(int actionType,
+            ContentUrlWithMimeType[] urls, Context context) {
+        switch (actionType) {
+            case ACTION_VIEW: {
+                Intent[] intents = new Intent[urls.length];
+                for (int i = 0; i < urls.length; i++) {
+                    intents[i] = new Intent(Intent.ACTION_VIEW);
+                    intents[i].setDataAndType(
+                            mojoUrlToUri(context, urls[i]), urls[i].mimeType);
+                }
+                return intents;
+            }
+            case ACTION_SEND: {
+                Intent[] intents = new Intent[urls.length];
+                for (int i = 0; i < urls.length; i++) {
+                    intents[i] = new Intent(Intent.ACTION_SEND);
+                    intents[i].setType(urls[i].mimeType);
+                    intents[i].putExtra(Intent.EXTRA_STREAM,
+                            mojoUrlToUri(context, urls[i]));
+                }
+                return intents;
+            }
+            case ACTION_SEND_MULTIPLE: {
+                Intent intent = new Intent(Intent.ACTION_SEND_MULTIPLE);
+                ArrayList<Uri> uris = new ArrayList<>();
+                for (ContentUrlWithMimeType url : urls) {
+                    uris.add(mojoUrlToUri(context, url));
+                }
+                intent.putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris);
+                intent.setType(calculateCommonMimeType(urls));
+                return new Intent[]{intent};
+            }
+            case ACTION_CREATE_NOTE: {
+                if (urls.length < 1) {
+                    return new Intent[]{
+                            new Intent("org.chromium.arc.intent.action.CREATE_NOTE")};
+                }
+                Intent[] intents = new Intent[urls.length];
+                for (int i = 0; i < urls.length; i++) {
+                    intents[i] = new Intent("org.chromium.arc.intent.action.CREATE_NOTE");
+                    intents[i].setClipData(ClipData.newUri(
+                            context.getContentResolver(), "attachment",
+                            mojoUrlToUri(context, urls[i])));
+                }
+                return intents;
+            }
+            case ACTION_EDIT: {
+                Intent[] intents = new Intent[urls.length];
+                for (int i = 0; i < urls.length; i++) {
+                    intents[i] = new Intent(Intent.ACTION_EDIT);
+                    intents[i].setDataAndType(
+                            mojoUrlToUri(context, urls[i]), urls[i].mimeType);
+                }
+                return intents;
+            }
+            default:
+                throw new IllegalArgumentException("Unknown ActionType " + actionType);
+        }
+    }
+
+    private static String calculateCommonMimeType(ContentUrlWithMimeType[] urls) {
+        if (urls.length == 0) {
+            return "*/*";
+        }
+        String[] parts = urls[0].mimeType.split("/");
+        if (parts.length != 2) {
+            return "*/*";
+        }
+        for (int i = 1; i < urls.length; i++) {
+            String[] otherParts = urls[i].mimeType.split("/");
+            if (otherParts.length != 2 || !parts[0].equals(otherParts[0])) {
+                return "*/*";
+            }
+            if (!parts[1].equals(otherParts[1])) {
+                parts[1] = "*";
+            }
+        }
+        return parts[0] + "/" + parts[1];
+    }
+
+    private static Uri mojoUrlToUri(Context context, ContentUrlWithMimeType url) {
+        Uri uri = Uri.parse(url.contentUrl.url);
+        Uri mediaUri = ArcContentUriUtils.convertArcContentUriToMediaDocumentsProviderUri(
+                context, uri);
+        return mediaUri != null ? mediaUri : uri;
+    }
+}
