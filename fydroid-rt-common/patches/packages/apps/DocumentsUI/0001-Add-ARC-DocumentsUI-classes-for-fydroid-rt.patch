+package org.chromium.arc.file_system;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.graphics.Point;
+import android.media.MediaScannerConnection;
+import android.net.Uri;
+import android.os.ParcelFileDescriptor;
+import android.provider.MediaStore;
+import android.util.Log;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Paths;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+import org.chromium.arc.bridge.ArcBridgeSupport;
+import org.chromium.arc.mojom.FileSession;
+import org.chromium.arc.mojom.FileSystemHost;
+import org.chromium.arc.mojom.FileSystemInstance;
+import org.chromium.arc.mojom.OpenUrlsRequest;
+import org.chromium.arc.mojom.Size;
+import org.chromium.arc.mojom.WindowInfo;
+import org.chromium.mojo.bindings.ConnectionErrorHandler;
+import org.chromium.mojo.system.MojoException;
+import org.chromium.mojo.system.UntypedHandle;
+import org.chromium.url.mojom.Url;
+
+class FileSystemInstanceImpl implements FileSystemInstance {
+    private static final String TAG = FileSystemInstanceImpl.class.getSimpleName();
+    private final ContentProviderHandler mContentProviderHandler;
+    private final Context mContext;
+    private final DocumentsProviderHandler mDocumentsProviderHandler;
+    private final OpenUrlsHandler mOpenUrlsHandler;
+    private final AtomicLong mIdCounter = new AtomicLong(1);
+    private final Map<String, ParcelFileDescriptor> mFileSessionMap = new HashMap<>();
+
+    public FileSystemInstanceImpl(Context context) {
+        mContext = context;
+        mContentProviderHandler = new ContentProviderHandler(context);
+        mDocumentsProviderHandler = new DocumentsProviderHandler(context,
+                FileSystemHostHolder.getInstance());
+        mOpenUrlsHandler = new OpenUrlsHandler(context);
+    }
+
+    void updateRootsForTesting(String authority) {
+        mDocumentsProviderHandler.updateRootsForTesting(authority);
+    }
+
+    private String createUrlID(String url) {
+        return url + "_" + mIdCounter.incrementAndGet();
+    }
+
+    private UntypedHandle updateFileSessionMapAndGetHandle(String urlId,
+            ParcelFileDescriptor pfd) {
+        int fd = pfd.getFd();
+        UntypedHandle handle = null;
+        try {
+            handle = ArcBridgeSupport.getInstance().convertFileDescriptorToMojoHandle(
+                    pfd.dup().detachFd());
+        } catch (IOException | NullPointerException e) {
+            Log.e(TAG, "Failed to open file to write for fd: " + fd, e);
+            return null;
+        }
+        if (handle == null) {
+            Log.e(TAG, "Failed to obtain mojo handle from fd: " + fd);
+            try {
+                pfd.close();
+            } catch (IOException e) {
+                // ignore
+            }
+            return null;
+        }
+        synchronized (this) {
+            if (mFileSessionMap.containsKey(urlId)) {
+                Log.wtf(TAG, "Unexpected FileSession map already contains ID: " + fd);
+                try {
+                    pfd.close();
+                } catch (IOException e) {
+                    // ignore
+                }
+                return null;
+            }
+            mFileSessionMap.put(urlId, pfd);
+        }
+        return handle;
+    }
+
+    @Override
+    public void onConnectionError(MojoException e) {
+        Log.e(TAG, "Mojo connection error.", e);
+    }
+
+    @Override
+    public void close() {
+        Log.i(TAG, "Mojo connection closed.");
+    }
+
+    @Override
+    public void init(FileSystemHost host, InitResponse callback) {
+        ArcBridgeSupport.buildThreadSafeProxy(host, FileSystemHost.MANAGER,
+                (ConnectionErrorHandler) null,
+                (proxy, version) -> FileSystemHostHolder.getInstance().set(
+                        proxy, version, callback));
