+package org.chromium.arc.display;
+
+import android.os.Parcel;
+import android.os.Parcelable;
+
+public class ArcDisplay implements Parcelable {
+    public long physicalDisplayId;
+    public int globalPositionX;
+    public int globalPositionY;
+    public int widthPixels;
+    public int heightPixels;
+    public int transform;
+    public int insetsLeft;
+    public int insetsTop;
+    public int insetsRight;
+    public int insetsBottom;
+    public int stableInsetsLeft;
+    public int stableInsetsTop;
+    public int stableInsetsRight;
+    public int stableInsetsBottom;
+    public boolean autoHide;
+    public float deviceScaleFactor;
+    public int dpi;
+    public int overrideDpi;
+    public boolean displayRemapped;
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public final void writeToParcel(Parcel parcel, int flags) {
+        int startPos = parcel.dataPosition();
+        parcel.writeInt(0); // placeholder for length
+        parcel.writeLong(physicalDisplayId);
+        parcel.writeInt(globalPositionX);
+        parcel.writeInt(globalPositionY);
+        parcel.writeInt(widthPixels);
+        parcel.writeInt(heightPixels);
+        parcel.writeInt(transform);
+        parcel.writeInt(insetsLeft);
+        parcel.writeInt(insetsTop);
+        parcel.writeInt(insetsRight);
+        parcel.writeInt(insetsBottom);
+        parcel.writeInt(stableInsetsLeft);
+        parcel.writeInt(stableInsetsTop);
+        parcel.writeInt(stableInsetsRight);
+        parcel.writeInt(stableInsetsBottom);
+        parcel.writeInt(autoHide ? 1 : 0);
+        parcel.writeFloat(deviceScaleFactor);
+        parcel.writeInt(dpi);
+        parcel.writeInt(overrideDpi);
+        parcel.writeInt(displayRemapped ? 1 : 0);
+        int endPos = parcel.dataPosition();
+        parcel.setDataPosition(startPos);
+        parcel.writeInt(endPos - startPos);
+        parcel.setDataPosition(endPos);
+    }
+
+    public final void readFromParcel(Parcel parcel) {
+        int startPos = parcel.dataPosition();
+        int length = parcel.readInt();
+        if (length < 0) {
+            return;
+        }
+        try {
+            physicalDisplayId = parcel.readLong();
+            if (parcel.dataPosition() - startPos >= length) return;
+            globalPositionX = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            globalPositionY = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            widthPixels = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            heightPixels = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            transform = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            insetsLeft = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            insetsTop = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            insetsRight = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            insetsBottom = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            stableInsetsLeft = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            stableInsetsTop = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            stableInsetsRight = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            stableInsetsBottom = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            autoHide = parcel.readInt() != 0;
+            if (parcel.dataPosition() - startPos >= length) return;
+            deviceScaleFactor = parcel.readFloat();
+            if (parcel.dataPosition() - startPos >= length) return;
+            dpi = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            overrideDpi = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            displayRemapped = parcel.readInt() != 0;
+        } finally {
+            parcel.setDataPosition(startPos + length);
+        }
+    }
+
+    public static final Creator<ArcDisplay> CREATOR = new Creator<ArcDisplay>() {
+        @Override
+        public ArcDisplay createFromParcel(Parcel parcel) {
+            ArcDisplay display = new ArcDisplay();
+            display.readFromParcel(parcel);
+            return display;
+        }
+
+        @Override
+        public ArcDisplay[] newArray(int size) {
+            return new ArcDisplay[size];
+        }
+    };
+}
