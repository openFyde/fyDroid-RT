+package org.chromium.arc.file_system;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.os.Binder;
+import android.os.ParcelFileDescriptor;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.util.Log;
+import android.webkit.MimeTypeMap;
+import com.android.server.arc.data_device.IArcDataDeviceProviderService;
+import java.io.File;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.regex.Pattern;
+
+public class ArcVolumeProvider extends ContentProvider {
+    private static final String TAG = "ArcVolumeProvider";
+    private static final String[] SUPPORTED_QUERY_COLUMNS = {
+            "_display_name", "_size", "document_id", "mime_type", "last_modified", "flags"};
+    private static final Pattern PATTERN_UUID_PATH =
+            Pattern.compile("^/([0-9A-Fa-f]+(-[0-9A-Fa-f]+)*)/(.*)$");
+
+    private File mStorageDirectory = new File("/storage");
+    private File mSdCardDirectory = new File("/storage/emulated/0");
+    private File mDrivefsDirectory = new File("/var/run/arc/mount/GoogleDrive");
+    private final AtomicReference<IArcDataDeviceProviderService> mDataDeviceProviderService =
+            new AtomicReference<>();
+
+    void setStorageDirectoryForTest(File dir) { mStorageDirectory = dir; }
+    void setSdCardDirectoryForTest(File dir) { mSdCardDirectory = dir; }
+    void setDrivefsDirectoryForTest(File dir) { mDrivefsDirectory = dir; }
+
+    @Override
+    public boolean onCreate() {
+        mDataDeviceProviderService.set(IArcDataDeviceProviderService.Stub.asInterface(
+                ServiceManager.getService("arc_data_device_provider_service")));
+        return true;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection,
+            String[] selectionArgs, String sortOrder) {
+        if (projection == null) {
+            projection = SUPPORTED_QUERY_COLUMNS;
+        }
+        MatrixCursor cursor = new MatrixCursor(projection);
+        try {
+            File file = createFileForPath(uri.getPath());
+            MatrixCursor.RowBuilder row = cursor.newRow();
+            for (String column : projection) {
+                switch (column) {
+                    case "_display_name":
+                        row.add(column, file.getName());
+                        break;
+                    case "_size":
+                        row.add(column, file.length());
+                        break;
+                    case "document_id":
+                        row.add(column, uri.getPath());
+                        break;
+                    case "mime_type":
+                        row.add(column, getType(uri));
+                        break;
+                    case "last_modified":
+                        row.add(column, file.lastModified());
+                        break;
+                    case "flags":
+                        row.add(column, 0);
+                        break;
+                }
+            }
+        } catch (FileNotFoundException e) {
+            Log.e(TAG, "File not found: " + uri, e);
+        }
+        return cursor;
+    }
+
+    @Override
+    public ParcelFileDescriptor openFile(Uri uri, String mode) throws FileNotFoundException {
+        try {
+            IArcDataDeviceProviderService service = mDataDeviceProviderService.get();
+            if (service != null) {
+                service.notifyContentProviderAccess(uri.toString(), Binder.getCallingUid());
+            }
+        } catch (RemoteException e) {
+            Log.e(TAG, "Failed to call notifyContentProviderAccess", e);
+        }
+        try {
+            return ParcelFileDescriptor.open(
+                    createFileForPath(uri.getPath()),
+                    ParcelFileDescriptor.parseMode(mode));
+        } catch (IllegalArgumentException e) {
+            throw new FileNotFoundException("Cannot open " + uri + " with mode " + mode);
+        }
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        try {
+            String extension = MimeTypeMap.getFileExtensionFromUrl(
+                    Uri.fromFile(createFileForPath(uri.getPath())).toString());
+            String type = MimeTypeMap.getSingleton().getMimeTypeFromExtension(extension);
+            return type != null ? type : "application/octet-stream";
+        } catch (FileNotFoundException e) {
+            return null;
+        }
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        return 0;
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        return null;
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection,
+            String[] selectionArgs) {
+        return 0;
+    }
+
+    File createFileForPath(String path) throws FileNotFoundException {
+        File base;
+        if (path.startsWith("/MyDrive/root/")) {
+            base = mDrivefsDirectory;
+            path = path.replaceFirst("/root", "");
+        } else if (path.startsWith("/MyDrive/team_drives/")) {
+            base = mDrivefsDirectory;
+            path = path.replaceFirst("/MyDrive/team_drives", "/SharedDrives");
+        } else if (path.startsWith("/MyDrive/Computers/")) {
+            base = mDrivefsDirectory;
+            path = path.replaceFirst("/MyDrive/Computers", "/Computers");
+        } else if (path.startsWith("/MyDrive/.files-by-id/")) {
+            base = mDrivefsDirectory;
+            path = path.replaceFirst("/MyDrive/.files-by-id", "/SharedWithMe");
+        } else if (path.startsWith("/MyDrive/.shortcut-targets-by-id/")) {
+            base = mDrivefsDirectory;
+            path = path.replaceFirst("/MyDrive/.shortcut-targets-by-id",
+                    "/ShortcutsSharedWithMe");
+        } else if (path.startsWith("/download/")) {
+            base = mSdCardDirectory;
+            path = path.replaceFirst("/download", "/Download");
+        } else if (path.startsWith("/external_files/")) {
+            base = mSdCardDirectory;
+            path = path.replaceFirst("/external_files", "");
+        } else if (path.startsWith("/myfiles/")) {
+            base = mStorageDirectory;
+            path = path.replaceFirst("myfiles",
+                    "0000000000000000000000000000CAFEF00D2019");
+        } else if (path.startsWith("/archive/")) {
+            base = new File("/var/run/arc/mount/archive");
+            path = path.replaceFirst("/archive", "");
+        } else if (path.startsWith("/smb/")) {
+            base = new File("/var/run/arc/mount/SMB");
+            path = path.replaceFirst("/smb", "");
+        } else {
+            if (!PATTERN_UUID_PATH.matcher(path).find()) {
+                throw new FileNotFoundException("Invalid path " + path);
+            }
+            base = mStorageDirectory;
+        }
+        try {
+            File canonical = new File(base, path).getCanonicalFile();
+            if (canonical.getPath().startsWith(base.toString() + "/")) {
+                return canonical;
+            }
+            throw new FileNotFoundException("Invalid path " + path);
+        } catch (IOException e) {
+            throw (FileNotFoundException)
+                    new FileNotFoundException("Error when resolving " + path).initCause(e);
+        }
+    }
+}
diff --git a/src/org/chromium/arc/file_system/ChromeContentProvider.java b/src/org/chromium/arc/file_system/ChromeContentProvider.java
