@@ -0,0 +1,61 @@
+package org.chromium.arc.applauncher;
+
+import android.os.Parcel;
+import android.os.Parcelable;
+
+public class AppShortcutItemInfo implements Parcelable {
+    public String shortcutId;
+    public String shortLabel;
+    public boolean isAdaptiveIcon;
+    public byte[] iconPng;
+    public byte[] foregroundIconPng;
+    public byte[] backgroundIconPng;
+    public String packageName;
+    public int type;
+    public int rank;
+
+    public AppShortcutItemInfo() {
+    }
+
+    protected AppShortcutItemInfo(Parcel in) {
+        shortcutId = in.readString();
+        shortLabel = in.readString();
+        isAdaptiveIcon = in.readInt() != 0;
+        iconPng = in.createByteArray();
+        foregroundIconPng = in.createByteArray();
+        backgroundIconPng = in.createByteArray();
+        packageName = in.readString();
+        type = in.readInt();
+        rank = in.readInt();
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+        dest.writeString(shortcutId);
+        dest.writeString(shortLabel);
+        dest.writeInt(isAdaptiveIcon ? 1 : 0);
+        dest.writeByteArray(iconPng);
+        dest.writeByteArray(foregroundIconPng);
+        dest.writeByteArray(backgroundIconPng);
+        dest.writeString(packageName);
+        dest.writeInt(type);
+        dest.writeInt(rank);
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    public static final Creator<AppShortcutItemInfo> CREATOR = new Creator<AppShortcutItemInfo>() {
+        @Override
+        public AppShortcutItemInfo createFromParcel(Parcel in) {
+            return new AppShortcutItemInfo(in);
+        }
+
+        @Override
+        public AppShortcutItemInfo[] newArray(int size) {
+            return new AppShortcutItemInfo[size];
+        }
+    };
+}
