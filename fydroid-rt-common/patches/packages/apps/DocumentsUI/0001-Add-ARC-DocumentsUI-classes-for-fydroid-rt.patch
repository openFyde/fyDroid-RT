@@ -0,0 +1,36 @@
+package org.chromium.arc.applauncher;
+
+public class ChromeWindowState {
+    public static final int kNull = -1;
+    public static final int kDefault = 0;
+    public static final int kNormal = 1;
+    public static final int kMinimized = 2;
+    public static final int kMaximized = 3;
+    public static final int kInactive = 4;
+    public static final int kFullscreen = 5;
+    public static final int kLeftSnapped = 6;
+    public static final int kRightSnapped = 7;
+    public static final int kTrustedPinned = 8;
+    public static final int kPinned = 9;
+    public static final int kFloated = 10;
+    public static final int kPip = 11;
+
+    public static String toString(int state) {
+        switch (state) {
+            case kNull: return "kNull";
+            case kDefault: return "kDefault";
+            case kNormal: return "kNormal";
+            case kMinimized: return "kMinimized";
+            case kMaximized: return "kMaximized";
+            case kInactive: return "kInactive";
+            case kFullscreen: return "kFullscreen";
+            case kLeftSnapped: return "kLeftSnapped";
+            case kRightSnapped: return "kRightSnapped";
+            case kTrustedPinned: return "kTrustedPinned";
+            case kPinned: return "kPinned";
+            case kFloated: return "kFloated";
+            case kPip: return "kPip";
+            default: return "Unknown(" + state + ")";
+        }
+    }
+}
diff --git a/src/org/chromium/arc/applauncher/IntentLauncher.java b/src/org/chromium/arc/applauncher/IntentLauncher.java
new file mode 100644
index 000000000..721a3155f
--- /dev/null
+++ b/src/org/chromium/arc/applauncher/IntentLauncher.java
@@ -0,0 +1,66 @@
+package org.chromium.arc.applauncher;
+
+import android.app.ActivityOptions;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Log;
+import org.chromium.arc.applauncher.util.DisplayIdTranslator;
+import org.chromium.arc.mojom.Rect;
+import org.chromium.arc.mojom.WindowInfo;
+
+public class IntentLauncher {
+    private static final String TAG = "ArcIntentLauncher";
+    private Context mContext;
+    private final DisplayIdTranslator mDisplayIdTranslator;
+
+    public IntentLauncher(Context context) {
+        this(context, new DisplayIdTranslator(context));
+    }
+
+    public IntentLauncher(Context context, DisplayIdTranslator displayIdTranslator) {
+        mContext = context;
+        mDisplayIdTranslator = displayIdTranslator;
+    }
+
+    public int translateChromeDisplayId(long chromeDisplayId) {
+        return mDisplayIdTranslator.translate(chromeDisplayId);
+    }
+
+    public void startActivityWithWindowInfo(Intent intent, WindowInfo windowInfo) {
+        ActivityOptions options = ActivityOptions.makeBasic();
+        int displayId = translateChromeDisplayId(windowInfo.displayId);
+        if (displayId != -1) {
+            options.setLaunchDisplayId(displayId);
+        }
+        if (windowInfo.bounds != null) {
+            Rect rect = windowInfo.bounds;
+            options.setLaunchBounds(
+                    new android.graphics.Rect(rect.left, rect.top, rect.right, rect.bottom));
+        }
+        if (windowInfo.windowId > 0) {
+            intent.setIdentifier("window_session_id=" + windowInfo.windowId);
+        }
+        int state = windowInfo.state;
+        if (state != -1) {
+            if (state == ChromeWindowState.kDefault) {
+                options.setLaunchWindowingMode(0);
+            } else if (state == ChromeWindowState.kNormal) {
+                options.setLaunchWindowingMode(5); // FREEFORM
+            } else if (state == ChromeWindowState.kMinimized) {
+                options.setAvoidMoveToFront();
+            } else if (state == ChromeWindowState.kMaximized
+                    || state == ChromeWindowState.kFullscreen) {
+                options.setLaunchWindowingMode(1); // FULLSCREEN
+            } else {
+                Log.w(TAG, "launch intent with unsupported window state: "
+                        + ChromeWindowState.toString(windowInfo.state));
+            }
+        } else if (windowInfo.windowId > 1000000000) {
+            return;
+        } else {
+            Log.w(TAG, "Launch intent with closed state but no ARC ghost window");
+        }
+        mContext.startActivity(intent, options.toBundle());
+        Log.i(TAG, "Activity launched for " + intent.toUri(0));
+    }
+}
diff --git a/src/org/chromium/arc/applauncher/util/DisplayIdTranslator.java b/src/org/chromium/arc/applauncher/util/DisplayIdTranslator.java
new file mode 100644
index 000000000..dbfa45065
--- /dev/null
+++ b/src/org/chromium/arc/applauncher/util/DisplayIdTranslator.java
@@ -0,0 +1,89 @@
+package org.chromium.arc.applauncher.util;
+
+import android.content.Context;
+import android.hardware.display.DisplayManager;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.util.Log;
+import android.view.Display;
+import android.view.DisplayAddress;
+import java.util.NoSuchElementException;
+import org.chromium.arc.wayland.IWaylandService;
+
+public class DisplayIdTranslator implements DisplayManager.DisplayListener {
+    private static final String TAG = "DisplayIdTranslator";
+    private final DisplayManager mDisplayManager;
+    private Display[] mDisplays;
+    private IWaylandService mWaylandService;
+    private final Object mLock = new Object();
+
+    public DisplayIdTranslator(Context context) {
+        mDisplayManager = (DisplayManager) context.getSystemService(Context.DISPLAY_SERVICE);
+        mDisplays = mDisplayManager.getDisplays();
+        mDisplayManager.registerDisplayListener(this, new Handler(Looper.getMainLooper()));
+    }
+
+    public int translate(long chromeDisplayId) {
+        if (chromeDisplayId == -1) {
+            return -1;
+        }
+        if (chromeDisplayId == 255) {
+            return 0;
+        }
+        synchronized (mLock) {
+            IWaylandService service = getWaylandService();
+            if (service == null) {
+                Log.e(TAG, "Failed to get Wayland service");
+                return -1;
+            }
+            try {
+                return getLogicalDisplayId(service.translateDisplayId(chromeDisplayId));
+            } catch (RemoteException | NoSuchElementException e) {
+                Log.e(TAG, "Failed translating display ID " + chromeDisplayId);
+                return -1;
+            }
+        }
+    }
+
+    private IWaylandService getWaylandService() {
+        if (mWaylandService == null) {
+            IBinder binder = ServiceManager.getService("Wayland");
+            if (binder != null) {
+                mWaylandService = IWaylandService.Stub.asInterface(binder);
+            }
+        }
+        return mWaylandService;
+    }
+
+    private int getLogicalDisplayId(long physicalId) {
+        DisplayAddress.Physical physical = DisplayAddress.fromPhysicalDisplayId(physicalId);
+        for (Display display : mDisplays) {
+            if (physical.equals(display.getAddress())) {
+                return display.getDisplayId();
+            }
+        }
+        Log.e(TAG, "Unknown physical display ID " + physicalId);
+        return -1;
+    }
+
+    @Override
+    public void onDisplayAdded(int displayId) {
+        synchronized (mLock) {
+            mDisplays = mDisplayManager.getDisplays();
+        }
+    }
+
+    @Override
+    public void onDisplayRemoved(int displayId) {
+        synchronized (mLock) {
+            mDisplays = mDisplayManager.getDisplays();
+        }
+    }
+
+    @Override
+    public void onDisplayChanged(int displayId) {
+    }
+}
