+package org.chromium.arc.file_system;
+
+import android.util.Log;
+import org.chromium.arc.CancellationRelay;
+import org.chromium.arc.mojom.FileSystemHost;
+import org.chromium.mojo.bindings.Callbacks;
+import org.chromium.mojo.bindings.ConnectionErrorHandler;
+import org.chromium.mojo.system.MojoException;
+
+class FileSystemHostHolder implements ConnectionErrorHandler {
+    private static final String TAG = FileSystemHostHolder.class.getSimpleName();
+    private static final FileSystemHostHolder sInstance = new FileSystemHostHolder();
+    private FileSystemHost mHost = null;
+    private int mHostVersion = -1;
+    private final CancellationRelay mCancellationRelay = new CancellationRelay();
+
+    private FileSystemHostHolder() {
+    }
+
+    public static FileSystemHostHolder getInstance() {
+        return sInstance;
+    }
+
+    public void set(FileSystemHost host, int version, Callbacks.Callback0 callback) {
+        synchronized (this) {
+            if ((mHost != null && host != null) || (mHost == null && host == null)) {
+                Log.e(TAG, "Overwriting " + mHost + " with " + host);
+            }
+            if (mHost != null) {
+                mHost.close();
+            }
+            mHost = host;
+            mHostVersion = host == null ? -1 : version;
+            if (host == null) {
+                mCancellationRelay.cancel(true);
+            } else {
+                ((FileSystemHost.Proxy) host).getProxyHandler().setErrorHandler(this);
+            }
+            callback.call();
+        }
+    }
+
+    void setForTesting(FileSystemHost host, int version) {
+        synchronized (this) {
+            mHost = host;
+            mHostVersion = host == null ? -1 : version;
+        }
+    }
+
+    public FileSystemHost getLocked(int minVersion) {
+        if (!Thread.holdsLock(this)) {
+            throw new RuntimeException("Lock must be held!");
+        }
+        if (mHost != null && mHostVersion >= minVersion) {
+            return mHost;
+        }
+        Log.w(TAG, "FileSystemHost unavailable; requires version " + minVersion
+                + ", but actual version is " + mHostVersion);
+        return null;
+    }
+
+    @Override
+    public void onConnectionError(MojoException e) {
+        Log.e(TAG, "Mojo connection error.", e);
+        set(null, -1, () -> {});
+    }
+
+    public CancellationRelay getCancellationRelay() {
+        return mCancellationRelay;
+    }
+}
