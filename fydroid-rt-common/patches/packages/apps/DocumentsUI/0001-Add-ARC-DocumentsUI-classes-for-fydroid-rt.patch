--- /dev/null
+++ b/src/org/chromium/arc/file_system/DocumentsProviderRoots.java
@@ -0,0 +1,443 @@
+package org.chromium.arc.file_system;
+
+import android.content.BroadcastReceiver;
+import android.content.ContentProviderClient;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageManager;
+import android.content.pm.ProviderInfo;
+import android.content.pm.ResolveInfo;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.drawable.BitmapDrawable;
+import android.graphics.drawable.Drawable;
+import android.net.Uri;
+import android.os.DeadObjectException;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.RemoteException;
+import android.provider.DocumentsContract;
+import android.util.Log;
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import libcore.io.IoUtils;
+import org.chromium.arc.mojom.ArcBitmap;
+import org.chromium.arc.mojom.Root;
+import org.chromium.arc.mojom.RootSize;
+
+final class DocumentsProviderRoots {
+    private static final Set<String> AUTHORITIES_TO_AVOID_CACHING = Set.of(
+            "com.android.externalstorage.documents",
+            "com.android.providers.downloads.documents",
+            "com.android.providers.media.documents",
+            "com.google.android.apps.docs.storage");
+    private static final String TAG = "DocumentsProviderRoots";
+
+    private final Context mContext;
+    private final ArrayList<Observer> mObservers = new ArrayList<>();
+    private final Object mCachedRootsLock = new Object();
+    private TreeMap<String, ArrayList<Root>> mCachedRoots = new TreeMap<>();
+    private final ContentObserver mRootsChangedObserver = new RootsChangedObserver();
+    private final Set<String> mObservedAuthorities = new HashSet<>();
+    private final BroadcastReceiver mPackageReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            Uri data = intent.getData();
+            new UpdateRootsTaskForPackage(
+                    data != null ? data.getSchemeSpecificPart() : null).executeOnExecutor();
+        }
+    };
+
+    public interface Observer {
+        void onRootsChanged();
+    }
+
+    private class RootsChangedObserver extends ContentObserver {
+        public RootsChangedObserver() {
+            super(new Handler(Looper.getMainLooper()));
+        }
+
+        @Override
+        public void onChange(boolean selfChange, Uri uri) {
+            if (uri == null) {
+                Log.w(TAG, "Received onChange event for null url. Skipping.");
+                return;
+            }
+            if (AUTHORITIES_TO_AVOID_CACHING.contains(uri.getAuthority())) {
+                return;
+            }
+            new UpdateRootsTaskForAuthority(uri.getAuthority()).executeOnExecutor();
+        }
+    }
+
+    public DocumentsProviderRoots(Context context) {
+        mContext = context;
+    }
+
+    public void updateRootsForAuthorityForTesting(String authority) {
+        try {
+            new UpdateRootsTaskForAuthority(authority).execute().get();
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to update roots from " + authority, e);
+        }
+    }
+
+    public void startMonitoring() {
+        registerPackageReceiver();
+        new UpdateRootsTaskForPackage(null).executeOnExecutor();
+    }
+
+    public void stopMonitoring() {
+        if (!mObservedAuthorities.isEmpty()) {
+            mContext.getContentResolver().unregisterContentObserver(mRootsChangedObserver);
+            mObservedAuthorities.clear();
+        }
+        mContext.unregisterReceiver(mPackageReceiver);
+    }
+
+    public void registerObserver(Observer observer) {
+        mObservers.add(observer);
+    }
+
+    public void unregisterObserver(Observer observer) {
+        mObservers.remove(observer);
+    }
+
+    public Root[] getRoots() {
+        ArrayList<Root> allRoots = new ArrayList<>();
+        synchronized (mCachedRootsLock) {
+            for (String key : mCachedRoots.keySet()) {
+                allRoots.addAll(mCachedRoots.get(key));
+            }
+        }
+        return allRoots.toArray(new Root[0]);
+    }
+
+    public RootSize getRootSize(String authority, String rootId) {
+        ContentResolver resolver = mContext.getContentResolver();
+        Cursor cursor = null;
+        try {
+            cursor = getCursorForUri(resolver,
+                    DocumentsContract.buildRootsUri(authority), authority,
+                    new String[]{"root_id", "available_bytes", "capacity_bytes"});
+            if (cursor == null) {
+                return null;
+            }
+            int rootIdCol = cursor.getColumnIndexOrThrow("root_id");
+            int availCol = cursor.getColumnIndex("available_bytes");
+            int capacityCol = cursor.getColumnIndex("capacity_bytes");
+            while (cursor.moveToNext()) {
+                if (rootId.equals(cursor.getString(rootIdCol))) {
+                    RootSize size = new RootSize();
+                    size.availableBytes = availCol >= 0 ? cursor.getLong(availCol) : -1L;
+                    size.capacityBytes = capacityCol >= 0 ? cursor.getLong(capacityCol) : -1L;
+                    return size;
+                }
+            }
+        } catch (IllegalArgumentException e) {
+            Log.e(TAG, "Required root column is missing.");
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to load root from " + authority, e);
+        } finally {
+            IoUtils.closeQuietly(cursor);
+        }
+        return null;
+    }
+
+    private class UpdateRootsTaskForPackage {
+        private boolean mIsCacheModified = false;
+        private final String mPackageName;
+
+        public UpdateRootsTaskForPackage(String packageName) {
+            mPackageName = packageName;
+        }
+
+        public void executeOnExecutor() {
+            ExecutorService executor = Executors.newSingleThreadExecutor();
+            Handler handler = new Handler(Looper.getMainLooper());
+            executor.execute(() -> {
+                TreeMap<String, ArrayList<Root>> newRoots = new TreeMap<>();
+                ArrayList<String> unchangedAuthorities = new ArrayList<>();
+                for (ResolveInfo info : mContext.getPackageManager()
+                        .queryIntentContentProviders(
+                                new Intent("android.content.action.DOCUMENTS_PROVIDER"), 0)) {
+                    ProviderInfo providerInfo = info.providerInfo;
+                    String authority = providerInfo.authority;
+                    if (authority == null
+                            || AUTHORITIES_TO_AVOID_CACHING.contains(authority)) {
+                        continue;
+                    }
+                    if (mPackageName == null
+                            || mPackageName.equals(providerInfo.packageName)) {
+                        ArrayList<Root> roots = loadRootsForAuthority(authority);
+                        if (roots != null) {
+                            newRoots.put(authority, roots);
+                        }
+                    } else {
+                        unchangedAuthorities.add(authority);
+                    }
+                }
+                synchronized (mCachedRootsLock) {
+                    for (String auth : unchangedAuthorities) {
+                        ArrayList<Root> existing = mCachedRoots.get(auth);
+                        if (existing != null) {
+                            newRoots.put(auth, existing);
+                        }
+                    }
+                    if (!isSameRoots(mCachedRoots, newRoots)) {
+                        mCachedRoots = newRoots;
+                        mIsCacheModified = true;
+                    }
+                }
+                handler.post(() -> {
+                    if (mIsCacheModified) {
+                        notifyRootsChanged();
+                    }
+                });
+            });
+        }
+    }
+
+    private class UpdateRootsTaskForAuthority {
+        private final String mAuthority;
+        private boolean mIsCacheModified = false;
+        private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+        private final Runnable mUpdateRootsRunnable;
+
+        public UpdateRootsTaskForAuthority(String authority) {
+            mAuthority = authority;
+            Handler handler = new Handler(Looper.getMainLooper());
+            mUpdateRootsRunnable = () -> {
+                ArrayList<Root> roots = loadRootsForAuthority(mAuthority);
+                synchronized (mCachedRootsLock) {
+                    if (!isSameRoots(mCachedRoots.get(mAuthority), roots)) {
+                        if (roots == null) {
+                            mCachedRoots.remove(mAuthority);
+                        } else {
+                            mCachedRoots.put(mAuthority, roots);
+                        }
+                        mIsCacheModified = true;
+                    }
+                }
+                handler.post(() -> {
+                    if (mIsCacheModified) {
+                        notifyRootsChanged();
+                    }
+                });
+            };
+        }
+
+        public void executeOnExecutor() {
+            mExecutor.execute(mUpdateRootsRunnable);
+        }
+
+        public Future<?> execute() {
+            return mExecutor.submit(mUpdateRootsRunnable);
+        }
+    }
+
+    ArrayList<Root> loadRootsForAuthority(String authority) {
+        ArrayList<Root> roots = new ArrayList<>();
+        ContentResolver resolver = mContext.getContentResolver();
+        ProviderInfo providerInfo = getProviderInfo(resolver,
+                mContext.getPackageManager(), authority);
+        if (providerInfo == null) {
+            return null;
+        }
+        Uri rootsUri = DocumentsContract.buildRootsUri(authority);
+        if (!mObservedAuthorities.contains(authority)) {
+            mContext.getContentResolver().registerContentObserver(
+                    rootsUri, true, mRootsChangedObserver);
+            mObservedAuthorities.add(authority);
+        }
+        Cursor cursor = null;
+        try {
+            cursor = getCursorForUri(resolver, rootsUri, authority,
+                    new String[]{"root_id", "document_id", "title", "summary",
+                            "icon", "flags", "mime_types"});
+            if (cursor == null) {
+                return null;
+            }
+            int rootIdCol = cursor.getColumnIndexOrThrow("root_id");
+            int docIdCol = cursor.getColumnIndexOrThrow("document_id");
+            int titleCol = cursor.getColumnIndexOrThrow("title");
+            int summaryCol = cursor.getColumnIndex("summary");
+            int iconCol = cursor.getColumnIndexOrThrow("icon");
+            int flagsCol = cursor.getColumnIndexOrThrow("flags");
+            int mimeCol = cursor.getColumnIndex("mime_types");
+            while (cursor.moveToNext()) {
+                Root root = new Root();
+                root.authority = authority;
+                root.rootId = cursor.getString(rootIdCol);
+                root.documentId = cursor.getString(docIdCol);
+                root.title = cursor.getString(titleCol);
+                root.summary = summaryCol >= 0 ? cursor.getString(summaryCol) : null;
+                root.icon = createRootIcon(
+                        iconCol >= 0 ? cursor.getInt(iconCol) : 0, providerInfo);
+                root.supportsCreate = (cursor.getInt(flagsCol) & 1) != 0;
+                String mimeTypes = mimeCol >= 0 ? cursor.getString(mimeCol) : null;
+                if (mimeTypes != null) {
+                    root.mimeTypes = mimeTypes.split("\n");
+                }
+                roots.add(root);
+            }
+        } catch (IllegalArgumentException e) {
+            Log.e(TAG, "Required column(s) are missing.");
+            IoUtils.closeQuietly(cursor);
+            return null;
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to load some roots from " + authority, e);
+            if (roots.isEmpty()) roots = null;
+        } finally {
+            IoUtils.closeQuietly(cursor);
+        }
+        return (roots != null && roots.isEmpty()) ? null : roots;
+    }
+
+    private static Cursor getCursorForUri(ContentResolver resolver, Uri uri,
+            String authority, String[] projection) {
+        ContentProviderClient client = null;
+        try {
+            client = acquireUnstableProviderOrThrow(resolver, authority);
+            Cursor cursor;
+            try {
+                cursor = client.query(uri, projection, null, null, null);
+            } catch (DeadObjectException e) {
+                IoUtils.closeQuietly(client);
+                client = acquireUnstableProviderOrThrow(resolver, authority);
+                cursor = client.query(uri, projection, null, null, null);
+            }
+            IoUtils.closeQuietly(client);
+            return cursor;
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to get cursor for Uri from " + authority, e);
+            IoUtils.closeQuietly(client);
+            return null;
+        }
+    }
+
+    private static ProviderInfo getProviderInfo(ContentResolver resolver,
+            PackageManager pm, String authority) {
+        ProviderInfo info = pm.resolveContentProvider(authority, 128);
+        if (info == null) {
+            Log.w(TAG, "Failed to get provider info for " + authority);
+            return null;
+        }
+        if (!info.exported) {
+            Log.w(TAG, "Provider is not exported. Failed to load roots for " + authority);
+            return null;
+        }
+        if (!info.grantUriPermissions) {
+            Log.w(TAG, "Provider doesn't grantUriPermissions. Failed to load roots for "
+                    + authority);
+            return null;
+        }
+        if (!"android.permission.MANAGE_DOCUMENTS".equals(info.readPermission)
+                || !"android.permission.MANAGE_DOCUMENTS".equals(info.writePermission)) {
+            Log.w(TAG, "Provider is not protected by MANAGE_DOCUMENTS. "
+                    + "Failed to load roots for " + authority);
+            return null;
+        }
+        return info;
+    }
+
+    private static ContentProviderClient acquireUnstableProviderOrThrow(
+            ContentResolver resolver, String authority) throws RemoteException {
+        ContentProviderClient client =
+                resolver.acquireUnstableContentProviderClient(authority);
+        if (client == null) {
+            throw new RemoteException("Failed to acquire provider for " + authority);
+        }
+        client.setDetectNotResponding(20000);
+        return client;
+    }
+
+    private ArcBitmap createRootIcon(int iconRes, ProviderInfo providerInfo) {
+        if (iconRes == 0) return null;
+        Drawable drawable = mContext.getPackageManager().getDrawable(
+                providerInfo.packageName, iconRes, providerInfo.applicationInfo);
+        Bitmap scaled = Bitmap.createScaledBitmap(
+                convertDrawableToBitmap(drawable), 32, 32, false);
+        ByteBuffer buffer = ByteBuffer.allocate(scaled.getAllocationByteCount());
+        scaled.copyPixelsToBuffer(buffer);
+        ArcBitmap bitmap = new ArcBitmap();
+        bitmap.pixelData = buffer.array();
+        bitmap.width = scaled.getWidth();
+        bitmap.height = scaled.getHeight();
+        return bitmap;
+    }
+
+    private Bitmap convertDrawableToBitmap(Drawable drawable) {
+        if (drawable == null) return null;
+        if (drawable instanceof BitmapDrawable) {
+            return ((BitmapDrawable) drawable).getBitmap();
+        }
+        Bitmap bitmap = Bitmap.createBitmap(
+                Math.max(drawable.getIntrinsicWidth(), 1),
+                Math.max(drawable.getIntrinsicHeight(), 1),
+                Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bitmap);
+        drawable.setBounds(0, 0, canvas.getWidth(), canvas.getHeight());
+        drawable.draw(canvas);
+        return bitmap;
+    }
+
+    boolean isSameRoots(TreeMap<String, ArrayList<Root>> a,
+            TreeMap<String, ArrayList<Root>> b) {
+        if (a == null || b == null) return a == b;
+        if (!a.keySet().equals(b.keySet())) return false;
+        for (String key : a.keySet()) {
+            if (!isSameRoots(a.get(key), b.get(key))) return false;
+        }
+        return true;
+    }
+
+    boolean isSameRoots(ArrayList<Root> a, ArrayList<Root> b) {
+        if (a == null || b == null) return a == b;
+        if (a.size() != b.size()) return false;
+        Iterator<Root> it1 = a.iterator();
+        Iterator<Root> it2 = b.iterator();
+        while (it1.hasNext()) {
+            if (!isSameRoot(it1.next(), it2.next())) return false;
+        }
+        return true;
+    }
+
+    private boolean isSameRoot(Root a, Root b) {
+        return Objects.equals(a.authority, b.authority)
+                && Objects.equals(a.rootId, b.rootId)
+                && Objects.equals(a.documentId, b.documentId)
+                && Objects.equals(a.title, b.title)
+                && Objects.equals(a.summary, b.summary)
+                && a.supportsCreate == b.supportsCreate
+                && Objects.equals(a.mimeTypes, b.mimeTypes);
+    }
+
+    private void registerPackageReceiver() {
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(Intent.ACTION_PACKAGE_ADDED);
+        filter.addAction(Intent.ACTION_PACKAGE_CHANGED);
+        filter.addAction(Intent.ACTION_PACKAGE_REMOVED);
+        filter.addAction(Intent.ACTION_PACKAGE_DATA_CLEARED);
+        filter.addDataScheme("package");
+        mContext.registerReceiver(mPackageReceiver, filter);
+    }
+
+    void notifyRootsChanged() {
+        for (Observer observer : mObservers) {
+            observer.onRootsChanged();
+        }
+    }
+}
