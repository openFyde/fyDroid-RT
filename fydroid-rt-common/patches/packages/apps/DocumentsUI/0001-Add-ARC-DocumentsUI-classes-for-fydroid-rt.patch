@@ -0,0 +1,309 @@
+package org.chromium.arc.file_system;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.os.Binder;
+import android.os.Build;
+import android.os.ParcelFileDescriptor;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.util.Log;
+import com.android.server.arc.data_device.IArcDataDeviceProviderService;
+import java.io.File;
+import java.io.FileNotFoundException;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.atomic.AtomicReference;
+import org.chromium.arc.FutureCallback;
+import org.chromium.arc.bridge.ArcBridgeSupport;
+import org.chromium.arc.mojom.FileSystemHost;
+import org.chromium.mojo.system.UntypedHandle;
+import org.chromium.mojo_base.mojom.Time;
+import org.chromium.url.mojom.Url;
+
+public class ChromeContentProvider extends ContentProvider {
+    private static final String TAG = ChromeContentProvider.class.getSimpleName();
+    private static final String DATA_DEVICE_PROVIDER_SERVICE_NAME =
+            "arc_data_device_provider_service";
+    public static final long UNIX_EPOCH_SINCE_WINDOWS_EPOCH_IN_MICROSECONDS =
+            11644473600000000L;
+    private static String sVirtualFilesPath = "/var/run/arc/media/virtual_files/";
+    private static final String[] DEFAULT_PROJECTION = {
+            "_display_name", "_size", "document_id", "mime_type", "last_modified", "flags"};
+
+    private final AtomicReference<IArcDataDeviceProviderService> mDataDeviceProviderService =
+            new AtomicReference<>();
+
+    @Override
+    public boolean onCreate() {
+        mDataDeviceProviderService.set(IArcDataDeviceProviderService.Stub.asInterface(
+                ServiceManager.getService(DATA_DEVICE_PROVIDER_SERVICE_NAME)));
+        return true;
+    }
+
+    public static void setVirtualFilesPathForTest(String path) {
+        sVirtualFilesPath = path;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection,
+            String[] selectionArgs, String sortOrder) {
+        if (projection == null) {
+            projection = DEFAULT_PROJECTION;
+        }
+        MatrixCursor cursor = new MatrixCursor(projection);
+        MatrixCursor.RowBuilder row = cursor.newRow();
+        for (String column : projection) {
+            switch (column) {
+                case "_display_name": {
+                    String name = callGetNameSynchronously(uri.toString());
+                    if (name == null) {
+                        Log.e(TAG, "Failed to get the display name of " + uri);
+                        return null;
+                    }
+                    row.add(column, name);
+                    break;
+                }
+                case "_size": {
+                    long size = callGetSizeSynchronously(uri.toString());
+                    if (size < 0) {
+                        Log.e(TAG, "Failed to get the size of " + uri);
+                        return null;
+                    }
+                    row.add(column, size);
+                    break;
+                }
+                case "document_id":
+                    row.add(column, uri.getPath());
+                    break;
+                case "mime_type": {
+                    String type = getType(uri);
+                    if (type == null) {
+                        Log.e(TAG, "Failed to get the type of " + uri);
+                        return null;
+                    }
+                    row.add(column, type);
+                    break;
+                }
+                case "last_modified": {
+                    Time time = callGetLastModifiedSynchronously(uri.toString());
+                    if (time == null) {
+                        Log.w(TAG, "Failed to get the last modified time of " + uri);
+                    } else {
+                        row.add(column, getMillisecondsSinceUnixEpoch(time));
+                    }
+                    break;
+                }
+                case "flags":
+                    row.add(column, 0);
+                    break;
+            }
+        }
+        return cursor;
+    }
+
+    @Override
+    public ParcelFileDescriptor openFile(Uri uri, String mode) throws FileNotFoundException {
+        if (ParcelFileDescriptor.parseMode(mode) != 268435456) {
+            throw new FileNotFoundException("Cannot open " + uri + " with mode " + mode);
+        }
+        if ("cheets".equals(Build.HARDWARE)) {
+            UntypedHandle handle = callOpenFileToReadSynchronously(uri.toString());
+            if (handle == null) {
+                throw new FileNotFoundException("Cannot read " + uri);
+            }
+            notifyContentProviderAccess(uri);
+            return ParcelFileDescriptor.adoptFd(
+                    ArcBridgeSupport.getInstance().convertMojoHandleToFileDescriptor(handle));
+        }
+        String virtualFileId = callGetVirtualFileIdSynchronously(uri.toString());
+        if (virtualFileId == null) {
+            throw new FileNotFoundException("Cannot get virtual file id");
+        }
+        notifyContentProviderAccess(uri);
+        try {
+            return ParcelFileDescriptor.open(
+                    new File(sVirtualFilesPath, virtualFileId), 268435456);
+        } catch (Exception e) {
+            if (!callHandleIdReleasedSynchronously(virtualFileId)) {
+                Log.e(TAG, "Cannot release virtual file id: " + virtualFileId);
+            }
+            throw new FileNotFoundException("Cannot open " + uri + ". Exception: " + e);
+        }
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return callGetTypeSynchronously(uri.toString());
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        return 0;
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        return null;
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection,
