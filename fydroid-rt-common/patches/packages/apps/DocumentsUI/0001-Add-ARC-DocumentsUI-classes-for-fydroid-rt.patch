+package org.chromium.arc.wayland;
+
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+public interface IWaylandService extends IInterface {
+    static final String DESCRIPTOR = "org.chromium.arc.wayland.IWaylandService";
+    static final int TRANSACTION_translateDisplayId = 12;
+
+    int translateDisplayId(long chromeDisplayId) throws RemoteException;
+
+    abstract class Stub extends android.os.Binder implements IWaylandService {
+        public Stub() {
+            attachInterface(this, DESCRIPTOR);
+        }
+
+        public static IWaylandService asInterface(IBinder binder) {
+            if (binder == null) {
+                return null;
+            }
+            IInterface localInterface = binder.queryLocalInterface(DESCRIPTOR);
+            if (localInterface instanceof IWaylandService) {
+                return (IWaylandService) localInterface;
+            }
+            return new Proxy(binder);
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return this;
+        }
+    }
+
+    class Proxy implements IWaylandService {
+        private final IBinder mRemote;
+
+        Proxy(IBinder remote) {
+            mRemote = remote;
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return mRemote;
+        }
+
+        @Override
+        public int translateDisplayId(long chromeDisplayId) throws RemoteException {
+            Parcel data = Parcel.obtain();
+            Parcel reply = Parcel.obtain();
+            try {
+                data.writeInterfaceToken(DESCRIPTOR);
+                data.writeLong(chromeDisplayId);
+                mRemote.transact(TRANSACTION_translateDisplayId, data, reply, 0);
+                reply.readException();
+                return reply.readInt();
+            } finally {
+                reply.recycle();
+                data.recycle();
+            }
+        }
+    }
+}
