+package org.chromium.arc.display;
+
+import android.os.Parcel;
+import android.os.Parcelable;
+
+public class ArcDisplayLayout implements Parcelable {
+    public int layoutMode;
+    public long primaryPhysicalDisplayId;
+    public ArcDisplay[] displays;
+    public float defaultDeviceScaleFactor;
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public final void writeToParcel(Parcel parcel, int flags) {
+        int startPos = parcel.dataPosition();
+        parcel.writeInt(0); // placeholder for length
+        parcel.writeInt(layoutMode);
+        parcel.writeLong(primaryPhysicalDisplayId);
+        parcel.writeTypedArray(displays, 0);
+        parcel.writeFloat(defaultDeviceScaleFactor);
+        int endPos = parcel.dataPosition();
+        parcel.setDataPosition(startPos);
+        parcel.writeInt(endPos - startPos);
+        parcel.setDataPosition(endPos);
+    }
+
+    public final void readFromParcel(Parcel parcel) {
+        int startPos = parcel.dataPosition();
+        int length = parcel.readInt();
+        if (length < 0) {
+            return;
+        }
+        try {
+            layoutMode = parcel.readInt();
+            if (parcel.dataPosition() - startPos >= length) return;
+            primaryPhysicalDisplayId = parcel.readLong();
+            if (parcel.dataPosition() - startPos >= length) return;
+            displays = parcel.createTypedArray(ArcDisplay.CREATOR);
+            if (parcel.dataPosition() - startPos >= length) return;
+            defaultDeviceScaleFactor = parcel.readFloat();
+        } finally {
+            parcel.setDataPosition(startPos + length);
+        }
+    }
+
+    public static final Creator<ArcDisplayLayout> CREATOR = new Creator<ArcDisplayLayout>() {
+        @Override
+        public ArcDisplayLayout createFromParcel(Parcel parcel) {
+            ArcDisplayLayout layout = new ArcDisplayLayout();
+            layout.readFromParcel(parcel);
+            return layout;
+        }
+
+        @Override
+        public ArcDisplayLayout[] newArray(int size) {
+            return new ArcDisplayLayout[size];
+        }
+    };
+}
