+import org.chromium.arc.bridge.ArcService;
+import org.chromium.arc.mojom.ArcBridgeHost;
+
+public class ArcFileSystemService extends Service implements ArcService {
+    private static final String TAG = ArcFileSystemService.class.getSimpleName();
+    private FileSystemInstanceImpl mInstanceImpl;
+    private MediaStoreDelegate mMediaStoreDelegate;
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        return START_STICKY;
+    }
+
+    public static class Receiver extends BroadcastReceiver {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            context.startService(new Intent(context, ArcFileSystemService.class));
+        }
+    }
+
+    @Override
+    public void onCreate() {
+        Log.i(TAG, "Starting service...");
+        super.onCreate();
+        mInstanceImpl = new FileSystemInstanceImpl(this);
+        mMediaStoreDelegate = new MediaStoreDelegate(this);
+        ArcBridgeSupport.getInstance().requestArcBridgeProxyAsync(
+                getApplicationContext(), this, 13);
+    }
+
+    @Override
+    public void onDestroy() {
+        Log.i(TAG, "Stopping service...");
+        mMediaStoreDelegate.onDestroy();
+        super.onDestroy();
+    }
+
+    public void onBridgeReady(ArcBridgeHost arcBridgeHost) {
+        Log.i(TAG, "Bridge ready.");
+        arcBridgeHost.onFileSystemInstanceReady(mInstanceImpl);
+    }
+
+    public void onBridgeVersionMismatch(int version) {
+        Log.e(TAG, "Bridge version mismatch: " + version);
+    }
+}
