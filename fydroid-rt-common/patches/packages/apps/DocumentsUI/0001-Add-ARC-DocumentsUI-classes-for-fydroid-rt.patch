@@ -0,0 +1,282 @@
+package org.chromium.arc.file_system;
+
+import android.app.Activity;
+import android.app.ActivityManager;
+import android.app.ActivityOptions;
+import android.app.IApplicationThread;
+import android.content.ClipData;
+import android.content.ComponentName;
+import android.content.ContentProviderClient;
+import android.content.ContentResolver;
+import android.content.Intent;
+import android.graphics.Rect;
+import android.net.Uri;
+import android.os.AsyncTask;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.RemoteException;
+import android.provider.DocumentsContract;
+import android.util.Log;
+import com.android.documentsui.DocumentsApplication;
+import java.io.FileNotFoundException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.ExecutionException;
+import org.chromium.arc.FutureCallback;
+import org.chromium.arc.mojom.DocumentPath;
+import org.chromium.arc.mojom.FileSelectorElement;
+import org.chromium.arc.mojom.FileSelectorEvent;
+import org.chromium.arc.mojom.FileSystemHost;
+import org.chromium.arc.mojom.SelectFilesRequest;
+import org.chromium.arc.mojom.SelectFilesResult;
+import org.chromium.url.mojom.Url;
+import java.util.List;
+
+public class ArcSelectFilesActivity extends Activity {
+    private static final String TAG = "ArcSelectFilesActivity";
+    private static final Rect EVENT_HANDLER_ACTIVITY_BOUNDS = new Rect(0, 0, 400, 400);
+    private final Handler mHandler = new Handler();
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Intent intent = getIntent();
+        if (intent == null) {
+            setResult(RESULT_CANCELED);
+            finish();
+            return;
+        }
+        SelectFilesRequest request = createSelectFilesRequest(intent);
+        new AsyncTask<Void, Void, Void>() {
+            @Override
+            public Void doInBackground(Void... params) {
+                if (!sendSelectFilesRequestSynchronously(request)) {
+                    setResult(RESULT_CANCELED);
+                    finish();
+                }
+                return null;
+            }
+        }.executeOnExecutor(AsyncTask.THREAD_POOL_EXECUTOR);
+
+        Intent eventHandlerIntent = new Intent(this,
+                ArcSelectFilesEventHandlerActivity.class)
+                .setFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                .putExtra("org.chromium.arc.file_system.SELECT_FILES_ACTIVITY_TASK_ID",
+                        getTaskId());
+        ActivityOptions options = ActivityOptions.makeBasic();
+        options.setLaunchBounds(EVENT_HANDLER_ACTIVITY_BOUNDS);
+        mHandler.postDelayed(() -> startActivity(eventHandlerIntent, options.toBundle()),
+                3000);
+    }
+
+    @Override
+    protected void onDestroy() {
+        mHandler.removeCallbacksAndMessages(null);
+        sendFileSelectorCancelEventSynchronously();
+        sendBroadcast(new Intent(
+                "org.chromium.arc.file_system.SELECT_FILES_ACTIVITY_DESTROYED")
+                .putExtra("org.chromium.arc.file_system.SELECT_FILES_ACTIVITY_TASK_ID",
+                        getTaskId()));
+        super.onDestroy();
+    }
+
+    @Override
+    public void onActivityResult(int requestCode, int resultCode, Intent data) {
+        if (requestCode == 1) {
+            setResult(resultCode, data);
+        } else {
+            Log.e(TAG, "Invalid request code: " + requestCode);
+            setResult(RESULT_CANCELED);
+        }
+        finish();
+    }
+
+    private SelectFilesRequest createSelectFilesRequest(Intent intent) {
+        SelectFilesRequest request = new SelectFilesRequest();
+        String action = intent.getAction();
+        if (Intent.ACTION_OPEN_DOCUMENT.equals(action)) {
+            request.actionType = 1;
+        } else if (Intent.ACTION_CREATE_DOCUMENT.equals(action)) {
+            request.actionType = 3;
+        } else if (Intent.ACTION_GET_CONTENT.equals(action)) {
+            request.actionType = 0;
+        } else if (Intent.ACTION_OPEN_DOCUMENT_TREE.equals(action)) {
+            request.actionType = 2;
+        } else if ("org.chromium.arc.file_system.action.OPEN_MEDIA_STORE_FILES".equals(action)
+                && "com.google.android.apps.photos".equals(getCallingPackage())) {
+            request.actionType = 4;
+        } else {
+            throw new UnsupportedOperationException("Unsupported action : " + action);
+        }
+
+        String type = intent.getType();
+        if (intent.hasExtra(Intent.EXTRA_MIME_TYPES)) {
+            request.mimeTypes = Arrays.stream(
+                    intent.getStringArrayExtra(Intent.EXTRA_MIME_TYPES))
+                    .filter(s -> s != null)
+                    .distinct()
+                    .toArray(String[]::new);
+        } else if (type != null && !"*/*".equals(type)) {
+            request.mimeTypes = new String[]{type};
+        } else {
+            request.mimeTypes = new String[0];
+        }
+        request.openableOnly = intent.hasCategory(Intent.CATEGORY_OPENABLE);
+        request.allowMultiple = intent.getBooleanExtra(
+                Intent.EXTRA_ALLOW_MULTIPLE, false);
+        String title = intent.getStringExtra(Intent.EXTRA_TITLE);
+        request.defaultFileName = title != null ? title : "";
+        String query = intent.getStringExtra("android.intent.extra.CONTENT_QUERY");
+        request.searchQuery = query != null ? query : "";
+        Uri initialUri = intent.getParcelableExtra("android.provider.extra.INITIAL_URI");
+        request.initialContentUri = initialUri != null ? initialUri.toString() : "";
+        request.initialDocumentPath = createMojoDocumentPath(initialUri);
+        request.taskId = getTaskId();
+        return request;
+    }
+
+    private DocumentPath createMojoDocumentPath(Uri uri) {
+        if (uri == null) return null;
+        try {
+            ContentProviderClient client =
+                    DocumentsApplication.acquireUnstableProviderOrThrow(
+                            getContentResolver(), uri.getAuthority());
+            try {
+                DocumentsContract.Path path = DocumentsContract.findDocumentPath(
+                        ContentResolver.wrap(client), uri);
+                DocumentPath docPath = new DocumentPath();
+                docPath.authority = uri.getAuthority();
+                List<String> pathList = path.getPath();
+                docPath.path = pathList.toArray(new String[0]);
+                docPath.rootId = path.getRootId();
+                return docPath;
+            } finally {
+                client.close();
+            }
+        } catch (RemoteException | FileNotFoundException | RuntimeException e) {
+            Log.e(TAG, "Failed to construct DocumentPath for " + uri, e);
+            return null;
+        }
+    }
+
+    private boolean sendSelectFilesRequestSynchronously(SelectFilesRequest request) {
+        FileSystemHostHolder holder = FileSystemHostHolder.getInstance();
+        FutureCallback<SelectFilesResult> future =
+                new FutureCallback<>(holder.getCancellationRelay());
+        synchronized (holder) {
+            FileSystemHost host = holder.getLocked(9);
+            if (host == null) {
+                Log.e(TAG, "FileSystemHost is not ready.");
+                return false;
+            }
+            host.selectFiles(request, result -> future.set(result));
+            try {
+                handleSelectFilesResult(request, future.get());
+                return true;
+            } catch (InterruptedException | CancellationException | ExecutionException e) {
+                Log.e(TAG, "Method call failed ", e);
+                return false;
+            }
+        }
+    }
+
+    private void handleSelectFilesResult(SelectFilesRequest request,
+            SelectFilesResult result) {
+        try {
+            ActivityManager.getService().moveTaskToFront(
+                    null, "com.android.documentsui", getTaskId(), 0, null);
+        } catch (RemoteException | RuntimeException e) {
+            Log.w(TAG, "Failed to refocus ArcSelectFilesActivity", e);
+        }
+
+        String pickerActivity = result.pickerActivity;
+        if (pickerActivity != null && !pickerActivity.isEmpty()) {
+            String[] parts = pickerActivity.split("/");
+            if (parts.length != 2) {
+                Log.e(TAG, "Invalid picker_activity value: " + pickerActivity);
+                setResult(RESULT_CANCELED);
+                finish();
+                return;
+            }
+            Intent intent = new Intent(getIntent());
+            intent.setFlags(intent.getFlags() & ~Intent.FLAG_ACTIVITY_NEW_TASK);
+            intent.setComponent(new ComponentName(parts[0], parts[1]));
+            startActivityForResult(intent, 1);
+            return;
+        }
+
+        ArrayList<Uri> uris = new ArrayList<>();
+        if (request.actionType == 4) {
+            for (Url url : result.urls) {
+                Uri uri = Uri.parse(url.url);
+                Uri mediaUri = ArcContentUriUtils.convertArcContentUriToMediaStoreUri(
+                        this, uri);
+                if (mediaUri == null) {
+                    Intent data = new Intent();
+                    data.putExtra(
+                            "org.chromium.arc.file_system.extra.FILE_NAME",
+                            uri.getLastPathSegment());
+                    setResult(100, data);
+                    finish();
+                    return;
+                }
+                uris.add(mediaUri);
+            }
+        } else {
+            for (Url url : result.urls) {
+                Uri uri = Uri.parse(url.url);
+                Uri docsUri = ArcContentUriUtils
+                        .convertArcContentUriToMediaDocumentsProviderUri(this, uri);
+                uris.add(docsUri != null ? docsUri : uri);
+            }
+        }
+
+        if (uris.isEmpty()) {
+            setResult(RESULT_CANCELED);
+            finish();
+            return;
+        }
+
+        Intent data = new Intent();
+        if (uris.size() == 1) {
+            data.setData(uris.get(0));
+        } else {
+            ClipData clipData = new ClipData(null, request.mimeTypes,
+                    new ClipData.Item(uris.get(0)));
+            for (int i = 1; i < uris.size(); i++) {
+                clipData.addItem(new ClipData.Item(uris.get(i)));
+            }
+            data.setClipData(clipData);
+        }
+        int actionType = request.actionType;
+        if (actionType == 0) {
+            data.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        } else if (actionType == 2) {
+            data.addFlags(195); // READ|WRITE|PREFIX|PERSISTABLE
+        } else {
+            data.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION
+                    | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        }
+        setResult(RESULT_OK, data);
+        finish();
+    }
+
+    private void sendFileSelectorCancelEventSynchronously() {
+        FileSelectorEvent event = new FileSelectorEvent();
+        event.type = 3; // cancel
+        FileSelectorElement target = new FileSelectorElement();
+        event.clickTarget = target;
+        target.name = "";
+        event.creatorTaskId = getTaskId();
+        FileSystemHostHolder holder = FileSystemHostHolder.getInstance();
+        synchronized (holder) {
+            FileSystemHost host = holder.getLocked(11);
+            if (host == null) {
+                Log.e(TAG, "FileSystemHost is not ready.");
+            } else {
+                host.onFileSelectorEvent(event, () -> {});
+            }
+        }
+    }
+}
diff --git a/src/org/chromium/arc/file_system/ArcSelectFilesEventHandlerActivity.java b/src/org/chromium/arc/file_system/ArcSelectFilesEventHandlerActivity.java
