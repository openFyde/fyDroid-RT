+package com.android.settings.applications.appinfo;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.text.TextUtils;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.Set;
+
+/**
+ * fydroid: per-app "Open with game control panel" toggle on the App info page.
+ *
+ * Sideloaded games carry {@code ApplicationInfo.category == CATEGORY_UNDEFINED}
+ * (no Play Store ever called {@code setApplicationCategoryHint()}), so ChromeOS
+ * never treats them as games and won't attach the Game Dashboard / Game Controls
+ * mouse-and-keyboard-to-touch overlay. Flagging a package here records it in a
+ * Settings.Secure package list that the ARC bridge (ArcAppService.getAppCategory)
+ * reports to Chrome as CATEGORY_GAME.
+ */
+public class GameCategoryPreferenceController extends TogglePreferenceController {
+
+    public static final String KEY = "fydroid_is_game";
+
+    // Must match ArcAppService.GAME_PKGS_SECURE_KEY in the arc-services bridge.
+    static final String SECURE_KEY = "fydroid_game_packages";
+    private static final String SEP = ":";
+
+    private String mPackageName;
+
+    public GameCategoryPreferenceController(Context context) {
+        super(context, KEY);
+    }
+
+    public GameCategoryPreferenceController setPackageName(String packageName) {
+        mPackageName = packageName;
+        return this;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return TextUtils.isEmpty(mPackageName) ? CONDITIONALLY_UNAVAILABLE : AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return readGamePackages(mContext).contains(mPackageName);
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        if (TextUtils.isEmpty(mPackageName)) {
+            return false;
+        }
+        final Set<String> set = readGamePackages(mContext);
+        final boolean changed = isChecked ? set.add(mPackageName) : set.remove(mPackageName);
+        if (changed) {
+            Settings.Secure.putString(mContext.getContentResolver(), SECURE_KEY,
+                    TextUtils.join(SEP, set));
+        }
+        return true;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_apps;
+    }
+
+    private static Set<String> readGamePackages(Context context) {
+        final Set<String> set = new LinkedHashSet<>();
+        final String csv = Settings.Secure.getString(
+                context.getContentResolver(), SECURE_KEY);
+        if (!TextUtils.isEmpty(csv)) {
+            for (String p : Arrays.asList(csv.split(SEP))) {
+                if (!p.isEmpty()) {
+                    set.add(p);
+                }
+            }
+        }
+        return set;
+    }
+}
