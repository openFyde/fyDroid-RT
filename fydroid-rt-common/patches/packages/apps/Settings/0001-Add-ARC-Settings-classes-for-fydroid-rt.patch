+
+package org.chromium.settings.development;
+
+import android.content.Context;
+import android.os.SystemProperties;
+import android.text.TextUtils;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import androidx.preference.SwitchPreference;
+
+/**
+ * Base class for switch-based ARC WM feature preference controllers.
+ */
+public abstract class ArcWmFeatureSwitchPreferenceController
+        extends ArcWmFeaturePreferenceController {
+
+    private SwitchPreference mSwitchPreference;
+
+    public boolean getDefaultSystemPropertyValue() {
+        return false;
+    }
+
+    ArcWmFeatureSwitchPreferenceController(Context context) {
+        super(context);
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mSwitchPreference = (SwitchPreference) mPreference;
+    }
+
+    @Override
+    String getSystemPropertyNewValue(Object newValue) {
+        return ((Boolean) newValue) ? "1" : "0";
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        boolean value;
+        String key = getSystemPropertyKey();
+        if (TextUtils.isEmpty(key)) {
+            value = getDefaultSystemPropertyValue();
+        } else {
+            value = SystemProperties.getBoolean(key, getDefaultSystemPropertyValue());
+        }
+        mSwitchPreference.setChecked(value);
+    }
+
+    @Override
+    public void onDeveloperOptionsSwitchDisabled() {
+        super.onDeveloperOptionsSwitchDisabled();
+        String key = getSystemPropertyKey();
+        if (!TextUtils.isEmpty(key)) {
+            SystemProperties.set(key, getDefaultSystemPropertyValue() ? "1" : "0");
+        }
+        mSwitchPreference.setChecked(getDefaultSystemPropertyValue());
+    }
+}
