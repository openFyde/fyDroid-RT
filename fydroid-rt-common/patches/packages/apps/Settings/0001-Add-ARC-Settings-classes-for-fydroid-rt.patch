+package org.chromium.settings.development;
+
+import android.app.UiModeManager;
+import android.content.Context;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import androidx.preference.SwitchPreference;
+
+import com.android.settings.R;
+
+public class ArcDarkThemePreferenceController extends ArcWmFeatureSwitchPreferenceController {
+
+    private SwitchPreference mSwitchPreference;
+    private UiModeManager mUiModeManager;
+
+    public ArcDarkThemePreferenceController(Context context) {
+        super(context);
+        mUiModeManager = (UiModeManager) context.getSystemService(UiModeManager.class);
+    }
+
+    @Override
+    public String getPreferenceKey() {
+        return "ARC_DARK_THEME";
+    }
+
+    @Override
+    public String getSystemPropertyKey() {
+        return null;
+    }
+
+    @Override
+    public String getPreferenceSummary() {
+        return null;
+    }
+
+    @Override
+    public String getPreferenceTitle() {
+        return mContext.getResources().getString(R.string.dark_ui_title);
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mSwitchPreference = (SwitchPreference) mPreference;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        mSwitchPreference.setChecked(mUiModeManager.getNightMode() == UiModeManager.MODE_NIGHT_YES);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        super.onPreferenceChange(preference, newValue);
+        mUiModeManager.setNightMode(
+                ((Boolean) newValue) ? UiModeManager.MODE_NIGHT_YES : UiModeManager.MODE_NIGHT_NO);
+        return true;
+    }
+
+    @Override
+    public void onDeveloperOptionsSwitchDisabled() {
+        super.onDeveloperOptionsSwitchDisabled();
+        mUiModeManager.setNightMode(UiModeManager.MODE_NIGHT_NO);
+        mSwitchPreference.setChecked(false);
+    }
+}
