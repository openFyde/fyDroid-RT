diff --git a/src/org/chromium/settings/development/ArcDevelopmentSettingsDashboardFragment.java b/src/org/chromium/settings/development/ArcDevelopmentSettingsDashboardFragment.java
new file mode 100644
index 00000000000..33ef7117f39
--- /dev/null
+++ b/src/org/chromium/settings/development/ArcDevelopmentSettingsDashboardFragment.java
@@ -0,0 +1,136 @@
+/*
+ * Copyright (C) 2024 The FydeOS Authors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+package org.chromium.settings.development;
+
+import android.content.Context;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreference;
+
+import com.android.settings.R;
+import com.android.settings.development.DevelopmentSettingsDashboardFragment;
+import com.android.settingslib.core.AbstractPreferenceController;
+
+import org.chromium.settings.HiddenPreferenceController;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * ARC development settings dashboard — removes stock Android development
+ * preferences and adds ARC-specific WM feature toggles.
+ */
+public class ArcDevelopmentSettingsDashboardFragment extends DevelopmentSettingsDashboardFragment {
+
+    private final List<ArcWmFeaturePreferenceController> mWmFeatureControllers = new ArrayList<>();
+
+    @Override
+    public void addPreferencesFromResource(int preferencesResId) {
+        super.addPreferencesFromResource(preferencesResId);
+        for (ArcWmFeaturePreferenceController controller : mWmFeatureControllers) {
+            addWmPreference(controller);
+        }
+    }
+
+    @Override
+    protected List<AbstractPreferenceController> createPreferenceControllers(Context context) {
+        List<AbstractPreferenceController> controllers = super.createPreferenceControllers(context);
+        removeControllers(controllers);
+        addArcControllers(controllers, context);
+        return controllers;
+    }
+
+    @Override
+    public void onEnableAdbDialogConfirmed() {
+        ((ArcAdbPreferenceController) use(ArcAdbPreferenceController.class))
+                .onAdbDialogConfirmed();
+    }
+
+    @Override
+    public void onEnableAdbDialogDismissed() {
+        ((ArcAdbPreferenceController) use(ArcAdbPreferenceController.class))
+                .onAdbDialogDismissed();
+    }
+
+    @Override
+    public <T extends AbstractPreferenceController> T use(Class<T> clazz) {
+        return super.use(clazz);
+    }
+
+    private void removeControllers(List<AbstractPreferenceController> controllers) {
+        List<AbstractPreferenceController> toRemove = new ArrayList<>();
+        for (AbstractPreferenceController controller : controllers) {
+            if (ArcDevelopmentConstants.PREFERENCES_TO_REMOVE.contains(
+                    controller.getPreferenceKey())) {
+                toRemove.add(controller);
+            }
+        }
+        controllers.removeAll(toRemove);
+    }
+
+    void addArcControllers(List<AbstractPreferenceController> controllers, Context context) {
+        // Add HiddenPreferenceControllers for removed preferences (except ADB which is replaced)
+        for (String key : ArcDevelopmentConstants.PREFERENCES_TO_REMOVE) {
+            if (!"enable_adb".equals(key)) {
+                controllers.add(new HiddenPreferenceController(context, key));
+            }
+        }
+        for (String key : ArcDevelopmentConstants.CATEGORIES_TO_REMOVE) {
+            controllers.add(new HiddenPreferenceController(context, key));
+        }
+
+        // Add ARC-specific ADB controller
+        controllers.add(new ArcAdbPreferenceController(context, this));
+        controllers.add(new ArcWirelessDebuggingPreferenceController(context,
+                getSettingsLifecycle()));
+
+        // Add WM feature controllers
+        mWmFeatureControllers.add(new ArcCaptionDescriptionPreferenceController(context));
+        mWmFeatureControllers.add(new ArcWaylandClientLogsPreferenceController(context));
+        mWmFeatureControllers.add(new ArcWaylandTimingLogsPreferenceController(context));
+        mWmFeatureControllers.add(new ArcVelocityTrackerStrategyPreferenceController(context));
+        mWmFeatureControllers.add(new ArcLaunchWindowSizePreferenceController(context,
+                context.getResources().getString(R.string.launch_window_size_title),
+                context.getResources().getStringArray(R.array.launch_window_size_names),
+                context.getResources().getStringArray(R.array.launch_window_size_values)));
+        mWmFeatureControllers.add(new ArcNotificationScalingPreferenceController(context));
+        mWmFeatureControllers.add(new ArcDarkThemePreferenceController(context));
+        mWmFeatureControllers.add(new ArcRubberBandResizingPreferenceController(context));
+        mWmFeatureControllers.add(new ArcWmFeatureForceUnResizeController(context));
+        mWmFeatureControllers.add(new ArcForceFullscreenPreferenceController(context));
+        mWmFeatureControllers.add(new ArcMouseCompatPreferenceController(context));
+        mWmFeatureControllers.add(new ArcSmoothScrollPreferenceController(context));
+        mWmFeatureControllers.add(new ArcPinchGesturePreferenceController(context));
+        controllers.addAll(mWmFeatureControllers);
+    }
+
+    void addWmPreference(ArcWmFeaturePreferenceController controller) {
+        Preference pref;
+        if (controller instanceof ArcWmFeatureSwitchPreferenceController) {
+            pref = new SwitchPreference(getContext());
+        } else if (controller instanceof ArcWmFeatureListPreferenceController) {
+            pref = new ListPreference(getContext());
+        } else {
+            throw new UnsupportedOperationException(
+                    "Unexpected controller type " + controller.getClass().getSimpleName());
+        }
+        pref.setKey(controller.getPreferenceKey());
+        pref.setTitle(controller.getPreferenceTitle());
+        String summary = controller.getPreferenceSummary();
+        if (summary != null) {
+            pref.setSummary(summary);
+        }
+        ((PreferenceCategory) getPreferenceScreen().findPreference("debug_applications_category"))
+                .addPreference(pref);
+    }
+}
