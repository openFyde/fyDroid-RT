+ *      http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+package org.chromium.settings;
+
+import android.app.Activity;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.os.Bundle;
+import android.util.Log;
+
+/**
+ * Intercepts Settings intents that should be handled by Chrome OS and redirects
+ * them to the ARC intent helper, which forwards them to the Chrome OS settings.
+ */
+public final class SettingsBlackHoleActivity extends Activity {
+    private static final String TAG = "SettingsBlackHole";
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Intent intent = getIntent();
+        if (intent != null) {
+            switch (intent.getAction()) {
+                case "android.settings.BATTERY_SAVER_SETTINGS":
+                case "android.settings.BLUETOOTH_SETTINGS":
+                case "android.settings.CAST_SETTINGS":
+                case "android.settings.DATE_SETTINGS":
+                case "android.settings.DISPLAY_SETTINGS":
+                case "android.settings.DREAM_SETTINGS":
+                case "android.settings.HOME_SETTINGS":
+                case "android.settings.INPUT_METHOD_SETTINGS":
+                case "android.settings.INPUT_METHOD_SUBTYPE_SETTINGS":
+                case "android.settings.LOCALE_SETTINGS":
+                case "android.settings.NETWORK_OPERATOR_SETTINGS":
+                case "android.settings.NFCSHARING_SETTINGS":
+                case "android.settings.NFC_PAYMENT_SETTINGS":
+                case "android.settings.NFC_SETTINGS":
+                case "android.settings.QUICK_LAUNCH_SETTINGS":
+                case "android.settings.SHOW_REGULATORY_INFO":
+                case "android.settings.SOUND_SETTINGS":
+                case "android.settings.VOICE_CONTROL_BATTERY_SAVER_MODE":
+                case "android.settings.VOICE_INPUT_SETTINGS":
+                case "android.settings.WIFI_IP_SETTINGS":
+                case "android.settings.WIFI_SETTINGS":
+                case "android.settings.WIRELESS_SETTINGS":
+                    intent.setComponent(new ComponentName(
+                            "org.chromium.arc.intent_helper",
+                            "org.chromium.arc.intent_helper.ArcIntentHelperActivity"));
+                    startActivity(intent);
+                    setResult(RESULT_OK);
+                    break;
+                default:
+                    Log.e(TAG, "Intent " + intent + " not being handled.");
+                    break;
+            }
+            finish();
+        }
+    }
+}
