+ *      http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+package org.chromium.settings.development;
+
+import android.content.Context;
+import android.os.SystemProperties;
+import android.text.TextUtils;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+/**
+ * Base class for list-based ARC WM feature preference controllers.
+ */
+public abstract class ArcWmFeatureListPreferenceController
+        extends ArcWmFeaturePreferenceController {
+
+    final CharSequence[] mEntryNames;
+    final CharSequence[] mEntryValues;
+    private ListPreference mListPreference;
+
+    abstract String getDefaultSystemPropertyValue();
+
+    ArcWmFeatureListPreferenceController(Context context, CharSequence[] names,
+            CharSequence[] values) {
+        super(context);
+        mEntryNames = names;
+        mEntryValues = values;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mListPreference = (ListPreference) mPreference;
+        mListPreference.setEntries(mEntryNames);
+        mListPreference.setEntryValues(mEntryValues);
+    }
+
+    @Override
+    String getPreferenceSummary() {
+        return getEntryNameFromValue(getSystemPropertyValueOrDefault());
+    }
+
+    @Override
+    String getSystemPropertyNewValue(Object newValue) {
+        return (String) newValue;
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        boolean result = super.onPreferenceChange(preference, newValue);
+        mListPreference.setSummary(getPreferenceSummary());
+        return result;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        mListPreference.setValue(getSystemPropertyValueOrDefault());
+        mListPreference.setSummary(getPreferenceSummary());
+    }
+
+    @Override
+    public void onDeveloperOptionsSwitchDisabled() {
+        super.onDeveloperOptionsSwitchDisabled();
+        resetToDefault();
+    }
+
+    private void resetToDefault() {
+        String key = getSystemPropertyKey();
+        if (TextUtils.isEmpty(key)) return;
+        String defaultValue = getDefaultSystemPropertyValue();
+        SystemProperties.set(key, defaultValue);
+        mListPreference.setValue(defaultValue);
+        mListPreference.setSummary(getEntryNameFromValue(defaultValue));
+    }
+
+    private String getSystemPropertyValueOrDefault() {
+        String key = getSystemPropertyKey();
+        String defaultValue = getDefaultSystemPropertyValue();
+        return TextUtils.isEmpty(key) ? defaultValue
+                : SystemProperties.get(key, defaultValue);
+    }
+
+    String getEntryNameFromValue(String value) {
+        int index = 0;
+        for (int i = 0; i < mEntryValues.length; i++) {
+            if (mEntryValues[i].equals(value)) {
+                index = i;
+                break;
+            }
+        }
+        return mEntryNames[index].toString();
+    }
+}
