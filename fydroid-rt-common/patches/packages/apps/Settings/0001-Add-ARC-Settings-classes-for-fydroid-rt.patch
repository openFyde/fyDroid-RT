+package org.chromium.settings.development;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.development.AdbPreferenceController;
+import com.android.settings.development.DevelopmentSettingsDashboardFragment;
+import com.android.settingslib.development.AbstractEnableAdbPreferenceController;
+
+/**
+ * ADB preference controller that checks Chrome OS dev mode before enabling.
+ */
+public class ArcAdbPreferenceController extends AdbPreferenceController {
+
+    public ArcAdbPreferenceController(Context context,
+            DevelopmentSettingsDashboardFragment fragment) {
+        super(context, fragment);
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        if (!isAdbAllowed()) {
+            mPreference.setSummary(R.string.enable_adb_summary_unavailable);
+        }
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (isAdbAllowed()) {
+            super.updateState(preference);
+        } else {
+            mPreference.setEnabled(false);
+        }
+    }
+
+    @Override
+    protected void onDeveloperOptionsSwitchEnabled() {
+        if (isAdbAllowed()) {
+            super.onDeveloperOptionsSwitchEnabled();
+        } else {
+            mPreference.setEnabled(false);
+        }
+    }
+
+    boolean isAdbAllowed() {
+        return SystemProperties.getInt("ro.boot.dev_mode", 0) == 1
+                || SystemProperties.getInt("ro.boot.enable_adb_sideloading", 0) == 1;
+    }
+}
