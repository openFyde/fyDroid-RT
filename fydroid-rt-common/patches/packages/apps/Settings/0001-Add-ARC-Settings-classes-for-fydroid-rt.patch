+package org.chromium.settings.accessibility;
+
+import android.content.ComponentName;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceGroup;
+
+import com.android.settings.accessibility.AccessibilitySettings;
+
+/**
+ * ARC accessibility settings — removes unsupported accessibility services and
+ * system preferences that don't apply in the Chrome OS container.
+ */
+public class ArcAccessibilitySettings extends AccessibilitySettings {
+
+    static final ComponentName SWITCH_ACCESS_COMPONENT = new ComponentName(
+            "com.google.android.marvin.talkback",
+            "com.android.switchaccess.SwitchAccessService");
+    static final ComponentName SELECT_TO_SPEAK_COMPONENT = new ComponentName(
+            "com.google.android.marvin.talkback",
+            "com.google.android.accessibility.selecttospeak.SelectToSpeakService");
+    static final ComponentName ACCESSIBILITY_MENU_COMPONENT = new ComponentName(
+            "com.google.android.marvin.talkback",
+            "com.google.android.accessibility.accessibilitymenu.AccessibilityMenuService");
+    static final ComponentName ARC_ACCESSIBILITY_HELPER_COMPONENT = new ComponentName(
+            "org.chromium.arc.accessibilityhelper",
+            "org.chromium.arc.accessibilityhelper.ArcAccessibilityHelperService");
+
+    @Override
+    public void updateServicePreferences() {
+        super.updateServicePreferences();
+        removeSomeServicePrefences();
+    }
+
+    @Override
+    public void updateSystemPreferences() {
+        super.updateSystemPreferences();
+        removeSomeSystemPreferences();
+    }
+
+    void removeSomeServicePrefences() {
+        PreferenceCategory category =
+                (PreferenceCategory) findPreference("user_installed_services_category");
+        if (category != null) {
+            Preference switchAccess = findPreference(SWITCH_ACCESS_COMPONENT.flattenToString());
+            Preference selectToSpeak = findPreference(SELECT_TO_SPEAK_COMPONENT.flattenToString());
+            Preference arcHelper =
+                    findPreference(ARC_ACCESSIBILITY_HELPER_COMPONENT.flattenToString());
+            Preference accessibilityMenu =
+                    findPreference(ACCESSIBILITY_MENU_COMPONENT.flattenToString());
+            if (switchAccess != null) category.removePreference(switchAccess);
+            if (selectToSpeak != null) category.removePreference(selectToSpeak);
+            if (arcHelper != null) category.removePreference(arcHelper);
+            if (accessibilityMenu != null) category.removePreference(accessibilityMenu);
+            if (category.getPreferenceCount() == 0) {
+                getPreferenceScreen().removePreference(category);
+            }
+        }
+    }
+
+    void removeSomeSystemPreferences() {
+        setPreferenceVisible("accessibility_shortcut_preference", false);
+        setPreferenceVisible("toggle_large_pointer_icon", false);
+        setPreferenceVisible("toggle_disable_animations", false);
+        setPreferenceVisible("magnification_preference_screen", false);
+        setPreferenceVisible("accessibility_settings_screen_zoom", false);
+        setPreferenceVisible("toggle_lock_screen_rotation_preference", false);
+        setPreferenceVisible("autoclick_preference", false);
+        setPreferenceVisible("toggle_inversion_preference", false);
+        setPreferenceVisible("daltonizer_preference", false);
+        setPreferenceVisible("vibration_preference_screen", false);
+        setPreferenceVisible("dark_ui_mode_accessibility", false);
+
+        PreferenceGroup audioCategory =
+                (PreferenceGroup) findPreference("audio_and_captions_category");
+        if (audioCategory != null) audioCategory.setVisible(false);
+    }
+
+    private void setPreferenceVisible(String key, boolean visible) {
+        Preference pref = findPreference(key);
+        if (pref != null) pref.setVisible(visible);
+    }
+}
