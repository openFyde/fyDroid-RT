+    /**
+     * Runs the idle optimization for {@link CpuQuietTrigger}, with the same checks as
+     * {@link #onStartJob} for {@link #JOB_IDLE_OPTIMIZE}. When it returns true the trigger is
+     * re-armed by this run: a day later after a completed run, immediately otherwise.
+     *
+     * @return false if nothing was started because post-boot update is pending, another dexopt
+     *         run is active, or a battery is present without external power; the caller keeps
+     *         watching the CPU.
+     */
+    private boolean startCpuQuietOptimization() {
+        synchronized (mLock) {
+            if (!mFinishedPostBootUpdate
+                    || (mDexOptThread != null && mDexOptThread.isAlive())) {
+                return false;
+            }
+        }
+
+        if (!mInjector.isOnPowerOrWithoutBattery()) {
+            mCpuQuietTrigger.logWaitingForPowerOnce();
+            return false;
+        }
+
+        PackageManagerService pm = mInjector.getPackageManagerService();
+        if (pm.isStorageLow()) {
+            Slog.w(TAG, "Low storage, skipping this run");
+            mCpuQuietTrigger.startAfter(IDLE_OPTIMIZATION_PERIOD);
+            return true;
+        }
+
+        List<String> pkgs = mDexOptHelper.getOptimizablePackages(pm.snapshotComputer());
+        if (pkgs.isEmpty()) {
+            Slog.i(TAG, "No packages to optimize");
+            mCpuQuietTrigger.startAfter(IDLE_OPTIMIZATION_PERIOD);
+            return true;
+        }
+
+        mThermalStatusCutoff = mInjector.getDexOptThermalCutoff();
+
+        synchronized (mLock) {
+            if (mDexOptThread != null && mDexOptThread.isAlive()) {
+                return false;
+            }
+            Slog.i(TAG, "CPU below " + CPU_QUIET_PERCENT + "% for "
+                    + TimeUnit.MILLISECONDS.toSeconds(CPU_QUIET_DURATION_MS)
+                    + "s, starting idle optimization");
+            resetStatesForNewDexOptRunLocked(mInjector.createAndStartThread(
+                    "BackgroundDexOptService_CpuQuiet",
+                    () -> {
+                        TimingsTraceAndSlog tr =
+                                new TimingsTraceAndSlog(TAG, Trace.TRACE_TAG_PACKAGE_MANAGER);
+                        tr.traceBegin("cpuQuietExecution");
+                        boolean completed = false;
+                        try {
+                            completed = runIdleOptimization(
+                                    pm, pkgs, /* isPostBootUpdate= */ false);
+                        } finally {
+                            tr.traceEnd();
+                            Slog.i(TAG, "dexopt finishing. cpu-quiet completed:" + completed);
+                            markDexOptCompleted();
+                            mCpuQuietTrigger.startAfter(
+                                    completed ? IDLE_OPTIMIZATION_PERIOD : 0);
+                        }
+                    }));
+        }
+        return true;
+    }
