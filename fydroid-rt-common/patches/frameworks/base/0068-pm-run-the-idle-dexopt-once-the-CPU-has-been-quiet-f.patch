+    /**
+     * Samples machine-wide CPU usage from /proc/stat on the background thread and starts the idle
+     * optimization once every sample over {@link #CPU_QUIET_DURATION_MS} stayed below
+     * {@link #CPU_QUIET_PERCENT}. While the CPU stays quiet but the start is refused (for example
+     * on battery power), it retries on every sample. Sampling stops while a run it started is in
+     * progress and until that run re-arms it.
+     */
+    private final class CpuQuietTrigger implements Runnable {
+        private Handler mHandler;
+        // All times are SystemClock.uptimeMillis(), matching Handler#postDelayed.
+        private long mLastSampleMs = -1;
+        private long mLastIdleTicks;
+        private long mLastTotalTicks;
+        private long mQuietSinceMs = -1;
+        private long mNextStartMs = -1;
+        private boolean mLoggedWaitingForPower;
+
+        synchronized void startAfter(long delayMs) {
+            if (mHandler == null) {
+                mHandler = BackgroundThread.getHandler();
+            }
+            mHandler.removeCallbacks(this);
+            mLastSampleMs = -1;
+            mQuietSinceMs = -1;
+            mLoggedWaitingForPower = false;
+            mNextStartMs = SystemClock.uptimeMillis() + delayMs;
+            mHandler.postDelayed(this, delayMs);
+        }
+
+        @Override
+        public void run() {
+            synchronized (this) {
+                if (!sample()) {
+                    mHandler.postDelayed(this, CPU_QUIET_SAMPLE_INTERVAL_MS);
+                    return;
+                }
+            }
+            // Outside this object's lock: a run that finishes at once re-arms via startAfter().
+            if (startCpuQuietOptimization()) {
+                return;
+            }
+            // Keep the quiet window, so the start is retried on the next quiet sample.
+            synchronized (this) {
+                mHandler.postDelayed(this, CPU_QUIET_SAMPLE_INTERVAL_MS);
+            }
+        }
+
+        synchronized void logWaitingForPowerOnce() {
+            if (!mLoggedWaitingForPower) {
+                mLoggedWaitingForPower = true;
+                Slog.i(TAG, "CPU quiet, but on battery power: waiting for a charger");
+            }
+        }
+
+        /** Takes one sample; returns true once the CPU has been quiet for long enough. */
+        private boolean sample() {
+            long[] ticks = readCpuTicks();
+            if (ticks == null) {
+                return false;
+            }
+            long now = SystemClock.uptimeMillis();
+            long idle = ticks[0];
+            long total = ticks[1];
+            if (mLastSampleMs >= 0 && total > mLastTotalTicks) {
+                long busyPermille =
+                        (total - mLastTotalTicks - (idle - mLastIdleTicks)) * 1000
+                                / (total - mLastTotalTicks);
+                if (busyPermille >= CPU_QUIET_PERCENT * 10) {
+                    mQuietSinceMs = -1;
+                    mLoggedWaitingForPower = false;
+                } else if (mQuietSinceMs < 0) {
+                    mQuietSinceMs = mLastSampleMs;
+                }
+            }
+            mLastSampleMs = now;
+            mLastIdleTicks = idle;
+            mLastTotalTicks = total;
+            return mQuietSinceMs >= 0 && now - mQuietSinceMs >= CPU_QUIET_DURATION_MS;
+        }
+
+        /** Returns {idle + iowait, user..steal} from the aggregate cpu line, or null on error. */
+        @Nullable
+        private long[] readCpuTicks() {
+            try (BufferedReader reader = new BufferedReader(new FileReader("/proc/stat"))) {
+                String line = reader.readLine();
+                if (line == null || !line.startsWith("cpu ")) {
+                    return null;
+                }
+                String[] fields = line.trim().split("\\s+");
+                if (fields.length < 9) {
+                    return null;
+                }
+                long total = 0;
+                for (int i = 1; i <= 8; i++) {
+                    total += Long.parseLong(fields[i]);
+                }
+                long idle = Long.parseLong(fields[4]) + Long.parseLong(fields[5]);
+                return new long[] {idle, total};
+            } catch (IOException | NumberFormatException e) {
+                Slog.w(TAG, "Cannot read /proc/stat", e);
+                return null;
+            }
+        }
+
+        synchronized void dump(IndentingPrintWriter writer) {
+            long now = SystemClock.uptimeMillis();
+            writer.print("cpuQuietThresholdPercent:");
+            writer.println(CPU_QUIET_PERCENT);
+            writer.print("cpuQuietDurationMs:");
+            writer.println(CPU_QUIET_DURATION_MS);
+            writer.print("cpuQuietNextStartInMs:");
+            writer.println(mNextStartMs < 0 ? -1 : Math.max(0, mNextStartMs - now));
+            writer.print("cpuQuietForMs:");
+            writer.println(mQuietSinceMs < 0 ? -1 : now - mQuietSinceMs);
+        }
+    }
