+package com.android.server.pm;
+
+import android.annotation.Nullable;
+
+/**
+ * fydroid: install-time app policy for ARC, registered in {@link com.android.server.LocalServices}
+ * by arc-services' {@code ArcPolicyService}, which holds the enterprise ArcPolicy pushed by
+ * Chrome OS. PackageInstallerSession asks it before verifying a non-staged install, so an app
+ * the policy blocks is refused before it is installed, Google Play installs included.
+ *
+ * <p>The package manager keeps the exemptions that need its own state: APEX sessions and
+ * packages already installed as system apps (their updates) are never checked. Everything about
+ * the policy itself, including which installer is trusted, belongs to the implementation. With no
+ * implementation registered every install is allowed.
+ *
+ * <p>Calls arrive on the package manager's handler thread with no package-manager lock held;
+ * implementations must answer from memory, without binder calls or I/O.
+ */
+public interface ArcInstallGate {
+    /**
+     * @param packageName the package being installed
+     * @param installerPackageName the session's installer, or null (e.g. adb)
+     * @return null to allow the install, or a human-readable reason to reject it with
+     *     {@code INSTALL_FAILED_USER_RESTRICTED}
+     */
+    @Nullable
+    String checkInstall(String packageName, @Nullable String installerPackageName);
+}
diff --git a/services/core/java/com/android/server/pm/PackageInstallerSession.java b/services/core/java/com/android/server/pm/PackageInstallerSession.java
index 1823de8fcf66..636ba27e8b3d 100644
--- a/services/core/java/com/android/server/pm/PackageInstallerSession.java
+++ b/services/core/java/com/android/server/pm/PackageInstallerSession.java
@@ -2317,6 +2317,7 @@ public class PackageInstallerSession extends IPackageInstallerSession.Stub {
 
     private void verifyNonStaged()
             throws PackageManagerException {
+        checkArcInstallGate();
         synchronized (mLock) {
             markStageDirInUseLocked();
         }
@@ -2335,6 +2336,50 @@ public class PackageInstallerSession extends IPackageInstallerSession.Stub {
         });
     }
 
+    /**
+     * fydroid: ask ARC's app-install policy ({@link ArcInstallGate}, implemented by arc-services'
+     * ArcPolicyService) whether this session may install its package(s), and refuse the whole
+     * session with INSTALL_FAILED_USER_RESTRICTED if not. Runs once the APKs are parsed, so the
+     * package name is known, and before any verifier is involved — Google Play's installs are
+     * refused here instead of being installed and disabled afterwards.
+     *
+     * The package-manager side of the exemptions lives here: APEX sessions, and packages already
+     * installed as system apps (an update to a pre-installed app), are never checked.
+     */
+    private void checkArcInstallGate() throws PackageManagerException {
+        final ArcInstallGate gate = LocalServices.getService(ArcInstallGate.class);
+        if (gate == null) {
+            return;
+        }
+        if (isMultiPackage()) {
+            for (PackageInstallerSession child : getChildSessions()) {
+                child.checkArcInstallGate(gate);
+            }
+        } else {
+            checkArcInstallGate(gate);
+        }
+    }
+
+    private void checkArcInstallGate(ArcInstallGate gate) throws PackageManagerException {
+        final String packageName = mPackageName;
+        if (packageName == null || isApexSession()) {
+            return;
+        }
+        final PackageStateInternal existing =
+                mPm.snapshotComputer().getPackageStateInternal(packageName);
+        if (existing != null && existing.isSystem()) {
+            return;
+        }
+        final String reason =
+                gate.checkInstall(packageName, getInstallSource().installerPackageName);
+        if (reason != null) {
+            Slog.i(TAG, "ARC install policy refused " + packageName + " (session " + sessionId
+                    + ", installer " + getInstallSource().installerPackageName + "): " + reason);
+            throw new PackageManagerException(PackageManager.INSTALL_FAILED_USER_RESTRICTED,
+                    reason);
+        }
+    }
+
     private static class InstallResult {
         public final PackageInstallerSession session;
         public final Bundle extras;
