+package com.android.internal.fydroid;
+
+/**
+ * fydroid-rt system defaults: behaviour fydroid fixes in source instead of
+ * reading it from a system property or setting.
+ *
+ * <p>Every field is a compile-time constant, so readers inline the value.
+ *
+ * @hide
+ */
+public final class FydroidDefaults {
+
+    /**
+     * WMShell shell transitions: always off, and
+     * {@code persist.wm.debug.shell_transit} is ignored.
+     *
+     * <p>The compositor sizes ARC tasks through IArcTaskController.resizeTask,
+     * which starts no CHANGE transition. With shell transitions on, an
+     * organized Task keeps the OPEN transition's crop and clips its content.
+     * The prop lives in /data and survives image swaps, so it must not be able
+     * to switch this on.
+     *
+     * <p>Read by WMShell's Transitions, WindowManagerService and the Jetpack
+     * SplitController, which must agree.
+     */
+    public static final boolean ENABLE_SHELL_TRANSITIONS = false;
+
+    private FydroidDefaults() {}
+}
