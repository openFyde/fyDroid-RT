+    }
+
+    // fydroid: a short token for which packages named in
+    // /etc/default-permissions/ exceptions are installed as system apps, and at
+    // which version. It is part of the permission-upgrade fingerprint, so a
+    // change to that set -- GApps installed or reinstalled after the image's
+    // first boot, which is how they reach a board -- makes the next boot run
+    // DefaultPermissionGrantPolicy again. That pass is the only thing that
+    // applies the exceptions files, including the restricted permissions a
+    // shell `pm grant` cannot, and it leaves user-set permissions alone.
+    // Reads the same directories as
+    // DefaultPermissionGrantPolicy.getDefaultPermissionFiles().
+    private String computeDefaultGrantPackagesToken() {
+        final File[] partitions = {
+                Environment.getRootDirectory(), Environment.getVendorDirectory(),
+                Environment.getOdmDirectory(), Environment.getProductDirectory(),
+                Environment.getSystemExtDirectory(), Environment.getOemDirectory()};
+        final TreeSet<String> names = new TreeSet<>();
+        for (File partition : partitions) {
+            final File[] files = new File(partition, "etc/default-permissions").listFiles();
+            if (files == null) {
+                continue;
+            }
+            for (File file : files) {
+                if (!file.getName().endsWith(".xml")) {
+                    continue;
+                }
+                try (InputStream in = new FileInputStream(file)) {
+                    final XmlPullParser parser = Xml.newPullParser();
+                    parser.setInput(in, null);
+                    int type;
+                    while ((type = parser.next()) != XmlPullParser.END_DOCUMENT) {
+                        if (type == XmlPullParser.START_TAG
+                                && "exception".equals(parser.getName())) {
+                            final String pkg = parser.getAttributeValue(null, "package");
+                            if (pkg != null) {
+                                names.add(pkg);
+                            }
+                        }
+                    }
+                } catch (IOException | XmlPullParserException e) {
+                    Slog.w(TAG, "Cannot read default permissions file " + file, e);
+                }
+            }
+        }
+        final StringBuilder installed = new StringBuilder();
+        for (String name : names) {
+            final PackageSetting ps = mPackages.get(name);
+            if (ps != null && ps.isSystem()) {
+                installed.append(name).append(':').append(ps.getVersionCode()).append(';');
+            }
+        }
+        try {
+            final byte[] digest = MessageDigest.getInstance("SHA-256")
+                    .digest(installed.toString().getBytes(StandardCharsets.UTF_8));
+            return HexEncoding.encodeToString(Arrays.copyOf(digest, 6), false);
+        } catch (NoSuchAlgorithmException e) {
+            return Integer.toHexString(installed.toString().hashCode());
+        }
     }
 
