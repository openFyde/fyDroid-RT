+    /* package */ boolean maybeHandleTimeoutMessage(Message msg) {
+        int type;
+        switch (msg.what) {
+            case SERVICE_TIMEOUT_MSG:
+                type = 2;
+                break;
+            case PROC_START_TIMEOUT_MSG:
+                type = 6;
+                break;
+            case CONTENT_PROVIDER_PUBLISH_TIMEOUT_MSG:
+                type = 4;
+                break;
+            case SERVICE_FOREGROUND_TIMEOUT_MSG:
+                type = 2;
+                break;
+            default:
+                return false;
+        }
+        if (msg.arg1 != 0) {
+            if (msg.arg1 == 43797) {
+                ((ArcAnrService) LocalServices.getService(ArcAnrService.class))
+                        .onAnrRecoveryFailed(type);
+                return false;
+            }
+            Slog.wtf(TAG, "Unexpected arguments for timeout message: " + msg);
+            return false;
+        }
+        if (msg.arg2 == 0) {
+            Slog.wtf(TAG, "Timeout was not set in the message: " + msg);
+            return false;
+        }
+        if (!isARCThrottled()) {
+            return false;
+        }
+        ((ArcAnrService) LocalServices.getService(ArcAnrService.class)).onPreAnr(type);
+        Message msgNew = msg.getTarget().obtainMessage();
+        msgNew.copyFrom(msg);
+        msgNew.arg1 = 43797;
+        msgNew.getTarget().sendMessageDelayed(msgNew, msgNew.arg2);
+        return true;
+    }
