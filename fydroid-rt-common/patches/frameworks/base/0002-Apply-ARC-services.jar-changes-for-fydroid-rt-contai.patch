+package com.android.server.power;
+
+/**
+ * Stub for ARC++ ANR pre-notification service.
+ * The real implementation is provided by ArcPowerManagerService and registered
+ * via LocalServices. This stub exists only for compilation.
+ */
+public abstract class ArcAnrService {
+    /**
+     * Called before an ANR is triggered when CPU is throttled.
+     * @param type ANR type: 2=service/fg_service, 3=broadcast, 4=content_provider, 6=proc_start
+     */
+    public abstract void onPreAnr(int type);
+
+    /**
+     * Called when ANR recovery failed (after the retry with arg1=43797).
+     * @param type ANR type (same values as onPreAnr)
+     */
+    public abstract void onAnrRecoveryFailed(int type);
+}
