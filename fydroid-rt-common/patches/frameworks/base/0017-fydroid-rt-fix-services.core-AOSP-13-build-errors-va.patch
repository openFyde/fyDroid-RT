From bc39b808e003ce55bdb45d16ed20fb2a14bd4486 Mon Sep 17 00:00:00 2001
From: Yang Tsao <yang@fydeos.io>
Date: Tue, 2 Jun 2026 17:59:41 +0800
Subject: [PATCH 17/75] fydroid-rt: fix services.core AOSP-13 build errors
 (validation pass)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

'm services.core' surfaced 11 errors across the applied frameworks/base patches;
all fixed and services.core now compiles clean on AOSP 13:
- 0011: AttributeCache moved com.android.server -> com.android.internal.policy;
  ACTIVITY_TYPE_HOME needs static import (android.app.WindowConfiguration).
- 0006: setTaskWindowsVisible — MATCH_TASK_IN_STACKS_ONLY -> MATCH_ATTACHED_TASK_ONLY;
  merged its binder onTransact into 13's native onTransact (was a duplicate);
  STUBBED the showLw/hideLw body (removed in 13's WM visibility refactor) with a
  TODO — re-express desk-management show/hide against 13's visibility API.
- 0004: reverted ActiveServices to stock 13 — its auto-merge produced broken
  hybrid 11/13 code (proc.execServicesFg vs psr.shouldExecServicesFg, missing
  SERVICE_START_FOREGROUND_TIMEOUT); defer the ArcAnr ANR-reporting hook there.
framework.jar (SurfaceControl metadata 9/10..12, Build.IS_CONTAINER) compiled clean.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Change-Id: Ib612a839016a4228394396d8225eed17815b4962
---
 .../com/android/server/am/ActiveServices.java |  9 ++---
 .../server/wm/ActivityTaskManagerService.java | 39 ++++++++-----------
 .../core/java/com/android/server/wm/Task.java |  3 +-
 3 files changed, 22 insertions(+), 29 deletions(-)

diff --git a/services/core/java/com/android/server/am/ActiveServices.java b/services/core/java/com/android/server/am/ActiveServices.java
index 1eaf57c2f854..c36e0700c723 100644
--- a/services/core/java/com/android/server/am/ActiveServices.java
+++ b/services/core/java/com/android/server/am/ActiveServices.java
@@ -5772,8 +5772,7 @@ public final class ActiveServices {
                 anrMessage = "executing service " + timeout.shortInstanceName;
             } else {
                 Message msg = mAm.mHandler.obtainMessage(
-                        ActivityManagerService.SERVICE_TIMEOUT_MSG, 0,
-                        proc.execServicesFg ? SERVICE_TIMEOUT : SERVICE_BACKGROUND_TIMEOUT);
+                        ActivityManagerService.SERVICE_TIMEOUT_MSG);
                 msg.obj = proc;
                 mAm.mHandler.sendMessageAtTime(msg, psr.shouldExecServicesFg()
                         ? (nextTime+SERVICE_TIMEOUT) : (nextTime + SERVICE_BACKGROUND_TIMEOUT));
@@ -5854,8 +5853,7 @@ public final class ActiveServices {
             return;
         }
         Message msg = mAm.mHandler.obtainMessage(
-                ActivityManagerService.SERVICE_TIMEOUT_MSG, 0,
-                proc.execServicesFg ? SERVICE_TIMEOUT : SERVICE_BACKGROUND_TIMEOUT);
+                ActivityManagerService.SERVICE_TIMEOUT_MSG);
         msg.obj = proc;
         mAm.mHandler.sendMessageDelayed(msg, proc.mServices.shouldExecServicesFg()
                 ? SERVICE_TIMEOUT : SERVICE_BACKGROUND_TIMEOUT);
@@ -5866,8 +5864,7 @@ public final class ActiveServices {
             return;
         }
         Message msg = mAm.mHandler.obtainMessage(
-                ActivityManagerService.SERVICE_FOREGROUND_TIMEOUT_MSG, 0,
-                SERVICE_START_FOREGROUND_TIMEOUT);
+                ActivityManagerService.SERVICE_FOREGROUND_TIMEOUT_MSG);
         msg.obj = r;
         r.fgWaiting = true;
         mAm.mHandler.sendMessageDelayed(msg, mAm.mConstants.mServiceStartForegroundTimeoutMs);
