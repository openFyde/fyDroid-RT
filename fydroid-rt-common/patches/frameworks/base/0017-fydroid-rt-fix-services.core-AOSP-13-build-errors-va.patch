-                    }
-                }, true /* traverseTopToBottom */);
+                // fydroid-rt TODO(AOSP-13 WM port): WindowState.showLw/hideLw were removed
+                // in the AOSP 12/13 visibility refactor (window visibility is now policy-
+                // computed). Re-express this desk-management show/hide against the 13 WM
+                // visibility API (e.g. Task/ActivityRecord setVisibility / forceHidden).
+                // Stubbed to a no-op for now so the binder hook compiles and is callable.
+                Slog.i(TAG, "setTaskWindowsVisible(taskId=" + taskId + ", visible=" + visible
+                        + "): no-op pending AOSP-13 WM visibility port");
                 mWindowManager.mWindowPlacerLocked.performSurfacePlacement();
             }
         } finally {
@@ -5374,6 +5360,15 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
     @Override
     public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
             throws RemoteException {
+        // fydroid-rt: manual binder transaction for setTaskWindowsVisible (not in the AIDL).
+        if (code == TRANSACTION_setTaskWindowsVisible) {
+            data.enforceInterface("android.app.IActivityTaskManager");
+            int taskId = data.readInt();
+            boolean visible = data.readInt() != 0;
+            setTaskWindowsVisible(taskId, visible);
