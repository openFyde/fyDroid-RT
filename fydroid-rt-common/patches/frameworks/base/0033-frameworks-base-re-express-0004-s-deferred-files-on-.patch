+        if (Build.HARDWARE.equals("cheets")) {
+            t.traceBegin("StartArcAppFuseMounterService");
+            mSystemServiceManager.startService(ARC_APP_FUSE_MOUNTER_SERVICE_CLASS);
+            t.traceEnd();
+            t.traceBegin("StartArcObbMounterService");
+            mSystemServiceManager.startService(ARC_OBB_MOUNTER_SERVICE_CLASS);
+            t.traceEnd();
+        }
+
         // Permission policy service
         t.traceBegin("StartPermissionPolicyService");
         mSystemServiceManager.startService(PermissionPolicyService.class);
