From 3bec7e9a9d9b5b8420217fde00aa39dee4895735 Mon Sep 17 00:00:00 2001
From: Yang Tsao <yang@fydeos.io>
Date: Fri, 24 Apr 2026 13:30:23 +0800
Subject: [PATCH 3/5] Switch OMX and mediacodec to 64-bit for ARM64 container

- OMX: compile_multilib 32 -> both (needed for 64-bit codec2 service)
- mediacodec: compile_multilib 32 -> 64 (ARM64-only container)
- seccomp: use 64-bit syscall names (mmap, fstat, getuid, etc.)
  and reference arm64 crash_dump/code_coverage policies

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
Change-Id: I12ef3e7a5d6503ef5bc8391f5339d3c2e7be58f5
---
 media/libstagefright/omx/Android.bp           |  2 +-
 services/mediacodec/Android.bp                |  3 +--
 .../seccomp_policy/mediacodec-arm64.policy    | 21 ++++++++-----------
 3 files changed, 11 insertions(+), 15 deletions(-)

diff --git a/media/libstagefright/omx/Android.bp b/media/libstagefright/omx/Android.bp
index 54c5697c14..656c18367e 100644
--- a/media/libstagefright/omx/Android.bp
+++ b/media/libstagefright/omx/Android.bp
@@ -209,7 +209,7 @@ cc_defaults {
         cfi: true,
     },
 
-    compile_multilib: "32",
+    compile_multilib: "both",
 }
 
 cc_library_shared {
diff --git a/services/mediacodec/Android.bp b/services/mediacodec/Android.bp
index 4488efb026..1c3d36e607 100644
--- a/services/mediacodec/Android.bp
+++ b/services/mediacodec/Android.bp
@@ -117,8 +117,7 @@ cc_binary {
         "libstagefright_softomx_plugin",
     ],
 
-    // OMX interfaces force this to stay in 32-bit mode;
-    compile_multilib: "32",
+    compile_multilib: "64",
 
     init_rc: ["android.hardware.media.omx@1.0-service.rc"],
 
diff --git a/services/mediacodec/seccomp_policy/mediacodec-arm64.policy b/services/mediacodec/seccomp_policy/mediacodec-arm64.policy
index b4a9ff6249..f5adada5b6 100644
--- a/services/mediacodec/seccomp_policy/mediacodec-arm64.policy
+++ b/services/mediacodec/seccomp_policy/mediacodec-arm64.policy
@@ -11,11 +11,10 @@ close: 1
 writev: 1
 dup: 1
 ppoll: 1
-mmap2: 1
+mmap: 1
 getrandom: 1
 memfd_create: 1
 ftruncate: 1
-ftruncate64: 1
 
 # mremap: Ensure |flags| are (MREMAP_MAYMOVE | MREMAP_FIXED) TODO: Once minijail
 # parser support for '<' is in this needs to be modified to also prevent
@@ -31,9 +30,9 @@ openat: 1
 sigaltstack: 1
 clone: 1
 setpriority: 1
-getuid32: 1
-fstat64: 1
-fstatfs64: 1
+getuid: 1
+fstat: 1
+fstatfs: 1
 pread64: 1
 faccessat: 1
 readlinkat: 1
@@ -48,16 +47,14 @@ gettimeofday: 1
 sched_yield: 1
 nanosleep: 1
 lseek: 1
-_llseek: 1
 sched_get_priority_max: 1
 sched_get_priority_min: 1
-statfs64: 1
+statfs: 1
 sched_setscheduler: 1
-fstatat64: 1
-ugetrlimit: 1
+newfstatat: 1
+getrlimit: 1
 getdents64: 1
-getrandom: 1
 
-@include /system/etc/seccomp_policy/crash_dump.arm.policy
+@include /system/etc/seccomp_policy/crash_dump.arm64.policy
 
-@include /system/etc/seccomp_policy/code_coverage.arm.policy
+@include /system/etc/seccomp_policy/code_coverage.arm64.policy
-- 
2.43.0

