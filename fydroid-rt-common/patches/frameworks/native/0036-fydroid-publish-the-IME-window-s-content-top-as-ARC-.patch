From 528ebefdf9edb95064fda1415986433c839ed2ac Mon Sep 17 00:00:00 2001
From: Yang Tsao <yang@fydeos.io>
Date: Wed, 19 Aug 2026 17:00:52 +0800
Subject: [PATCH 36/40] fydroid: publish the IME window's content top as ARC
 layer metadata

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Change-Id: I32d24a2608df48504a99cd3fa6df6d75b7ef612b
---
 libs/gui/include/gui/LayerMetadata.h       | 9 +++++++++
 services/surfaceflinger/SurfaceFlinger.cpp | 1 +
 2 files changed, 10 insertions(+)

diff --git a/libs/gui/include/gui/LayerMetadata.h b/libs/gui/include/gui/LayerMetadata.h
index 8c0e42f1f4..18c11b664c 100644
--- a/libs/gui/include/gui/LayerMetadata.h
+++ b/libs/gui/include/gui/LayerMetadata.h
@@ -41,6 +41,15 @@ enum {
                                         // non-dialog task (e.g. brightness dialog
                                         // over Settings). Routed to its own modal
                                         // window instead of the host task footprint.
+    // Top of the IME window's content (the keys) within the window, in px.
+    // An IME window is the full display with a transparent area above the
+    // keyboard, so the compositor cannot tell where the keys start; without
+    // this the input-method surface takes input across the whole desktop.
+    // NB: every key in SurfaceFlinger's generic-metadata map that shares an id
+    // is emitted with that id's value, so a duplicate id here does not merely
+    // alias — it publishes this int under the other key's name too. 13 was
+    // tried first and made every IME layer look like a floating activity.
+    METADATA_IME_CONTENT_TOP = 14,
     METADATA_NOTIFICATION_KEY = 0x40000000,  // ARC++ notification surface key
 };
 
diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 6af02f1a6e..9d0ad469d7 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -7230,6 +7230,7 @@ const std::unordered_map<std::string, uint32_t>& SurfaceFlinger::getGenericLayer
             {"org.chromium.arc.V1_0.IsGame", METADATA_IS_GAME},
             {"org.chromium.arc.V1_0.IsDialogTask", METADATA_IS_DIALOG},
             {"org.chromium.arc.V1_0.IsHome", METADATA_IS_HOME},
+            {"org.chromium.arc.V1_0.ImeContentTop", METADATA_IME_CONTENT_TOP},
             // fydroid: a floating-themed activity stacked on a non-dialog task
             // (e.g. brightness dialog over Settings). Set on the activity's own
             // surface so the compositor splits it into its own modal window
-- 
