@@ -1044,14 +1044,20 @@ bool Layer::setMetadata(const LayerMetadata& data) {
     if (data.has(METADATA_TASK_ID)) {
         int32_t taskId = data.getInt32(METADATA_TASK_ID, 0);
         if (taskId > 0) {
+            int propagated = 0;
             mCurrentChildren.traverse([&](Layer* child) {
                 if (!child->mDrawingState.metadata.has(METADATA_TASK_ID)) {
                     child->mDrawingState.metadata.setInt32(METADATA_TASK_ID, taskId);
                     child->mDrawingState.sequence++;
                     child->mDrawingState.modified = true;
                     child->setTransactionFlags(eTransactionNeeded);
+                    propagated++;
+                    ALOGI("TaskId propagation: %s → child '%s' taskId=%d",
+                          mName.c_str(), child->mName.c_str(), taskId);
                 }
             });
+            ALOGI("TaskId propagation: set on '%s' taskId=%d children_propagated=%d",
+                  mName.c_str(), taskId, propagated);
         }
     }
     // Propagate IsDialog to descendants so HWC sees the flag on any
@@ -1633,6 +1639,10 @@ void Layer::addChild(const sp<Layer>& layer) {
                 break;
             }
         }
+        if (!layer->mDrawingState.metadata.has(METADATA_TASK_ID)) {
+            ALOGI("addChild: '%s' added to '%s' — no ancestor has TaskId",
