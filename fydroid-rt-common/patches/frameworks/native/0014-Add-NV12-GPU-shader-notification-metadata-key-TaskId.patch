+    // NV12/YCbCr → RGBA GPU shader conversion.
+    // GPU can't sample NV12 directly on some platforms (Mesa/panfrost).
+    // Per-plane dmabuf import + custom shader converts to RGBA for composition.
+    bool mNv12ConverterInited = false;
+    GLuint mNv12Program = 0;
+    GLuint mNv12VBO = 0;
+    GLuint mNv12FBO = 0;
+    GLuint mNv12YTex = 0;
+    GLuint mNv12UVTex = 0;
+    GLuint mNv12OutputTex = 0;
+    EGLImageKHR mNv12OutputEGLImage = EGL_NO_IMAGE_KHR;
+    uint32_t mNv12OutputW = 0;
+    uint32_t mNv12OutputH = 0;
+    void initNv12Converter();
+    bool convertNv12ViaShader(const sp<GraphicBuffer>& buffer, uint32_t texName);
+
     // Blur effect processor, only instantiated when a layer requests it.
     BlurFilter* mBlurFilter = nullptr;
 
diff --git a/services/surfaceflinger/Layer.cpp b/services/surfaceflinger/Layer.cpp
index e0f25cfef9..9ab0918584 100644
--- a/services/surfaceflinger/Layer.cpp
