+void Output::detectAndAdjustDialogTasks() {
+    // Android window type constants (from WindowManager.LayoutParams)
+    static constexpr int TYPE_APPLICATION_ATTACHED_DIALOG = 1003;
+    // Collect layers into a vector for indexed access
+    std::vector<compositionengine::OutputLayer*> layers;
+    for (auto* layer : getOutputLayersOrderedByZ()) {
+        // Reset dialog flag each geometry pass
+        layer->editState().isDialogContainer = false;
+
+        layers.push_back(layer);
+    }
+
+    // --- Method 1: Detect by TYPE_APPLICATION_ATTACHED_DIALOG window type ---
+    //
+    // Anchor on the content layer (type=1003), then walk backwards to find
+    // [container(SOLID_COLOR), dim?(SOLID_COLOR), content(type=1003)].
+    for (size_t i = 0; i < layers.size(); i++) {
+        const auto* feState = layers[i]->getLayerFE().getCompositionState();
+        if (!feState || feState->type != TYPE_APPLICATION_ATTACHED_DIALOG) continue;
+
+        const Rect contentFrame = layers[i]->getState().displayFrame;
+        if (contentFrame.isEmpty()) continue;
+
+        // Walk backwards through SOLID_COLOR layers that contain the content.
+        // First hit = dim or container; second hit with same frame = container.
+        compositionengine::OutputLayer* firstSolid = nullptr;
+        compositionengine::OutputLayer* secondSolid = nullptr;
+        Rect outerFrame;
+
+        for (size_t j = i; j > 0; ) {
+            --j;
+            const auto* jFeState = layers[j]->getLayerFE().getCompositionState();
+            if (!jFeState) continue;
+            if (jFeState->compositionType != Composition::SOLID_COLOR) break;
+
+            const Rect& jFrame = layers[j]->getState().displayFrame;
+            if (jFrame.isEmpty()) continue;
+            // Must strictly contain the content frame
+            if (jFrame.left > contentFrame.left || jFrame.top > contentFrame.top ||
+                jFrame.right < contentFrame.right || jFrame.bottom < contentFrame.bottom) break;
+            if (jFrame == contentFrame) continue;
+
+            if (!firstSolid) {
+                firstSolid = layers[j];
+                outerFrame = jFrame;
+            } else if (jFrame == outerFrame) {
+                secondSolid = layers[j];
+                break;
+            } else {
+                break;
+            }
+        }
+
+        if (!firstSolid) continue;
+
+        // Skip if container is much larger than content — this is an in-task
+        // dialog within a parent task, not a standalone dialog task.
+        {
+            int32_t outerW = outerFrame.right - outerFrame.left;
+            int32_t outerH = outerFrame.bottom - outerFrame.top;
+            int32_t cntW = contentFrame.right - contentFrame.left;
+            int32_t cntH = contentFrame.bottom - contentFrame.top;
+            if (cntW > 0 && cntH > 0 &&
+                (outerW > cntW * 3 / 2 || outerH > cntH * 3 / 2)) {
+                ALOGI("Skipping in-task dialog (type=1003): container %dx%d vs content %dx%d",
+                      outerW, outerH, cntW, cntH);
+                continue;
+            }
+        }
+
+        if (secondSolid) {
+            // [secondSolid=container, firstSolid=dim, content]
+            firstSolid->editState().skipClientComposition = true;
+            secondSolid->editState().skipClientComposition = true;
+            secondSolid->editState().displayFrame = contentFrame;
+            secondSolid->editState().isDialogContainer = true;
+            ALOGI("Dialog detected (type=1003): content='%s' container=[%d,%d,%d,%d] "
+                  "content=[%d,%d,%d,%d]",
+                  layers[i]->getLayerFE().getDebugName(),
+                  outerFrame.left, outerFrame.top, outerFrame.right, outerFrame.bottom,
+                  contentFrame.left, contentFrame.top, contentFrame.right, contentFrame.bottom);
+        } else {
+            // [firstSolid=container, content] — no dim layer
+            firstSolid->editState().skipClientComposition = true;
+            firstSolid->editState().displayFrame = contentFrame;
+            firstSolid->editState().isDialogContainer = true;
+            ALOGI("Dialog detected (type=1003, no dim): content='%s' container=[%d,%d,%d,%d] "
+                  "content=[%d,%d,%d,%d]",
+                  layers[i]->getLayerFE().getDebugName(),
+                  outerFrame.left, outerFrame.top, outerFrame.right, outerFrame.bottom,
+                  contentFrame.left, contentFrame.top, contentFrame.right, contentFrame.bottom);
+        }
+    }
+
+    // --- Method 2: Detect by "Dim Layer for" name (fallback) ---
+    //
+    // Catches dialog-themed Activities (type=1, not 1003) that still use
+    // FLAG_DIM_BEHIND. Skips layers already handled by Method 1.
+    for (size_t i = 0; i < layers.size(); i++) {
+        auto& layerFE = layers[i]->getLayerFE();
+        const char* name = layerFE.getDebugName();
+
+        if (strncmp(name, "Dim Layer for", 13) != 0) continue;
+
+        const Rect dimFrame = layers[i]->getState().displayFrame;
+        if (dimFrame.isEmpty()) continue;
+
+        // Container = SOLID_COLOR layer below with same frame
+        if (i == 0) continue;
+        auto* containerLayer = layers[i - 1];
+        // Skip if already handled by Method 1
+        if (containerLayer->getState().skipClientComposition) continue;
+        const auto* containerFEState = containerLayer->getLayerFE().getCompositionState();
+        if (!containerFEState) continue;
+        if (containerFEState->compositionType != Composition::SOLID_COLOR) continue;
+        if (containerLayer->getState().displayFrame != dimFrame) continue;
+
+        // Content = layers above dim with smaller contained frame
+        Rect contentFrame;
+        bool hasContent = false;
+        for (size_t j = i + 1; j < layers.size(); j++) {
+            const Rect& frame = layers[j]->getState().displayFrame;
+            if (frame.isEmpty()) continue;
+            if (frame.left < dimFrame.left || frame.top < dimFrame.top ||
+                frame.right > dimFrame.right || frame.bottom > dimFrame.bottom) break;
+            if (frame == dimFrame) continue;
+            if (!hasContent) {
+                contentFrame = frame;
+                hasContent = true;
+            } else {
+                contentFrame.left = std::min(contentFrame.left, frame.left);
+                contentFrame.top = std::min(contentFrame.top, frame.top);
+                contentFrame.right = std::max(contentFrame.right, frame.right);
+                contentFrame.bottom = std::max(contentFrame.bottom, frame.bottom);
+            }
+        }
+
+        if (!hasContent || contentFrame.isEmpty()) continue;
+
+        ALOGI("Dialog detected (dim name): dim='%s' container=[%d,%d,%d,%d] "
+              "content=[%d,%d,%d,%d]",
+              name, dimFrame.left, dimFrame.top, dimFrame.right, dimFrame.bottom,
+              contentFrame.left, contentFrame.top, contentFrame.right, contentFrame.bottom);
+
+        layers[i]->editState().skipClientComposition = true;
+        containerLayer->editState().skipClientComposition = true;
+        containerLayer->editState().displayFrame = contentFrame;
+        containerLayer->editState().isDialogContainer = true;
+    }
+}
