-
-    // Bind Y texture (GL_TEXTURE_EXTERNAL_OES for dmabuf imports)
-    glActiveTexture(GL_TEXTURE0);
-    glBindTexture(GL_TEXTURE_EXTERNAL_OES, mNv12YTex);
-    glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, (GLeglImageOES)yImage);
