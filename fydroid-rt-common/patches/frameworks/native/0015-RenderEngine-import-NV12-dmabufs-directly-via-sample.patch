 }
 
 // ---------------------------------------------------------------------------
-// NV12/YCbCr → RGBA GPU shader conversion
+// NV12/YCbCr direct dmabuf import. The driver (Mesa Panfrost) does YUV→RGB
+// conversion at sample time inside samplerExternalOES, so we don't need a
+// custom shader, FBO, intermediate texture, or persistent EGLImage state.
+// The layer's texName is bound directly to the NV12 dmabuf via a per-call
+// EGLImage with both planes specified — same lifetime as the layer compose,
+// no leakage into subsequent layers.
 // ---------------------------------------------------------------------------
 
-static const char* kNv12VertexShader = R"(
-    attribute vec2 position;
-    varying vec2 vTexCoord;
-    void main() {
-        vTexCoord = position * 0.5 + 0.5;
-        gl_Position = vec4(position, 0.0, 1.0);
-    }
-)";
-
-static const char* kNv12FragmentShader = R"(
-    #extension GL_OES_EGL_image_external : require
-    precision mediump float;
-    varying vec2 vTexCoord;
-    uniform samplerExternalOES y_tex;
-    uniform samplerExternalOES uv_tex;
-    void main() {
-        vec3 yuv;
-        yuv.x = texture2D(y_tex, vTexCoord).r;
-        yuv.yz = texture2D(uv_tex, vTexCoord).rg - vec2(0.5, 0.5);
-        vec3 rgb = mat3(
-            1.0, 1.0, 1.0,
-            0.0, -0.344, 1.772,
-            1.403, -0.714, 0.0
-        ) * yuv;
-        gl_FragColor = vec4(clamp(rgb, 0.0, 1.0), 1.0);
-    }
-)";
-
-static GLuint compileShader(GLenum type, const char* source) {
-    GLuint shader = glCreateShader(type);
-    glShaderSource(shader, 1, &source, nullptr);
-    glCompileShader(shader);
-    GLint compiled = 0;
-    glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
-    if (!compiled) {
-        GLint len = 0;
-        glGetShaderiv(shader, GL_INFO_LOG_LENGTH, &len);
-        std::string log(len, '\0');
-        glGetShaderInfoLog(shader, len, nullptr, log.data());
-        ALOGE("NV12 shader compile failed: %s", log.c_str());
-        glDeleteShader(shader);
-        return 0;
-    }
-    return shader;
-}
-
-void GLESRenderEngine::initNv12Converter() {
-    if (mNv12ConverterInited) return;
-    mNv12ConverterInited = true;
-
-    GLuint vs = compileShader(GL_VERTEX_SHADER, kNv12VertexShader);
-    GLuint fs = compileShader(GL_FRAGMENT_SHADER, kNv12FragmentShader);
-    if (!vs || !fs) {
-        ALOGE("initNv12Converter: shader compilation failed");
-        if (vs) glDeleteShader(vs);
-        if (fs) glDeleteShader(fs);
-        return;
-    }
-
-    mNv12Program = glCreateProgram();
-    glAttachShader(mNv12Program, vs);
-    glAttachShader(mNv12Program, fs);
-    glLinkProgram(mNv12Program);
-    glDeleteShader(vs);
-    glDeleteShader(fs);
-
-    GLint linked = 0;
-    glGetProgramiv(mNv12Program, GL_LINK_STATUS, &linked);
-    if (!linked) {
-        ALOGE("initNv12Converter: program link failed");
-        glDeleteProgram(mNv12Program);
-        mNv12Program = 0;
-        return;
-    }
-
-    // Fullscreen quad VBO
-    static const GLfloat vertices[] = { -1, -1, 1, -1, -1, 1, 1, 1 };
-    glGenBuffers(1, &mNv12VBO);
-    glBindBuffer(GL_ARRAY_BUFFER, mNv12VBO);
-    glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);
-    glBindBuffer(GL_ARRAY_BUFFER, 0);
-
-    // FBO + textures
-    glGenFramebuffers(1, &mNv12FBO);
-    glGenTextures(1, &mNv12YTex);
-    glGenTextures(1, &mNv12UVTex);
-    glGenTextures(1, &mNv12OutputTex);
-
-    ALOGI("initNv12Converter: program=%u fbo=%u", mNv12Program, mNv12FBO);
-}
