Subject: [PATCH 4/6] =?UTF-8?q?fydroid:=20encode=20hooks=20=E2=80=94=20plu?=
 =?UTF-8?q?ggable=20VideoEncoder=20+=20device-free=20profiles?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Symmetric to the decode hooks, so the Mojo encode path can reuse the upstream
V4L2EncodeComponent + V4L2EncodeInterface instead of forking them:

- V4L2EncodeComponent: add a pluggable EncoderFactoryCB (SetEncoderFactory),
  defaulting to V4L2Encoder::create. libfydroid_c2_mojo overrides it with
  MojoEncoder::Create (implementing the stock VideoEncoder interface) so the
  reused encode component talks Mojo IPC to Chrome's VEA.
- V4L2EncodeInterface: make the V4L2Device profile query optional. When there is
  no V4L2 encoder device (Mojo path), fall back to a fixed per-codec profile set
  (H.264: CBP/BP/Main/High) + 4096x4096 max, so the interface still constructs.
  Chrome's VEA validates the real profile at encode time. (patch 0006 intent.)

Local commit only. MojoEncoder (VideoEncoder impl) lands device-side next.

Change-Id: I5dd62f8a5b398c6384f61fff522c3c58276f3364
---
 components/V4L2EncodeComponent.cpp            | 13 +++-
 components/V4L2EncodeInterface.cpp            | 59 ++++++++++++-------
 .../components/V4L2EncodeComponent.h          | 22 +++++++
 3 files changed, 73 insertions(+), 21 deletions(-)

diff --git a/components/V4L2EncodeComponent.cpp b/components/V4L2EncodeComponent.cpp
index c2a2679..2b72299 100644
--- a/components/V4L2EncodeComponent.cpp
+++ b/components/V4L2EncodeComponent.cpp
@@ -200,6 +200,17 @@ bool IsH264Profile(C2Config::profile_t profile) {
 // static
 std::atomic<int32_t> V4L2EncodeComponent::sConcurrentInstances = 0;
 
+// static
+// fydroid: default to the in-tree V4L2 backend; overridden by
+// libfydroid_c2_mojo's encoder registrar to inject MojoEncoder.
+V4L2EncodeComponent::EncoderFactoryCB V4L2EncodeComponent::sEncoderFactory =
+        &V4L2Encoder::create;
+
+// static
+void V4L2EncodeComponent::SetEncoderFactory(EncoderFactoryCB factory) {
+    sEncoderFactory = factory ? factory : &V4L2Encoder::create;
+}
+
 // static
 std::shared_ptr<C2Component> V4L2EncodeComponent::create(
         C2String name, c2_node_id_t id, std::shared_ptr<C2ReflectorHelper> helper,
@@ -654,7 +665,7 @@ bool V4L2EncodeComponent::initializeEncoder() {
     mBitrateMode = mInterface->getBitrateMode();
     mBitrate = mInterface->getBitrate();
 
-    mEncoder = V4L2Encoder::create(
+    mEncoder = sEncoderFactory(
             outputProfile, h264Level, mInterface->getInputVisibleSize(), *stride,
             mInterface->getKeyFramePeriod(), mBitrateMode, mBitrate,
             mBitrate * kPeakBitrateMultiplier,
diff --git a/components/V4L2EncodeInterface.cpp b/components/V4L2EncodeInterface.cpp
index 03d8c37..ce097d6 100644
--- a/components/V4L2EncodeInterface.cpp
+++ b/components/V4L2EncodeInterface.cpp
@@ -242,13 +242,6 @@ V4L2EncodeInterface::V4L2EncodeInterface(const C2String& name,
 }
 
 void V4L2EncodeInterface::Initialize(const C2String& name) {
-    scoped_refptr<V4L2Device> device = V4L2Device::create();
-    if (!device) {
-        ALOGE("Failed to create V4L2 device");
-        mInitStatus = C2_CORRUPTED;
-        return;
-    }
-
     auto codec = getCodecFromComponentName(name);
     if (!codec) {
         ALOGE("Invalid component name");
@@ -256,28 +249,54 @@ void V4L2EncodeInterface::Initialize(const C2String& name) {
         return;
     }
 
-    V4L2Device::SupportedEncodeProfiles supported_profiles = device->getSupportedEncodeProfiles();
-
     // Compile the list of supported profiles.
     // Note: unsigned int is used here, since std::vector<C2Config::profile_t> cannot convert to
     // std::vector<unsigned int> required by the c2 framework below.
     std::vector<unsigned int> profiles;
     ui::Size maxSize;
-    for (const auto& supportedProfile : supported_profiles) {
-        if (!IsValidProfileForCodec(codec.value(), supportedProfile.profile)) {
-            continue;  // Ignore unrecognizable or unsupported profiles.
+
+    // fydroid: the encode backend may be Mojo IPC to Chrome's VEA, in which case
+    // there is no V4L2 encoder device to enumerate. Query the device when present;
+    // otherwise (or if it reports nothing) fall back to a fixed profile set so the
+    // interface still constructs — Chrome's VEA validates the real profile at
+    // encode time. See device/fydeos/docs/c2-codec2-mojo-port-plan.md.
+    scoped_refptr<V4L2Device> device = V4L2Device::create();
+    if (device) {
+        V4L2Device::SupportedEncodeProfiles supported_profiles =
+                device->getSupportedEncodeProfiles();
+        for (const auto& supportedProfile : supported_profiles) {
+            if (!IsValidProfileForCodec(codec.value(), supportedProfile.profile)) {
+                continue;  // Ignore unrecognizable or unsupported profiles.
+            }
+            ALOGV("Queried c2_profile = 0x%x : max_size = %d x %d", supportedProfile.profile,
+                  supportedProfile.max_resolution.width, supportedProfile.max_resolution.height);
+            profiles.push_back(static_cast<unsigned int>(supportedProfile.profile));
+            maxSize.setWidth(std::max(maxSize.width, supportedProfile.max_resolution.width));
+            maxSize.setHeight(std::max(maxSize.height, supportedProfile.max_resolution.height));
         }
-        ALOGV("Queried c2_profile = 0x%x : max_size = %d x %d", supportedProfile.profile,
-              supportedProfile.max_resolution.width, supportedProfile.max_resolution.height);
-        profiles.push_back(static_cast<unsigned int>(supportedProfile.profile));
-        maxSize.setWidth(std::max(maxSize.width, supportedProfile.max_resolution.width));
-        maxSize.setHeight(std::max(maxSize.height, supportedProfile.max_resolution.height));
     }
 
     if (profiles.empty()) {
-        ALOGE("No supported profiles");
-        mInitStatus = C2_BAD_VALUE;
-        return;
+        ALOGW("No V4L2 encode device/profiles; using fydroid Mojo fallback profiles for %s",
+              VideoCodecToString(*codec));
+        switch (*codec) {
+        case VideoCodec::H264:
+            profiles = {static_cast<unsigned int>(C2Config::PROFILE_AVC_CONSTRAINED_BASELINE),
+                        static_cast<unsigned int>(C2Config::PROFILE_AVC_BASELINE),
+                        static_cast<unsigned int>(C2Config::PROFILE_AVC_MAIN),
+                        static_cast<unsigned int>(C2Config::PROFILE_AVC_HIGH)};
+            break;
+        case VideoCodec::VP8:
+            profiles = {static_cast<unsigned int>(C2Config::PROFILE_UNUSED)};
+            break;
+        case VideoCodec::VP9:
+            profiles = {static_cast<unsigned int>(C2Config::PROFILE_VP9_0)};
+            break;
+        case VideoCodec::HEVC:
+            profiles = {static_cast<unsigned int>(C2Config::PROFILE_HEVC_MAIN)};
+            break;
+        }
+        maxSize = ui::Size(4096, 4096);
     }
 
     // Special note: the order of addParameter matters if your setters are dependent on other
diff --git a/components/include/v4l2_codec2/components/V4L2EncodeComponent.h b/components/include/v4l2_codec2/components/V4L2EncodeComponent.h
index 0b150e4..407b304 100644
--- a/components/include/v4l2_codec2/components/V4L2EncodeComponent.h
+++ b/components/include/v4l2_codec2/components/V4L2EncodeComponent.h
@@ -22,6 +22,9 @@
 #include <base/synchronization/waitable_event.h>
 #include <base/threading/thread.h>
 #include <util/C2InterfaceHelper.h>
+#include <ui/Size.h>
+
+#include <v4l2_codec2/components/VideoEncoder.h>
 
 namespace android {
 
@@ -40,6 +43,22 @@ public:
 
     virtual ~V4L2EncodeComponent() override;
 
+    // fydroid: pluggable VideoEncoder backend (mirror of V4L2DecodeComponent's
+    // SetDecoderFactory). Defaults to V4L2Encoder::create; libfydroid_c2_mojo
+    // overrides it with MojoEncoder::Create so this reused encode component talks
+    // Mojo IPC to Chrome's VEA instead of /dev/video*. Set before any component
+    // is created. See device/fydeos/docs/c2-codec2-mojo-port-plan.md.
+    using EncoderFactoryCB = std::unique_ptr<VideoEncoder> (*)(
+            C2Config::profile_t profile, std::optional<uint8_t> level,
+            const ui::Size& visibleSize, uint32_t stride, uint32_t keyFramePeriod,
+            C2Config::bitrate_mode_t bitrateMode, uint32_t bitrate,
+            std::optional<uint32_t> peakBitrate, VideoEncoder::FetchOutputBufferCB fetchOutputBufferCb,
+            VideoEncoder::InputBufferDoneCB inputBufferDoneCb,
+            VideoEncoder::OutputBufferDoneCB outputBufferDoneCb,
+            VideoEncoder::DrainDoneCB drainDoneCb, VideoEncoder::ErrorCB errorCb,
+            scoped_refptr<::base::SequencedTaskRunner> taskRunner);
+    static void SetEncoderFactory(EncoderFactoryCB factory);
+
     // Implementation of the C2Component interface.
     c2_status_t start() override;
     c2_status_t stop() override;
@@ -134,6 +153,9 @@ private:
 
     // The number of concurrent encoder instances currently created.
     static std::atomic<int32_t> sConcurrentInstances;
+
+    // fydroid: the active VideoEncoder backend factory (see SetEncoderFactory).
+    static EncoderFactoryCB sEncoderFactory;
     // The component's registered name.
     const C2String mName;
     // The component's id, provided by the C2 framework upon initialization.
