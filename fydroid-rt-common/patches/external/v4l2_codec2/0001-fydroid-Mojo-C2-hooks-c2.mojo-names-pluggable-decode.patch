-const std::string V4L2ComponentName::kVP9SecureDecoder = "c2.v4l2.vp9.decoder.secure";
+// fydroid: these components are backed by Mojo IPC to Chrome (not V4L2 device
+// nodes). The names must match fydroid's media_codecs_c2.xml. Encoders are
+// c2.mojo.*; decoders are c2.mojo-legacy.*. Only the H.264 encoder is wired to
+// Mojo; the VP8/VP9 encoder symbols are kept (renamed) so the upstream V4L2
+// store/encode interface in libv4l2_codec2_components still compiles — that
+// path is unused by fydroid's Mojo C2 service. See
+// device/fydeos/docs/c2-codec2-mojo-port-plan.md.
+const std::string V4L2ComponentName::kH264Encoder = "c2.mojo.avc.encoder";
+const std::string V4L2ComponentName::kVP8Encoder = "c2.mojo.vp8.encoder";
+const std::string V4L2ComponentName::kVP9Encoder = "c2.mojo.vp9.encoder";
+
+const std::string V4L2ComponentName::kH264Decoder = "c2.mojo-legacy.avc.decoder";
+const std::string V4L2ComponentName::kVP8Decoder = "c2.mojo-legacy.vp8.decoder";
+const std::string V4L2ComponentName::kVP9Decoder = "c2.mojo-legacy.vp9.decoder";
+const std::string V4L2ComponentName::kH264SecureDecoder = "c2.mojo-legacy.avc.decoder.secure";
+const std::string V4L2ComponentName::kVP8SecureDecoder = "c2.mojo-legacy.vp8.decoder.secure";
+const std::string V4L2ComponentName::kVP9SecureDecoder = "c2.mojo-legacy.vp9.decoder.secure";
 
