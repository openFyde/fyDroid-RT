diff --git a/components/V4L2DecodeComponent.cpp b/components/V4L2DecodeComponent.cpp
index 456f3c4..0b0915b 100644
--- a/components/V4L2DecodeComponent.cpp
+++ b/components/V4L2DecodeComponent.cpp
@@ -141,6 +141,17 @@ bool isNoShowFrameWork(const C2Work& work, const C2WorkOrdinalStruct& currOrdina
 // static
 std::atomic<int32_t> V4L2DecodeComponent::sConcurrentInstances = 0;
 
+// static
+// fydroid: default to the in-tree V4L2 backend; overridden by
+// libfydroid_c2_mojo's MojoComponentStore to inject MojoDecoder.
+V4L2DecodeComponent::DecoderFactoryCB V4L2DecodeComponent::sDecoderFactory =
+        &V4L2Decoder::Create;
+
+// static
+void V4L2DecodeComponent::SetDecoderFactory(DecoderFactoryCB factory) {
+    sDecoderFactory = factory ? factory : &V4L2Decoder::Create;
+}
+
 // static
 std::shared_ptr<C2Component> V4L2DecodeComponent::create(
         const std::string& name, c2_node_id_t id, const std::shared_ptr<C2ReflectorHelper>& helper,
@@ -232,16 +243,16 @@ void V4L2DecodeComponent::startTask(c2_status_t* status, ::base::WaitableEvent*
 
     // ::base::Unretained(this) is safe here because |mDecoder| is always destroyed before
     // |mDecoderThread| is stopped, so |*this| is always valid during |mDecoder|'s lifetime.
-    mDecoder = V4L2Decoder::Create(*codec, inputBufferSize, minNumOutputBuffers,
-                                   ::base::BindRepeating(&V4L2DecodeComponent::getVideoFramePool,
-                                                         ::base::Unretained(this)),
-                                   ::base::BindRepeating(&V4L2DecodeComponent::onOutputFrameReady,
-                                                         ::base::Unretained(this)),
-                                   ::base::BindRepeating(&V4L2DecodeComponent::reportError,
-                                                         ::base::Unretained(this), C2_CORRUPTED),
-                                   mDecoderTaskRunner);
+    mDecoder = sDecoderFactory(*codec, inputBufferSize, minNumOutputBuffers,
+                               ::base::BindRepeating(&V4L2DecodeComponent::getVideoFramePool,
+                                                     ::base::Unretained(this)),
+                               ::base::BindRepeating(&V4L2DecodeComponent::onOutputFrameReady,
+                                                     ::base::Unretained(this)),
+                               ::base::BindRepeating(&V4L2DecodeComponent::reportError,
+                                                     ::base::Unretained(this), C2_CORRUPTED),
+                               mDecoderTaskRunner);
     if (!mDecoder) {
-        ALOGE("Failed to create V4L2Decoder for %s", VideoCodecToString(*codec));
+        ALOGE("Failed to create decoder for %s", VideoCodecToString(*codec));
         return;
     }
 
diff --git a/components/include/v4l2_codec2/components/V4L2DecodeComponent.h b/components/include/v4l2_codec2/components/V4L2DecodeComponent.h
index 962f7d6..7304c43 100644
--- a/components/include/v4l2_codec2/components/V4L2DecodeComponent.h
+++ b/components/include/v4l2_codec2/components/V4L2DecodeComponent.h
@@ -34,6 +34,18 @@ public:
                         const std::shared_ptr<V4L2DecodeInterface>& intfImpl);
     ~V4L2DecodeComponent() override;
 
+    // fydroid: pluggable VideoDecoder backend. Defaults to V4L2Decoder::Create;
+    // libfydroid_c2_mojo overrides it with MojoDecoder::Create at service init so
+    // this reused decode component talks Mojo IPC to Chrome instead of /dev/video*.
+    // Must be set before any component is created. See
+    // device/fydeos/docs/c2-codec2-mojo-port-plan.md.
+    using DecoderFactoryCB = std::unique_ptr<VideoDecoder> (*)(
+            const VideoCodec& codec, const size_t inputBufferSize,
+            const size_t minNumOutputBuffers, VideoDecoder::GetPoolCB getPoolCb,
+            VideoDecoder::OutputCB outputCb, VideoDecoder::ErrorCB errorCb,
+            scoped_refptr<::base::SequencedTaskRunner> taskRunner);
+    static void SetDecoderFactory(DecoderFactoryCB factory);
+
     // Implementation of C2Component.
     c2_status_t start() override;
     c2_status_t stop() override;
@@ -94,6 +106,9 @@ private:
 
     static std::atomic<int32_t> sConcurrentInstances;
 
+    // fydroid: the active VideoDecoder backend factory (see SetDecoderFactory).
+    static DecoderFactoryCB sDecoderFactory;
+
     // The pointer of component interface implementation.
     std::shared_ptr<V4L2DecodeInterface> mIntfImpl;
     // The pointer of component interface.
