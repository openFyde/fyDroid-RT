From 58e6aa693027168b37fb735b5306760c5b0d2ba3 Mon Sep 17 00:00:00 2001
From: Yang Tsao <yang@fydeos.io>
Date: Wed, 14 Oct 2026 17:44:05 +0800
Subject: [PATCH 5/5] init: wait for the real /data before telling keystore2
 early boot ended

The ARC mini-container fires post-fs-data from late-init before Chrome
bind-mounts /data; vdc earlyBootEnded then made keystore2 open
persistent.sqlite, panic on ENOENT and restart on every cold boot. Gate the
call on ro.data_mounted=1, whose own post-fs-data pass runs it with /data in
place.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I8a8526d54d6a9b22edeb05ee89d2fc845a067af5
---
 rootdir/init.rc | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index ae3fe1aa75..a66dcc823e 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -711,12 +711,17 @@ on post-fs-data
     # to leave room for earlier levels.
     setprop keystore.boot_level 30
 
-    # Now that /data is mounted and we have created /data/misc/keystore,
-    # we can tell keystore to stop allowing use of early-boot keys,
-    # and access its database for the first time to support creation and
-    # use of MAX_BOOT_LEVEL keys.
+# Now that /data is mounted and we have created /data/misc/keystore,
+# we can tell keystore to stop allowing use of early-boot keys,
+# and access its database for the first time to support creation and
+# use of MAX_BOOT_LEVEL keys.
+# ARC: late-init also fires post-fs-data in the mini-container, before Chrome
+# bind-mounts the real /data; keystore2 then panics opening persistent.sqlite
+# (ENOENT). Wait for the second post-fs-data that ro.data_mounted=1 triggers.
+on post-fs-data && property:ro.data_mounted=1
     exec - system system -- /system/bin/vdc keymaster earlyBootEnded
 
+on post-fs-data
     # Multi-installed APEXes are selected using persist props.
     # Load persist properties and override properties (if enabled) from /data,
     # before starting apexd.
-- 
