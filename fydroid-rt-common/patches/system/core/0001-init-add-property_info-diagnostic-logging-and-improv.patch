From 6656e96f58cebeae14711d857ed29744aedbad93 Mon Sep 17 00:00:00 2001
From: Yang Tsao <yang@fydeos.io>
Date: Wed, 15 Apr 2026 15:29:32 +0800
Subject: [PATCH 1/5] init: add property_info diagnostic logging and improve
 mkdir error handling

Add LOG(INFO) messages during CreateSerializedPropertyInfo() to aid debugging
property initialization in container environments. Also check mkdir return
value for /dev/__properties__.

Change-Id: I9f6d98f745671db1973a43db0b95da71a07a51f7
---
 init/property_service.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/init/property_service.cpp b/init/property_service.cpp
index 26341b1967..f5044aab7f 100644
--- a/init/property_service.cpp
+++ b/init/property_service.cpp
@@ -1165,8 +1165,10 @@ bool LoadPropertyInfoFromFile(const std::string& filename,
 void CreateSerializedPropertyInfo() {
     auto property_infos = std::vector<PropertyInfoEntry>();
     if (access("/system/etc/selinux/plat_property_contexts", R_OK) != -1) {
+        LOG(INFO) << "Loading plat_property_contexts";
         if (!LoadPropertyInfoFromFile("/system/etc/selinux/plat_property_contexts",
                                       &property_infos)) {
+            LOG(ERROR) << "Failed to load plat_property_contexts";
             return;
         }
         // Don't check for failure here, since we don't always have all of these partitions.
@@ -1191,7 +1193,9 @@ void CreateSerializedPropertyInfo() {
             LoadPropertyInfoFromFile("/odm/etc/selinux/odm_property_contexts", &property_infos);
         }
     } else {
+        LOG(INFO) << "plat_property_contexts not at /system/etc/selinux/, trying legacy paths";
         if (!LoadPropertyInfoFromFile("/plat_property_contexts", &property_infos)) {
+            LOG(ERROR) << "Failed to load legacy /plat_property_contexts";
             return;
         }
         LoadPropertyInfoFromFile("/system_ext_property_contexts", &property_infos);
@@ -1203,6 +1207,7 @@ void CreateSerializedPropertyInfo() {
 
     auto serialized_contexts = std::string();
     auto error = std::string();
+    LOG(INFO) << "Building property trie from " << property_infos.size() << " entries";
     if (!BuildTrie(property_infos, "u:object_r:default_prop:s0", "string", &serialized_contexts,
                    &error)) {
         LOG(ERROR) << "Unable to serialize property contexts: " << error;
@@ -1210,10 +1215,12 @@ void CreateSerializedPropertyInfo() {
     }
 
     constexpr static const char kPropertyInfosPath[] = "/dev/__properties__/property_info";
+    LOG(INFO) << "Writing property_info (" << serialized_contexts.size() << " bytes)";
     if (!WriteStringToFile(serialized_contexts, kPropertyInfosPath, 0444, 0, 0, false)) {
         PLOG(ERROR) << "Unable to write serialized property infos to file";
     }
     selinux_android_restorecon(kPropertyInfosPath, 0);
+    LOG(INFO) << "CreateSerializedPropertyInfo done";
 }
 
 static void ExportKernelBootProps() {
@@ -1287,7 +1294,9 @@ void PropertyInit() {
     cb.func_audit = PropertyAuditCallback;
     selinux_set_callback(SELINUX_CB_AUDIT, cb);
 
-    mkdir("/dev/__properties__", S_IRWXU | S_IXGRP | S_IXOTH);
+    if (mkdir("/dev/__properties__", S_IRWXU | S_IXGRP | S_IXOTH) && errno != EEXIST) {
+        PLOG(ERROR) << "Failed to mkdir /dev/__properties__";
+    }
     CreateSerializedPropertyInfo();
     if (__system_property_area_init()) {
         LOG(FATAL) << "Failed to initialize property area";
-- 
