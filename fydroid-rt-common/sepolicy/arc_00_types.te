# ARC++ / fydroid-rt type definitions
# Types NOT in AOSP 11 base policy, needed for Chrome OS container runtime.

# --- File types ---
type arc_file, file_type;
type arc_bridge_socket, file_type;
type wayland_socket, file_type;
type cras_socket, file_type;
type camera_socket, file_type;
type camera_dir, file_type;
type chrome_file, file_type;
# Stub for the CrOS-side /run/chrome dir label (defined in chromeos.cil
# file.te as `arc_dir`). Declared here so AOSP secilc accepts rules referring
# to it; merged with the real CrOS definition at policy combine time.
type arc_dir, file_type;
type apkcache_file, file_type;
type debug_bugreport, file_type;
type debug_arc_bugreport, file_type;
type testharness, file_type;
type adb_socket, file_type;
type wl_trace_data_file, file_type, data_file_type, core_data_file_type;
type kcm_data, file_type, data_file_type, core_data_file_type;
type debugfs_sync, fs_type, debugfs_type;
type debugfs_sw_sync, fs_type, debugfs_type;
type sw_sync_dev, dev_type;

