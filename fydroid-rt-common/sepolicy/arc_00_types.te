# --- Property types ---
# AOSP 13 enables enforce_sysprop_owner (PRODUCT_SHIPPING_API_LEVEL >= 31): every
# property_type must carry a system/product/vendor owner attribute or the policy
# fails to link. Use the owner macros (te_macros), classified by namespace:
#   - non-vendor names (arc.*, ro.arc.*, ro.boot.*) set by system_server/init →
#     system-owned. system_restricted: settable only by coredomain, readable
#     system-wide.
#   - vendor.*/ro.vendor.* names → vendor-owned (vendor_restricted).
# These types carry no allow rules in fydroid policy (the container runs
# permissive post-boot), so the owner/scope choice only needs to satisfy the
# neverallows, which it does.

# System-owned (arc.*, ro.arc.*).
system_restricted_prop(chromeos_prop)
# System-owned (ro.boot.* and arc.* set by init / system_server).
system_restricted_prop(arc_drop_caches_prop)
system_restricted_prop(arc_vpn_active_prop)
system_restricted_prop(arc_cache_prop)
system_restricted_prop(arc_demo_prop)
system_restricted_prop(arc_abi_migrationstatus_prop)
system_restricted_prop(disable_boot_completed_prop)
system_restricted_prop(enable_adb_sideloading_prop)
system_restricted_prop(enable_arc_nearby_share_prop)
system_restricted_prop(enable_consumer_auto_update_toggle_prop)
system_restricted_prop(iioservice_present_prop)
system_restricted_prop(locale_prop)
system_restricted_prop(preferred_languages_prop)
system_restricted_prop(supervision_transition_prop)
system_restricted_prop(zram_size_prop)

# Vendor-owned (vendor.arc.*, ro.vendor.arc.*) — split out of chromeos_prop so the
# vendor-namespace properties carry a vendor owner.
vendor_restricted_prop(chromeos_vendor_prop)
# Vendor-owned (ro.vendor.arc.on_boot).
vendor_restricted_prop(chromeos_boot_prop)
# Vendor-owned (vendor.arc.boot_type, ro.vendor.cts_*, ro.vendor.cdm.*).
vendor_restricted_prop(vendor_arc_boot_type_prop)
vendor_restricted_prop(vendor_interaction_helper_prop)
vendor_restricted_prop(vendor_widevine_cdm_prop)

