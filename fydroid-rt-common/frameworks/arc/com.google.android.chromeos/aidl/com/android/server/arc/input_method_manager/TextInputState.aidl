/* Open source replacement for com.android.server.arc.input_method_manager.TextInputState from the proprietary com.google.android.chromeos jar. */
package com.android.server.arc.input_method_manager;

// Hand-written Java Parcelable (NOT a stable AIDL parcelable): the
// proprietary wire format has no size prefix, so we can't declare
// its field list here. See
//   java/com/android/server/arc/input_method_manager/TextInputState.java
// for the actual read/write logic.
parcelable TextInputState;
