java_library {
    name: "org.chromium.arc.bridge",
    installable: true,
    // Non-SDK <uses-library> provided to apps that list it in the manifest
    // (e.g. DocumentsUI); needed for Soong's dexpreopt uses-library check.
    provides_uses_lib: "org.chromium.arc.bridge",
    srcs: [
        "java/**/*.java",
        ":libarcbridge_mojom_java_srcs",
    ],
    libs: [
        "android.mojo",
        "org.chromium.arc",
    ],
    platform_apis: true,
}
