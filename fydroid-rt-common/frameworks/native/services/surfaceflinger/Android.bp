// fydroid-rt SurfaceFlinger: monolithic binary with Wayland integration.
//
// Unlike AOSP's split (surfaceflinger binary + libsurfaceflinger.so),
// we build a single statically-linked binary with LTO, matching ARC++'s
// approach for optimal per-frame performance in the Wayland hot path.
//
// Architecture:
//   AOSP SurfaceFlinger sources (via filegroup)
//   + AOSP CompositionEngine (static)
//   + libfydroid_wayland_service (static) — our Wayland client
//   + FydroidSurfaceFlingerFactory — hooks Wayland into AOSP's factory pattern
//   → single "surfaceflinger" binary

cc_binary {
    name: "fydroid_surfaceflinger",
    defaults: [
        "libsurfaceflinger_production_defaults",
        "fydroid_perf_defaults",
    ],
    stem: "surfaceflinger",

    cflags: [
        "-DUSE_VR_COMPOSER=0",
        "-DFYDROID_WAYLAND_COMPOSER=1",
        "-DRUNNING_WITHOUT_SYNC_FRAMEWORK=1",
        "-DNUM_FRAMEBUFFER_SURFACE_BUFFERS=2",
    ],

    // AOSP sources use relative includes like "DisplayHardware/HWComposer.h"
    // which resolve from the SurfaceFlinger source root. Since our Android.bp
    // lives in a different directory, include_build_directory (which defaults
    // to true) adds our dir, not AOSP's. We need this explicit path.
    include_dirs: [
        "frameworks/native/services/surfaceflinger",
    ],

    srcs: [
        // Our custom factory that creates WaylandComposer instead of HWComposer
        "FydroidSurfaceFlingerFactory.cpp",

        // CompositionEngine override for ARC per-task GPU composition
        "CompositionEngineArc.cpp",

        // Per-task GPU composition output and render surface
        "WaylandTaskOutput.cpp",
        "TaskRenderSurface.cpp",

        // AOSP-13: surfaceflinger_binary_sources now bundles :libsurfaceflinger_sources
        // + main_surfaceflinger.cpp, so this alone pulls all SF sources + the entry
        // point. (Listing :libsurfaceflinger_sources separately too would double-
        // compile every SF source -> duplicate .o build rules.)
        ":surfaceflinger_binary_sources",
    ],

    static_libs: [
        // AOSP static libs (from libsurfaceflinger_defaults)
        "libcompositionengine",
        "libperfetto_client_experimental",
        "librenderengine",
        "libserviceutils",
        "libtrace_proto",

        // Our Wayland integration
        "libfydroid_wayland_service",

        // Wayland client + protocol libs
        "libffi",
        "libwayland_client_static",
        "libfydroid_wayland_extension_client_protocols",
        "libwayland_extension_client_protocols",
        "libdrm",
    ],

    // Dynamic libs stay shared (system libs, HAL interfaces)
    shared_libs: [
        // FydeOS task-control AIDL (C++ backend) used by libfydroid_wayland_service's
        // WaylandTaskResizer — linked here so its BpArcTaskController is in the binary.
        "fydroid_arc_task_aidl-cpp",
        "android.frameworks.displayservice@1.0",
        "android.frameworks.vr.composer@2.0",
        "android.hardware.configstore-utils",
        "android.hardware.configstore@1.0",
        "android.hardware.configstore@1.1",
        "android.hardware.graphics.allocator@2.0",
        "android.hardware.graphics.allocator@3.0",
        "android.hardware.graphics.common@1.2",
        "android.hardware.graphics.composer@2.1",
        "android.hardware.graphics.composer@2.2",
        "android.hardware.graphics.composer@2.3",
        "android.hardware.graphics.composer@2.4",
        "android.hardware.power@1.0",
        "android.hardware.power@1.3",
        "android.hardware.power-V2-cpp",
        "libbase",
        "libbinder",
        "libbufferhubqueue",
        "libcutils",
        "libdisplayservicehidl",
        "libEGL",
        "libfmq",
        "libGLESv1_CM",
        "libGLESv2",
        "libgui",
        "libhardware",
        "libhidlbase",
        "libinput",
        "liblayers_proto",
        "liblog",
        "libnativewindow",
        "libpdx_default_transport",
        "libprocessgroup",
        "libprotobuf-cpp-lite",
        "libstatslog",
        "libSurfaceFlingerProp",
        "libsync",
        "libtimestats",
        "libui",
        "libutils",
    ],

    header_libs: [
        "android.hardware.graphics.composer@2.1-command-buffer",
        "android.hardware.graphics.composer@2.2-command-buffer",
        "android.hardware.graphics.composer@2.3-command-buffer",
        "android.hardware.graphics.composer@2.4-command-buffer",
    ],

    init_rc: ["fydroid_surfaceflinger.rc"],

    lto: {
        thin: true,
    },

    ldflags: ["-Wl,--export-dynamic"],

    logtags: [
        "EventLog/EventLogTags.logtags",
    ],
}
