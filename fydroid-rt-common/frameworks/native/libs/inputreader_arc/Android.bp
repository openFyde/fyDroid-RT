// Replaces AOSP's libinputreader with our InputReaderArc implementation.
// The factory function createInputReader() returns InputReaderArc instead
// of the standard InputReader + EventHub.
//
// Includes all AOSP reader sources for symbol compatibility, but our
// factory never instantiates EventHub or InputReader.

// Build as libinputreader_arc.so; deploy to device as libinputreader.so
// to replace AOSP's standard InputReader with our pipe-based InputReaderArc.
cc_library_shared {
    name: "libinputreader_arc",

    defaults: [
        "inputflinger_defaults",
        "libinputreader_defaults",
    ],

    srcs: [
        "InputReaderArcFactory.cpp",
        "InputReaderArc.cpp",
        "WaylandServiceProxy.cpp",
    ],

    shared_libs: [
        "libinputflinger_base",
        "libbinder",
    ],

    local_include_dirs: ["."],

    include_dirs: [
        "device/fydeos/fydroid-rt-common/frameworks/native/libs/wayland_service/input",
    ],

    export_header_lib_headers: [
        "libinputreader_headers",
    ],
}
