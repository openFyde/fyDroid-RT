// Open-source replacement for prebuilt libarcbridge.so.
//
// Generates Mojo C++ bindings from full arc mojom definitions copied from
// CrOS (chromeos/ash/experiences/arc/mojom/). Uses AOSP11's
// mojom_bindings_generator pipeline with a downgrade step to convert modern
// Mojo syntax (pending_remote<T>) to old syntax (T).

filegroup {
    name: "libarcbridge_mojom_files",
    srcs: [
        // ---- Arc service mojom files (from CrOS) ----
        "mojom/arc/adbd.mojom",
        "mojom/arc/anr.mojom",
        "mojom/arc/app.mojom",
        "mojom/arc/app_permissions.mojom",
        "mojom/arc/appfuse.mojom",
        "mojom/arc/arc_bridge.mojom",
        "mojom/arc/arc_wifi.mojom",
        "mojom/arc/audio.mojom",
        "mojom/arc/auth.mojom",
        "mojom/arc/backup_settings.mojom",
        "mojom/arc/bitmap.mojom",
        "mojom/arc/bluetooth.mojom",
        "mojom/arc/boot_phase_monitor.mojom",
        "mojom/arc/camera.mojom",
        "mojom/arc/cdm.mojom",
        "mojom/arc/camera_intent.mojom",
        "mojom/arc/chrome_feature_flags.mojom",
        "mojom/arc/compatibility_mode.mojom",
        "mojom/arc/crash_collector.mojom",
        "mojom/arc/crosh.mojom",
        "mojom/arc/digital_goods.mojom",
        "mojom/arc/disk_space.mojom",
        "mojom/arc/enterprise_reporting.mojom",
        "mojom/arc/error_notification.mojom",
        "mojom/arc/file_system.mojom",
        "mojom/arc/gfx.mojom",
        "mojom/arc/iio_sensor.mojom",
        "mojom/arc/ime.mojom",
        "mojom/arc/input_method_manager.mojom",
        "mojom/arc/intent_common.mojom",
        "mojom/arc/intent_helper.mojom",
        "mojom/arc/keymaster.mojom",
        "mojom/arc/keymint.mojom",
        "mojom/arc/kiosk.mojom",
        "mojom/arc/media_session.mojom",
        "mojom/arc/memory.mojom",
        "mojom/arc/metrics.mojom",
        "mojom/arc/midis.mojom",
        "mojom/arc/nearby_share.mojom",
        "mojom/arc/net.mojom",
        "mojom/arc/net_shared.mojom",
        "mojom/arc/notifications.mojom",
        "mojom/arc/obb_mounter.mojom",
        "mojom/arc/oemcrypto.mojom",
        "mojom/arc/on_device_safety.mojom",
        "mojom/arc/pip.mojom",
        "mojom/arc/policy.mojom",
        "mojom/arc/power.mojom",
        "mojom/arc/print_common.mojom",
        "mojom/arc/print_spooler.mojom",
        "mojom/arc/privacy_items.mojom",
        "mojom/arc/process.mojom",
        "mojom/arc/protected_buffer_manager.mojom",
        "mojom/arc/scale_factor.mojom",
        "mojom/arc/screen_capture.mojom",
        "mojom/arc/sharesheet.mojom",
        "mojom/arc/system_state.mojom",
        "mojom/arc/system_ui.mojom",
        "mojom/arc/timer.mojom",
        "mojom/arc/tracing.mojom",
        "mojom/arc/tts.mojom",
        "mojom/arc/usb_host.mojom",
        "mojom/arc/video.mojom",
        "mojom/arc/video_common.mojom",
        "mojom/arc/video_decode_accelerator.mojom",
        "mojom/arc/video_decoder.mojom",
        "mojom/arc/video_encode_accelerator.mojom",
        "mojom/arc/video_frame_pool.mojom",
        "mojom/arc/video_protected_buffer_allocator.mojom",
        "mojom/arc/volume_mounter.mojom",
        "mojom/arc/wake_lock.mojom",
        "mojom/arc/wallpaper.mojom",
        "mojom/arc/webapk.mojom",

        // ---- Camera HAL mojom files (from CrOS platform2/camera/mojo/) ----
        "mojom/camera/mojo/camera3.mojom",
        "mojom/camera/mojo/camera_common.mojom",
        "mojom/camera/mojo/camera_features.mojom",
        "mojom/camera/mojo/camera_metadata.mojom",
        "mojom/camera/mojo/camera_metadata_tags.mojom",

        // ---- External dependency stubs ----
        "mojom/chromeos/ash/services/cros_safety/public/mojom/cros_safety.mojom",
        "mojom/chromeos/components/cdm_factory_daemon/mojom/browser_cdm_factory.mojom",
        "mojom/chromeos/components/payments/mojom/payment_app.mojom",
        "mojom/chromeos/components/sensors/mojom/sensor.mojom",
        "mojom/chromeos/components/sensors/mojom/cros_sensor_service.mojom",
        "mojom/components/digital_goods/mojom/digital_goods.mojom",
        "mojom/media/capture/video/chromeos/mojom/cros_camera_client.mojom",
        "mojom/media/mojo/mojom/stable/native_pixmap_handle.mojom",
        "mojom/mojo/public/mojom/base/safe_base_name.mojom",
        "mojom/mojo/public/mojom/base/token.mojom",
        "mojom/services/accessibility/android/public/mojom/accessibility_helper.mojom",
        "mojom/services/device/public/mojom/usb_device.mojom",
        "mojom/services/media_session/public/mojom/audio_focus.mojom",
        "mojom/services/media_session/public/mojom/media_session.mojom",
        "mojom/services/network/public/mojom/ip_address.mojom",
        "mojom/ui/gfx/mojom/buffer_types.mojom",
        "mojom/url/mojom/url.mojom",
    ],
    path: "mojom",
}

// Step 1: Downgrade modern mojom syntax (pending_remote<T> → T, etc.)
generate_mojom_downgraded_files {
    name: "libarcbridge_mojom_downgraded",
    srcs: [":libarcbridge_mojom_files"],
}

// Step 2: Generate pickles (type metadata) from downgraded files
generate_mojom_pickles {
    name: "libarcbridge_mojom_pickles",
    srcs: [":libarcbridge_mojom_downgraded"],
}

// Step 2.5: Generate type mappings for Bluetooth native types
genrule {
    name: "libarcbridge_bluetooth__type_mappings",
    cmd: "$(location mojom_generate_type_mappings)" +
        "    --output=$(out)" +
        "    $(in)",
    tools: ["mojom_generate_type_mappings"],
    srcs: [
        "typemaps/bluetooth.typemap",
    ],
    out: ["libarcbridge_bluetooth__type_mappings"],
}

// Step 2.6: Generate type mappings for video/gfx native types
genrule {
    name: "libarcbridge_video_gfx__type_mappings",
    cmd: "$(location mojom_generate_type_mappings)" +
        "    --output=$(out)" +
        "    $(in)",
    tools: ["mojom_generate_type_mappings"],
    srcs: [
        "typemaps/video_frame_plane.typemap",
        "typemaps/gfx_size.typemap",
    ],
    out: ["libarcbridge_video_gfx__type_mappings"],
}

// Step 3: Generate C++ headers
generate_mojom_headers {
    name: "libarcbridge_mojom_headers",
    srcs: [":libarcbridge_mojom_downgraded"],
    pickles: [
        ":libarcbridge_mojom_pickles",
        ":libmojo_mojom_pickles",
    ],
    templates: ":libmojo_mojom_templates",
    flags: "--disallow_native_types",
    includes: ["external/libchrome"],
    typemaps: [
        ":libmojo_common_custom_types__type_mappings",
        ":libarcbridge_bluetooth__type_mappings",
        ":libarcbridge_video_gfx__type_mappings",
    ],
}

// Step 4: Generate C++ sources
generate_mojom_srcs {
    name: "libarcbridge_mojom_srcs",
    srcs: [":libarcbridge_mojom_downgraded"],
    pickles: [
        ":libarcbridge_mojom_pickles",
        ":libmojo_mojom_pickles",
    ],
    templates: ":libmojo_mojom_templates",
    flags: "--disallow_native_types",
    includes: ["external/libchrome"],
    typemaps: [
        ":libmojo_common_custom_types__type_mappings",
        ":libarcbridge_bluetooth__type_mappings",
        ":libarcbridge_video_gfx__type_mappings",
    ],
}

// Step 5: Generate Java Mojo bindings (.srcjar)
generate_mojom_srcjar {
    name: "libarcbridge_mojom_java_srcs",
    srcs: [":libarcbridge_mojom_downgraded"],
    pickles: [
        ":libarcbridge_mojom_pickles",
        ":libmojo_mojom_pickles",
    ],
    srcjar: "libarcbridge_mojom.srcjar",
    templates: ":libmojo_mojom_templates",
    flags: "--disallow_native_types",
    typemaps: [":libmojo_common_custom_types__type_mappings"],
    includes: ["external/libchrome"],
}

cc_library_shared {
    name: "libarcbridge",
    defaults: ["fydroid_perf_defaults"],
    srcs: [
        "video_frame_plane.cpp",
    ],
    generated_sources: ["libarcbridge_mojom_srcs"],
    generated_headers: ["libarcbridge_mojom_headers"],
    export_generated_headers: ["libarcbridge_mojom_headers"],
    local_include_dirs: ["include"],
    export_include_dirs: ["include"],
    header_libs: [
        "libbluetooth_headers",
    ],
    export_header_lib_headers: [
        "libbluetooth_headers",
    ],
    static_libs: [
        "libbluetooth-types",
    ],
    shared_libs: [
        "libchrome",
        "libmojo",
    ],
    cflags: [
        "-Wno-unused-parameter",
    ],
}
