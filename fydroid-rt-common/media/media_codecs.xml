<MediaCodecs>
    <Settings>
        <Setting name="max-video-encoder-input-buffers" value="4" />
    </Settings>

    <Encoders>
        <!-- Limit block count to stop encoder timing out on lower-end devices (see b/181863334). -->
        <MediaCodec name="c2.android.vp8.encoder" type="video/x-vnd.on2.vp8" update="true">
            <Limit name="block-count" range="1-8192" /> <!-- max 2048x1024 -->
        </MediaCodec>
        <!-- Disable HEVC encoder (see b/158961698) -->
        <MediaCodec name="c2.android.hevc.encoder" type="video/hevc" update="true" enabled="false">
        </MediaCodec>
    </Encoders>
    <Decoders>
        <!-- Re-enable AOSP software HEVC decoder as fallback for the hardware
             c2.mojo-legacy.hevc.decoder (b/158961698 was a Chrome OS specific
             concern that doesn't apply once we own the codec stack). -->
    </Decoders>
</MediaCodecs>
