# Dependency-first order required by AOSP 13 dexpreopt (a jar must follow the
# system-server jars it references): mojom <- arc <- bridge <- {clipboard,services}.
PRODUCT_SYSTEM_SERVER_JARS += org.chromium.arc.mojom org.chromium.arc org.chromium.arc.bridge arc-clipboard arc-services

PRODUCT_PACKAGE_OVERLAYS += device/fydeos/fydroid-rt-common/overlay/product-overlay

# Select the IComponentStore/default backend per board. Boards set
# FYDROID_C2_DEFAULT_STORE in their product mk BEFORE the inherit-product
# of this file (see fydroid_rt_apple.mk and fydroid_rt_arm64.mk).
# Background on why this knob exists: the c2 default service is what
# MediaCodec's allocator-fallback path queries when it can't reach a
# hardware codec; on hosts with no GPU video accel the Mojo bridge hangs
# there, and on hosts with no default store at all, libcodec2_vndk's
# UseComponentStoreForIonAllocator SEGVs mediaserver during the first
# decoder init.
ifeq ($(FYDROID_C2_DEFAULT_STORE),mojo)
PRODUCT_PACKAGES += fydroid_c2_service_mojo
PRODUCT_COPY_FILES += \
    device/fydeos/fydroid-rt-common/seccomp_policy/codec2.vendor.ext.policy:$(TARGET_COPY_OUT_VENDOR)/etc/seccomp_policy/codec2.vendor.ext.policy
else ifeq ($(FYDROID_C2_DEFAULT_STORE),stub)
PRODUCT_PACKAGES += fydroid_c2_default_stub
else
$(error FYDROID_C2_DEFAULT_STORE must be set to "mojo" or "stub" in the per-board product mk)
endif

