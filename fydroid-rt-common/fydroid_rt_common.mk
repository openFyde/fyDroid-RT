# ro.vndk.version. fydroid sets no BOARD_VNDK_VERSION, so the build never emits
# this (build/make/core/main.mk only defines it under BOARD_VNDK_VERSION) and
# every vendor process logs
#     E ashmem: memfd: ro.vndk.version not defined or invalid (), this is
#               mandated since P.
# ~36 times a boot. 33 is the truthful value — the vendor partition is built
# from this tree at API 33 (ro.vendor.build.version.sdk=33).
#
# Consequences, since this property is read in more places than the log:
#   - libcutils memfd stays off regardless: __has_memfd_support() also requires
#     sys.use_memfd, which defaults false. So this is log-only for ashmem.
#   - linkerconfig is unaffected: IsLegacyDevice() is already forced true by
#     ro.treble.enabled=false, so the legacy ld.config is still generated and no
#     VNDK namespace is introduced (there is no VNDK APEX in this build).
#   - EGL: needsAndroidPEglMitigation() is `vndk_version <= 28`, and an unset
#     property reads back as -1, so the mitigation is currently ON. Setting 33
#     turns it OFF. It exists for a 2018 Adreno 530 quirk (advertising
#     EGL_EXT_image_gl_colorspace under the draft KHR name, and stripping
#     non-LINEAR/SRGB colorspace attribs from eglCreateImageKHR) and should not
#     apply to Mesa. This is the one real behaviour change here, and it is NOT
#     yet verified on a device — see below.
#
# NOTE ON TAKING EFFECT. BOARD_PROPERTY_OVERRIDES_SPLIT_ENABLED is unset, so
# PRODUCT_VENDOR_PROPERTIES lands in /system/build.prop, not /vendor/build.prop
# (build/make/core/sysprop.mk:322). More importantly, the container does not read
# the image's /system/build.prop at all: arc-setup generates
# /run/arc/host_generated/build.prop from the host's copy at
# /usr/share/arc/properties/build.prop and bind-mounts it over /system/build.prop
# (visible as a tmpfs entry in the container's /proc/mounts). So this line only
# reaches a device once the FydeOS image is rebuilt and reinstalled — editing
# /system/build.prop in the root_rw overlay of a running board does nothing.
PRODUCT_VENDOR_PROPERTIES += \
    ro.vndk.version=33

# ro.control_privapp_permissions=enforce — a priv-app may hold a
# signature|privileged permission only if some privapp-permissions xml lists it.
#
# Under `log` the check is not merely non-fatal,
# it is permissive: PermissionManagerServiceImpl ends
# checkPrivilegedPermissionAllowlist() with
# `return !CONTROL_PRIVAPP_PERMISSIONS_ENFORCE`, so an unlisted permission is
# granted anyway with a Slog.w, and mPrivappPermissionsViolations — the set that
# PackageManagerService turns into a throw — is filled only under enforce. The
# practical effect of log is that the allowlists were never actually load-bearing
# and could drift without anyone noticing. They had: auditing all four products
# against the built images found exactly one gap, org.chromium.arc.accessibility
# holding WRITE_SECURE_SETTINGS unlisted, now fixed in
# permissions/privapp-permissions-fydroid.xml.
#
# Under enforce that same gap is a system_server boot loop, so before adding any
# new priv-app, or bumping one that gains a permission, re-audit. Note the check
# does NOT exempt platform-signed apps — checkPrivilegedPermissionAllowlist has
# no signature bypass — but it does exempt packages delivered inside an apex,
# which carry their own allowlists under /apex/<name>/etc/permissions/ (that is
# why PermissionController needs no entry here despite requesting 14 privileged
# permissions).
#
# Per the build.prop note above, this only reaches a device on a rebuilt image;
# it cannot be tested by overlay copy on a running board.
PRODUCT_PROPERTY_OVERRIDES += \
    ro.fydroid.game_render_height=$(FYDROID_GAME_RENDER_HEIGHT) \
    ro.hardware.audio.primary=cheets \
    ro.control_privapp_permissions=enforce \
    aaudio.mmap_policy=2 \
    aaudio.mmap_exclusive_policy=2 \
    ro.config.media_vol_default=15 \
    ro.config.alarm_vol_default=7 \
    ro.config.vc_call_vol_default=5 \
    ro.config.fydroid_boot_max_volume=true \
    dalvik.vm.heapsize=512m \
    dalvik.vm.heapgrowthlimit=192m \
    dalvik.vm.heapminfree=512k \
    dalvik.vm.heapmaxfree=8m \
    dalvik.vm.heapstartsize=16m \
    dalvik.vm.heaptargetutilization=0.75

# aaudio.mmap_policy/aaudio.mmap_exclusive_policy = 2 (AAUDIO_POLICY_ALWAYS):
# tells audioserver (main_audioserver.cpp:144) to instantiate AAudioService,
# which then registers the media.aaudio binder service. Without this, service
# list is missing media.aaudio and apps using AAudio low-latency paths fail to
# bind. Matches the ARC++ proprietary build.

# ro.config.{media,alarm,vc_call}_vol_default — start every stream at the top of
# its own scale instead of AOSP's fractional defaults (media MAX/3, call 3*MAX/4,
# alarm 6*MAX/7). AudioService reads these in its constructor
# (AudioService.java:1088-1121) and ignores any value outside
# [MIN,MAX]_STREAM_VOLUME for that stream, so each value is that stream's max as
# this build actually reports it — verified with `dumpsys audio` on a board:
#   STREAM_MUSIC       Max 15, default was  5   -> 15
#   STREAM_ALARM       Max  7, default was  6   ->  7
#   STREAM_VOICE_CALL  Max  5, default was  3   ->  5
# (no ro.config.*_vol_steps is set anywhere, and the audio policy engine reports
# the same maxima, so these are the AudioService.MAX_STREAM_VOLUME baselines.)
#
# The remaining streams are *not* configured here, because they are aliases and
# updateDefaultVolumes() (AudioService.java:2156) unconditionally recomputes an
# aliased stream's default by rescaling its alias head — a ro.config.system_vol_
# default would be silently overwritten. They are driven from two places instead:
#   - RING head (also SYSTEM, NOTIFICATION, SYSTEM_ENFORCED, DTMF):
#     config_audio_ring_vol_default / config_audio_notif_vol_default, raised
#     5 -> 7 in overlay/FydroidConfigOverlay (they are framework resources, not
#     properties).
#   - MUSIC head (also TTS, ACCESSIBILITY, ASSISTANT): follows the 15 above.
# STREAM_BLUETOOTH_SCO keeps its 7/15 default: AOSP exposes no build-time knob
# for it, only the hardcoded AudioSystem.DEFAULT_STREAM_VOLUME entry.
#
# Why this matters on ARC specifically: the Android stream index is a second
# attenuator in series with CRAS, and the Chrome OS volume slider is the real
# control. Chrome only pushes its level into the container when the host
# volume/mute *changes* (ArcAudioBridge::OnOutputNodeVolumeChanged ->
# SendVolumeState -> ArcAudioService.notifyVolumeState); ArcAudioBridge::
# OnConnectionReady sends the audio-node and spatial-audio state but deliberately
# not the volume. So with the stock defaults, every session starts with Android
# media at 33% of whatever Chrome OS is set to until the user touches the slider,
# and the same low defaults re-seed each newly connected output device
# (headphones / HDMI / USB / Bluetooth).
#
# These *_vol_default props are defaults, not floors: an index already persisted
# in Settings.System for a given stream+device wins, so on their own they only
# change fresh profiles and first-seen devices, not a board whose Android /data
# already recorded a volume for that stream and device.
#
# ro.config.fydroid_boot_max_volume=true closes that gap: it makes AudioService
# force EVERY stream to its maximum on each settings (re)load — boot and user
# switch — overriding any lower value already persisted (patched into
# VolumeStreamState.readSettings(), frameworks/base). So an upgraded board with a
# populated /data also comes up maxed, not just fresh profiles. The user (and
# apps) can still turn any stream down at runtime; that value lasts the session
# but is reset to max at the next boot. Safe-media-volume enforcement still runs
# afterwards, so wired headset/headphone output is clamped to the hearing-safety
# cap (config_safe_media_volume_index) rather than full scale. Because it only
# acts at load time it costs nothing at runtime and needs no /data migration.

# dalvik.vm.heap* — the DEFAULT ART heap budget, i.e. what a board runs when
# Chrome sends no memory profile at all. Chrome classifies the host and ships a
# tier in as androidboot.arc_dalvik_memory_profile for anything >= 3.5 GB;
# init.cheets.rc imports init.dalvik_heap.<tier>.rc, which overrides the values
# below before zygote starts. Only a board under 3.5 GB keeps these as-is.
# They match the ARC++ proprietary build.
#
# Without these, ART uses tiny device-baseline defaults (background growth
# limit = 16 MB), so any non-largeHeap app that gets
# pushed into the background cgroup hits OOM on first big allocation:
# observed live with F-Droid parsing its repo index. The 192 MB background
# growth cap and 512 MB foreground/largeHeap cap are stock values for an
# ARC container on a host with several GB of RAM.

# ARC container marker. Gates Build.IS_CONTAINER and many framework code
# paths (WMS safe-mode input wait, TaskLaunchParamsModifier, LaunchParams-
# Persister, ActivityRecord), plus our patches 0014/0015/0016/0018/0023.
# Vanilla AOSP normally derives this from kernel cmdline androidboot.container=1,
# but there is no kernel cmdline inside a container, so bake it into default.prop.
# Matches ARC++ proprietary build, which has this in /usr/share/arc/properties/default.prop.
PRODUCT_DEFAULT_PROPERTY_OVERRIDES += \
    ro.boot.container=1

# Bundle F-Droid as a default system priv-app, together with the Privileged
# Extension that actually holds INSTALL_PACKAGES / DELETE_PACKAGES. F-Droid
# only asks for the REQUEST_* variants, so without the extension every install
# and update goes through the PackageInstaller confirmation UI; with it,
# F-Droid's PrivilegedInstaller binds the extension's IPrivilegedService and
# installs directly. See both packages' Android.mk and
# permissions/privapp-permissions-fdroid.xml.
#
# Neither APK is in git. Fetch both once after a fresh checkout:
#   packages/apps/FDroid/fetch-fdroid.sh
#   packages/apps/FDroidPrivilegedExtension/fetch-fdroid-privext.sh
# Each Android.mk fails with that instruction if its APK is missing.
PRODUCT_PACKAGES += F-Droid
PRODUCT_PACKAGES += F-DroidPrivilegedExtension

# Enforce VINTF manifest — eliminates the 1-second sleep(1) in every getService()
# call for HALs not in the manifest. ARC++ proprietary build has this enabled.
#
# Reconciled to AOSP 13 FCM target-level 6 (the device manifests declare
# target-level="6"). checkvintf --check-compat checks the device manifest against
# framework compatibility_matrix.6.xml. The matrix's required HALs are handled as
# follows for the Chrome OS container:
#   - gatekeeper: provided for real — android.hardware.gatekeeper@1.0-service.software
#     is in PRODUCT_PACKAGES above (Android keystore/locksettings needs a gatekeeper;
#     the container has no TEE, so the AOSP software impl is the right one).
#   - graphics.mapper/allocator: provided for real at @4.0 (gralloc4) — the minigbm
#     android.hardware.graphics.{mapper@4.0-impl,allocator@4.0-service}.minigbm
#     modules (PRODUCT_PACKAGES above) replace the old HIDL @2.0 gralloc path. No
#     matrix relax needed for graphics.
#   - power: relaxed to optional in compatibility_matrix.6.xml — Chrome OS owns power
#     management (bridged via arc power.mojom/wake_lock.mojom); there is no AIDL
#     IPower HAL in the container.
#   - drm: matrix accepts @1.0-1.4 — Widevine is host-bridged (arc oemcrypto.mojom)
#     via the generic drm@1.0-service-lazy; AOSP has no generic @1.4 drm service.
# See hardware/interfaces/compatibility_matrices/compatibility_matrix.6.xml (patch
# 0003) and the-plan-for-updating-to-tiramisu.md. NOTE: manifest↔runtime accuracy
# (which HALs actually come up) still needs on-device validation at first boot.
PRODUCT_ENFORCE_VINTF_MANIFEST_OVERRIDE := true

# Declare the ARC-specific bridge HALs (vendor.google_arc.arcbridge /
# arcvideobridge) to the framework side so checkvintf doesn't flag them as
# "in device manifest but not in framework compatibility matrix".
DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE += \
    device/fydeos/fydroid-rt-common/vintf/device_framework_compatibility_matrix.xml

# Full AOSP locale list (~90 locales, en_US first as the default) so
# framework-res and system apps carry translations for every language the
# picker offers.
$(call inherit-product, $(SRC_TARGET_DIR)/product/languages_default.mk)

PRODUCT_AAPT_CONFIG := normal ldpi mdpi hdpi xhdpi xxhdpi
PRODUCT_AAPT_PREF_CONFIG := hdpi

PRODUCT_HOST_PACKAGES += mksquashfs fs_config

$(call inherit-product-if-exists, frameworks/base/data/keyboards/keyboards.mk)
$(call inherit-product-if-exists, frameworks/base/data/fonts/fonts.mk)
$(call inherit-product-if-exists, external/roboto-fonts/fonts.mk)

# Complete Noto set — installs every font the framework's fonts.xml declares,
# so all scripts in PRODUCT_LOCALES render (Arabic/Persian, Thai, Hebrew, …).
$(call inherit-product-if-exists, external/noto-fonts/fonts.mk)

# Signing keys. Release builds sign with FydeOS's own keys from the private
# fydeos-keys repo (gitlab fydroid-rt/fydeos-keys), checked out at
# vendor/fydeos-keys; the build takes platform/shared/media/networkstack/
# sdk_sandbox/bluetooth from the same directory. A checkout without that repo
# falls back to the AOSP test keys, so it still builds — but its images carry
# "test-keys" and cannot update a device running a FydeOS-key build. A
# FydeOS-key build is tagged "dev-keys" (build/make/core/sysprop.mk).
ifneq ($(wildcard vendor/fydeos-keys/releasekey.x509.pem),)
PRODUCT_DEFAULT_DEV_CERTIFICATE := vendor/fydeos-keys/releasekey
else
$(warning vendor/fydeos-keys not found: signing with AOSP test keys)
endif
