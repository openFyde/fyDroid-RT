# Common product configuration for fydroid-rt (shared between arm64 and x86_64).
# Architecture-specific targets inherit this and add their own BoardConfig.
#
# Branding (PRODUCT_BRAND / PRODUCT_MANUFACTURER / PRODUCT_SYSTEM_NAME /
# PRODUCT_MODEL) is intentionally NOT set here. core_minimal.mk forces
# PRODUCT_BRAND := generic, and inherit-product's merge semantics let
# that "generic" win over an assignment inside an inherit-product'd
# file. Each per-board fydroid_rt_<board>.mk therefore sets the brand
# family AFTER its inherit-product chain — the same post-inherit
# override trick PRODUCT_NAME / PRODUCT_DEVICE already use.

PRODUCT_CHARACTERISTICS := nosdcard

# Vulkan HAL module(s) to install. Single-GPU boards (arm64/apple) build one
# Mesa Vulkan driver renamed to "cheets" via BOARD_MESA3D_VULKAN_MODULE_NAME,
# so the default is "vulkan.cheets". Multi-GPU boards (amd64: Intel anv + AMD
# radv) build per-vendor HALs (vulkan.intel + vulkan.radeon) and select one at
# runtime via ro.hardware.vulkan; they override this BEFORE inheriting this file.
FYDROID_VULKAN_HAL_MODULES ?= vulkan.cheets

# Per-board CPU affinity for the container. The rt-common file narrows the
# background cpusets for RK3588S's 4+4 big.LITTLE ("Android gets the little
# cores"); that mapping is wrong on a uniform SMP host, where it pins every
# background app and every restarted process onto cpu0. Boards whose CPUs are
# all equal (amd64) override this BEFORE inheriting this file.
FYDROID_CPUSETS_RC ?= device/fydeos/fydroid-rt-common/init/init.cpusets.rc

# Height games rasterise at, in pixels along the panel's short side (720 =
# 720p), using AOSP's per-app buffer downscaling (CompatModePackages DOWNSCALED
# + DOWNSCALE_<pct>): the app renders into a smaller buffer and WM upscales it to
# fill the window. Applied by ArcAppService to every app that resolves to
# CATEGORY_GAME, which includes the user's own "is a game" flags from the game
# control panel.
#
# A height, not a percentage, because what the GPU pays for is pixels: a fixed
# 50% rendered a 2.5K panel at 800p but a 1080p panel at 540p. ArcAppService
# picks the smallest DOWNSCALE step (30..90 in fives) that keeps the default
# display at or above this height, and leaves a panel already close to it
# (768p) native. 0 disables it.
#
# The container reads a build.prop generated by the ChromeOS host, so this only
# reaches a board if the host carries it; ArcAppService falls back to the same
# 720 when the property is absent. Boards override this BEFORE inheriting this
# file.
FYDROID_GAME_RENDER_HEIGHT ?= 720

# external/v4l2_codec2 (AOSP-13) declares its own soong_namespace; activate it
# plus the fydroid c2-service-mojo namespace (which imports it) so the Mojo C2
# service can link libv4l2_codec2_* across the namespace boundary.
PRODUCT_SOONG_NAMESPACES += \
    external/v4l2_codec2 \
    device/fydeos/fydroid-rt-common/vendor/c2-service-mojo \

