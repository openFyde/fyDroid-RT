// Minimal Picture-in-Picture client, for bringing up and regression-testing the
// fydroid PIP work (docs/picture-in-picture-plan.md).
//
// Deliberately NOT in PRODUCT_PACKAGES — it is a developer tool, not part of the
// image. Build and install it explicitly:
//
//   m FydroidPipTest
//   adb install -r $OUT/testcases/FydroidPipTest/*/FydroidPipTest.apk
//     (or push the apk and `pm install -r` it inside the container)
//
// Drive it with:
//   am start -n io.fydeos.piptest/.PipTestActivity            # then it PIPs after 3s
//   am start -n io.fydeos.piptest/.PipTestActivity -e pip now # PIP immediately
//   am start -n io.fydeos.piptest/.PipTestActivity -e pip off # stay windowed
android_app {
    name: "FydroidPipTest",
    srcs: ["src/**/*.java"],
    sdk_version: "current",
    dex_preopt: {
        enabled: false,
    },
}
