<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.fydeos.piptest">

    <application android:label="PIP Test">
        <!-- supportsPictureInPicture is what makes
             ActivityRecord#supportsPictureInPicture() true; without it
             checkEnterPictureInPictureState refuses every request and
             enterPictureInPictureMode() is a no-op.

             resizeableActivity is required alongside it: PIP is a multi-window
             mode, so an unresizable activity cannot enter it. -->
        <activity
            android:name=".PipTestActivity"
            android:label="PIP Test"
            android:exported="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
