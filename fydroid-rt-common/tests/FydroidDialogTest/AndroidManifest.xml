<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.fydeos.dialogtest">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="Dialog Test">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DialogActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog" />
        <activity
            android:name=".WebActivity"
            android:exported="true" />
        <activity
            android:name=".TranslucentWebActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".PageActivity"
            android:exported="true" />
        <activity
            android:name=".TaskPageActivity"
            android:exported="true"
            android:taskAffinity="io.fydeos.dialogtest.page" />
    </application>
</manifest>
