<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome decides at runtime which events it wants (SetFilter) and whether
     touch exploration is on (SetExploreByTouchEnabled), so this declares the
     widest set of capabilities and the service narrows them from code.

     flagIncludeNotImportantViews is required, not cosmetic: Chrome's
     AXTreeSourceAndroid decides importance itself from the IMPORTANCE property
     and expects unimportant nodes to be present in the tree. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackAllMask"
    android:accessibilityFlags="flagDefault|flagIncludeNotImportantViews|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canRequestTouchExplorationMode="true"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="100"
    android:description="@string/accessibility_service_description" />
